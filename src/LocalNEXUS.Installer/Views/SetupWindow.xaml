<Window x:Class="LocalNEXUS.Installer.Views.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:vm="clr-namespace:LocalNEXUS.Installer.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:SetupViewModel}"
        Title="LocalNEXUS Setup"
        Height="620"
        Width="840"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="{StaticResource Font.Sans}"
        TextOptions.TextFormattingMode="Ideal">

    <!--
        The window draws its own chrome, which is the only way the title bar can carry the app
        mark and be the same colour as everything under it. Same approach the application takes.
    -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="42"
                            ResizeBorderThickness="0"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Border Background="{StaticResource Backdrop.Brush}"
            BorderBrush="{StaticResource Surface.Border.Brush}"
            BorderThickness="1"
            CornerRadius="{StaticResource Radius.Window}"
            SnapsToDevicePixels="True">
        <Border.Clip>
            <MultiBinding Converter="{StaticResource RoundedClip}" ConverterParameter="12">
                <Binding Path="ActualWidth" RelativeSource="{RelativeSource Self}" />
                <Binding Path="ActualHeight" RelativeSource="{RelativeSource Self}" />
            </MultiBinding>
        </Border.Clip>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="2" />
                <RowDefinition Height="42" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!--
                The progress sliver. Absent on Welcome because nothing has been done yet, and
                complete by Finish. Decorative, and the only thing in the window that tells you
                how much is left without reading the rail.
            -->
            <Grid Grid.Row="0" x:Name="SliverTrack" Background="Transparent">
                <Border HorizontalAlignment="Left"
                        Background="{StaticResource Accent.GradientHorizontal.Brush}">
                    <Border.Width>
                        <MultiBinding Converter="{StaticResource FractionToWidth}">
                            <Binding Path="Progress" />
                            <Binding Path="ActualWidth" ElementName="SliverTrack" />
                        </MultiBinding>
                    </Border.Width>
                </Border>
            </Grid>

            <!-- Title bar. -->
            <Grid Grid.Row="1">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <Image Width="22"
                           Height="22"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           Source="/Assets/Brand/Mark.png" />
                    <TextBlock Text="LocalNEXUS Setup"
                               Margin="10,0,0,0"
                               VerticalAlignment="Center"
                               FontSize="{StaticResource Font.Size.Normal}" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="MinimiseButton" Style="{StaticResource CaptionButton}" Content="&#xE921;" ToolTip="Minimise" />
                    <Button x:Name="CloseButton" Style="{StaticResource CaptionButton}" Content="&#xE8BB;" ToolTip="Close" />
                </StackPanel>
            </Grid>

            <!-- Rail and content. -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="196" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Background="{StaticResource Surface.Panel.Brush}"
                        BorderBrush="{StaticResource Surface.SubtleBorder.Brush}"
                        BorderThickness="0,0,1,0">
                    <Grid>
                        <ItemsControl ItemsSource="{Binding Steps}" Margin="16,28,16,0" VerticalAlignment="Top">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,22">
                                        <Grid Width="21" Height="21" VerticalAlignment="Center">
                                            <!-- Done: filled gradient with a check. -->
                                            <Border CornerRadius="11"
                                                    Background="{StaticResource Accent.Gradient.Brush}"
                                                    Visibility="{Binding State, Converter={StaticResource EnumToVisibility}, ConverterParameter=Done}">
                                                <TextBlock Text="&#xE73E;"
                                                           FontFamily="{StaticResource Font.Icons}"
                                                           FontSize="10"
                                                           Foreground="{StaticResource Text.Inverse.Brush}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" />
                                            </Border>

                                            <!-- Active: outlined, with the number and an accent ring. -->
                                            <Border CornerRadius="11"
                                                    BorderBrush="{StaticResource Accent.Primary.Brush}"
                                                    BorderThickness="1.5"
                                                    Background="{StaticResource Accent.Soft.Brush}"
                                                    Visibility="{Binding State, Converter={StaticResource EnumToVisibility}, ConverterParameter=Active}">
                                                <TextBlock Text="{Binding Number}"
                                                           FontSize="10.5"
                                                           Foreground="{StaticResource Text.Primary.Brush}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" />
                                            </Border>

                                            <!-- Upcoming: faint outline, muted number. -->
                                            <Border CornerRadius="11"
                                                    BorderBrush="{StaticResource Surface.Border.Brush}"
                                                    BorderThickness="1"
                                                    Visibility="{Binding State, Converter={StaticResource EnumToVisibility}, ConverterParameter=Upcoming}">
                                                <TextBlock Text="{Binding Number}"
                                                           FontSize="10.5"
                                                           Foreground="{StaticResource Text.Muted.Brush}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" />
                                            </Border>
                                        </Grid>

                                        <TextBlock Text="{Binding Label}" Margin="12,0,0,0" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                    <Setter Property="Foreground" Value="{StaticResource Text.Muted.Brush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding State}" Value="Active">
                                                            <Setter Property="Foreground" Value="{StaticResource Text.Primary.Brush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding State}" Value="Done">
                                                            <Setter Property="Foreground" Value="{StaticResource Text.Secondary.Brush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Style="{StaticResource MetaText}"
                                   Text="{Binding Source={x:Static vm:SetupViewModel.Version},
                                                 StringFormat='LocalNEXUS {0}'}"
                                   VerticalAlignment="Bottom"
                                   HorizontalAlignment="Left"
                                   Margin="16,0,0,18" />
                    </Grid>
                </Border>

                <!-- The step itself, plus the navigation row under it. -->
                <Grid Grid.Column="1" Margin="42,34,42,26">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <ContentControl Grid.Row="0" Content="{Binding}">
                        <ContentControl.Style>
                            <Style TargetType="ContentControl">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Step}" Value="Welcome">
                                        <Setter Property="ContentTemplate" Value="{StaticResource WelcomeStep}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Step}" Value="License">
                                        <Setter Property="ContentTemplate" Value="{StaticResource LicenseStep}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Step}" Value="Components">
                                        <Setter Property="ContentTemplate" Value="{StaticResource ComponentsStep}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Step}" Value="Build">
                                        <Setter Property="ContentTemplate" Value="{StaticResource BuildStep}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Step}" Value="Ready">
                                        <Setter Property="ContentTemplate" Value="{StaticResource ReadyStep}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Step}" Value="Installing">
                                        <Setter Property="ContentTemplate" Value="{StaticResource InstallingStep}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Step}" Value="Finish">
                                        <Setter Property="ContentTemplate" Value="{StaticResource FinishStep}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ContentControl.Style>
                    </ContentControl>

                    <Grid Grid.Row="1" Margin="0,18,0,0">
                        <Border Height="1"
                                VerticalAlignment="Top"
                                Background="{StaticResource Surface.SubtleBorder.Brush}"
                                Margin="0,0,0,16" />

                        <TextBlock Style="{StaticResource MetaText}"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Left"
                                   Margin="0,16,0,0"
                                   Text="{Binding FetchCountText}"
                                   Visibility="{Binding Step, Converter={StaticResource EnumToVisibility}, ConverterParameter=Ready}" />

                        <TextBlock Style="{StaticResource MetaText}"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Left"
                                   Margin="0,16,0,0"
                                   Text="{Binding EngineCountText}"
                                   Visibility="{Binding Step, Converter={StaticResource EnumToVisibility}, ConverterParameter=Components}" />

                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    Margin="0,16,0,0"
                                    Visibility="{Binding ShowNavigation, Converter={StaticResource BooleanToVisibility}}">
                            <Button Style="{StaticResource QuietButton}"
                                    Content="Cancel"
                                    Command="{Binding CancelCommand}"
                                    Margin="0,0,8,0"
                                    Visibility="{Binding CanCancel, Converter={StaticResource BooleanToVisibility}}" />
                            <Button Style="{StaticResource GhostButton}"
                                    Content="Back"
                                    Command="{Binding BackCommand}"
                                    Margin="0,0,8,0"
                                    Visibility="{Binding CanGoBack, Converter={StaticResource BooleanToVisibility}}" />
                            <Button Style="{StaticResource PrimaryButton}"
                                    Content="Retry"
                                    Command="{Binding RetryCommand}"
                                    Margin="0,0,8,0"
                                    Visibility="{Binding ShowRetry, Converter={StaticResource BooleanToVisibility}}" />
                            <Button Style="{StaticResource PrimaryButton}"
                                    Content="{Binding NextLabel}"
                                    Command="{Binding NextCommand}"
                                    Visibility="{Binding ShowRetry, Converter={StaticResource BooleanToVisibility}, ConverterParameter=Invert}" />
                        </StackPanel>

                        <TextBlock Style="{StaticResource MetaText}"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Left"
                                   Margin="0,16,0,0"
                                   Text="This may take a few minutes."
                                   Visibility="{Binding ShowNavigation, Converter={StaticResource BooleanToVisibility}, ConverterParameter=Invert}" />
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
