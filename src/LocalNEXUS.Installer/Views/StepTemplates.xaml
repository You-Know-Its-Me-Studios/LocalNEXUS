<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:LocalNEXUS.Installer.ViewModels">

    <!--
        The seven steps. One dictionary rather than seven user controls, because each is a
        layout over the same view model and a file per step would be seven code behinds that all
        say InitializeComponent.
    -->

    <!-- 1. Welcome -->
    <DataTemplate x:Key="WelcomeStep" DataType="{x:Type vm:SetupViewModel}">
        <StackPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Image Grid.Column="0"
                       Width="64"
                       Height="64"
                       VerticalAlignment="Top"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       Source="/Assets/Brand/Mark.png" />

                <StackPanel Grid.Column="1" Margin="22,0,0,0">
                    <TextBlock Style="{StaticResource ScreenTitle}"
                               Text="{Binding Source={x:Static vm:SetupViewModel.Version},
                                              StringFormat='Welcome to the LocalNEXUS {0} Setup Wizard'}" />

                    <TextBlock Style="{StaticResource BodyText}" Margin="0,14,0,0">
                        This installs LocalNEXUS on this computer, a canvas that wires language models together and
                        points them at your codebase. Models run on this machine, across several of your own, or
                        through a hosted provider, entirely your choice.
                    </TextBlock>

                    <TextBlock Style="{StaticResource BodyText}" Margin="0,12,0,0"
                               Text="Close other applications before continuing." />

                    <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                        <Border Style="{StaticResource Chip}" Margin="0,0,10,0">
                            <TextBlock Text="Runs on your hardware" FontSize="{StaticResource Font.Size.Normal}" />
                        </Border>
                        <Border Style="{StaticResource Chip}">
                            <TextBlock Text="Nothing sent to a cloud" FontSize="{StaticResource Font.Size.Normal}" />
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </StackPanel>
    </DataTemplate>

    <!-- 2. License Agreement -->
    <DataTemplate x:Key="LicenseStep" DataType="{x:Type vm:SetupViewModel}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0">
                <TextBlock Style="{StaticResource ScreenTitle}" Text="License Agreement" />
                <TextBlock Style="{StaticResource ScreenSubtitle}" Text="Read the license agreement before continuing." />
            </StackPanel>

            <Border Grid.Row="1" Style="{StaticResource Panel}" Margin="0,18,0,0" Padding="18,14">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Style="{StaticResource MonoText}">
                            LocalNEXUS. Copyright 2026 You Know Its Me Studios. Licensed under the Apache License,
                            Version 2.0 (the "License"); you may not use this software except in compliance with the
                            License.
                        </TextBlock>
                        <TextBlock Style="{StaticResource MonoText}" Margin="0,14,0,0">
                            Unless required by applicable law or agreed to in writing, this software is distributed on
                            an "as is" basis, without warranties or conditions of any kind, either express or implied.
                        </TextBlock>
                        <TextBlock Style="{StaticResource MonoText}" Margin="0,14,0,0">
                            The engine binaries fetched by this installer, which are llama.cpp, Mesh LLM and uv, are
                            not redistributed under this License. Each carries its own, and each is fetched fresh from
                            its own release page at install time rather than being carried inside this installer.
                        </TextBlock>
                        <TextBlock Style="{StaticResource MonoText}" Margin="0,14,0,0">
                            llama.cpp is MIT, by the ggml authors. Mesh LLM is Apache-2.0. uv is Apache-2.0 or MIT, at
                            your option.
                        </TextBlock>
                        <TextBlock Style="{StaticResource MonoText}" Margin="0,14,0,0">
                            See the full text at the project repository before installing.
                        </TextBlock>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,18,0,0">
                <Button Command="{Binding AcceptCommand}" AutomationProperties.AutomationId="AcceptOption" AutomationProperties.Name="I accept the agreement" Style="{StaticResource QuietButton}" Padding="0" MinWidth="0" Margin="0,0,28,0">
                    <StackPanel Orientation="Horizontal">
                        <Grid Width="18" Height="18" VerticalAlignment="Center">
                            <Ellipse Stroke="{StaticResource Surface.Border.Brush}" StrokeThickness="1" />
                            <Ellipse Margin="4"
                                     Fill="{StaticResource Accent.Gradient.Brush}"
                                     Visibility="{Binding LicenseAccepted, Converter={StaticResource BooleanToVisibility}}" />
                        </Grid>
                        <TextBlock Text="I accept the agreement" Margin="10,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Button Command="{Binding DeclineCommand}" AutomationProperties.AutomationId="DeclineOption" AutomationProperties.Name="I do not accept" Style="{StaticResource QuietButton}" Padding="0" MinWidth="0">
                    <StackPanel Orientation="Horizontal">
                        <Grid Width="18" Height="18" VerticalAlignment="Center">
                            <Ellipse Stroke="{StaticResource Surface.Border.Brush}" StrokeThickness="1" />
                            <Ellipse Margin="4"
                                     Fill="{StaticResource Text.Muted.Brush}"
                                     Visibility="{Binding LicenseDeclined, Converter={StaticResource BooleanToVisibility}}" />
                        </Grid>
                        <TextBlock Text="I do not accept" Margin="10,0,0,0" VerticalAlignment="Center"
                                   Foreground="{StaticResource Text.Secondary.Brush}" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
    </DataTemplate>

    <!-- 3. Select Components -->
    <DataTemplate x:Key="ComponentsStep" DataType="{x:Type vm:SetupViewModel}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0">
                <TextBlock Style="{StaticResource ScreenTitle}" Text="Select Components" />
                <TextBlock Style="{StaticResource ScreenSubtitle}" Text="Choose which parts of LocalNEXUS to install." />
            </StackPanel>

            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,16,0,0">
                <Button Style="{StaticResource PresetButton}" Content="Everything" Command="{Binding PresetEverythingCommand}" Margin="0,0,10,0" />
                <Button Style="{StaticResource PresetButton}" Content="Local models only" Command="{Binding PresetLocalOnlyCommand}" />
            </StackPanel>

            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="0,16,0,0">
                <ItemsControl ItemsSource="{Binding Components}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Command="{Binding DataContext.ToggleComponentCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding}"
                                    AutomationProperties.Name="{Binding Name}"
                                    HorizontalContentAlignment="Stretch"
                                    Margin="0,0,0,6">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Style="{StaticResource SelectableRow}">
                                            <ContentPresenter />
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Grid Grid.Column="0" Width="17" Height="17" VerticalAlignment="Center">
                                        <Border CornerRadius="4"
                                                BorderBrush="{StaticResource Surface.Border.Brush}"
                                                BorderThickness="1" />
                                        <Border CornerRadius="4"
                                                Background="{StaticResource Accent.Gradient.Brush}"
                                                Visibility="{Binding IsSelected, Converter={StaticResource BooleanToVisibility}}">
                                            <TextBlock Text="&#xE73E;"
                                                       FontFamily="{StaticResource Font.Icons}"
                                                       FontSize="9"
                                                       Foreground="{StaticResource Text.Inverse.Brush}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                        </Border>
                                    </Grid>

                                    <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                            <Border Style="{StaticResource Chip}"
                                                    Padding="7,1"
                                                    CornerRadius="8"
                                                    Margin="8,0,0,0"
                                                    VerticalAlignment="Center"
                                                    Visibility="{Binding IsRequired, Converter={StaticResource BooleanToVisibility}}">
                                                <TextBlock Style="{StaticResource MetaText}" Text="required" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Style="{StaticResource MetaText}" Text="{Binding Description}" Margin="0,3,0,0" TextWrapping="Wrap" />
                                    </StackPanel>

                                    <TextBlock Grid.Column="2"
                                               Style="{StaticResource MetaText}"
                                               Text="{Binding SizeText}"
                                               VerticalAlignment="Center"
                                               Margin="12,0,0,0" />
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <Button Grid.Row="3"
                    Style="{StaticResource QuietButton}"
                    HorizontalAlignment="Left"
                    Padding="0"
                    MinWidth="0"
                    Margin="0,12,0,0"
                    Command="{Binding ToggleDesktopShortcutCommand}"
                    AutomationProperties.AutomationId="DesktopShortcutToggle"
                    AutomationProperties.Name="Create a desktop shortcut">
                <StackPanel Orientation="Horizontal">
                    <Grid Width="17" Height="17" VerticalAlignment="Center">
                        <Border CornerRadius="4" BorderBrush="{StaticResource Surface.Border.Brush}" BorderThickness="1" />
                        <Border CornerRadius="4"
                                Background="{StaticResource Accent.Gradient.Brush}"
                                Visibility="{Binding CreateDesktopShortcut, Converter={StaticResource BooleanToVisibility}}">
                            <TextBlock Text="&#xE73E;"
                                       FontFamily="{StaticResource Font.Icons}"
                                       FontSize="9"
                                       Foreground="{StaticResource Text.Inverse.Brush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                    <TextBlock Text="Create a desktop shortcut" Margin="10,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </Grid>
    </DataTemplate>

    <!-- 4. Choose a Build -->
    <DataTemplate x:Key="BuildStep" DataType="{x:Type vm:SetupViewModel}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0">
                <TextBlock Style="{StaticResource ScreenTitle}" Text="Choose a llama.cpp Build" />
                <TextBlock Style="{StaticResource ScreenSubtitle}" Text="{Binding DetectionSummary}" />
            </StackPanel>

            <ItemsControl Grid.Row="1" ItemsSource="{Binding BuildOptions}" Margin="0,20,0,0" VerticalAlignment="Top">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Command="{Binding DataContext.SelectBuildCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                CommandParameter="{Binding}"
                                AutomationProperties.Name="{Binding Name}"
                                HorizontalContentAlignment="Stretch"
                                Margin="0,0,0,10">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Row" Style="{StaticResource SelectableRow}">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                            <Setter TargetName="Row" Property="BorderBrush" Value="{StaticResource Accent.Primary.Brush}" />
                                            <Setter TargetName="Row" Property="Background" Value="{StaticResource Accent.Soft.Brush}" />
                                        </DataTrigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Grid Grid.Column="0" Width="18" Height="18" VerticalAlignment="Center">
                                    <Ellipse Stroke="{StaticResource Surface.Border.Brush}" StrokeThickness="1" />
                                    <Ellipse Margin="4"
                                             Fill="{StaticResource Accent.Gradient.Brush}"
                                             Visibility="{Binding IsSelected, Converter={StaticResource BooleanToVisibility}}" />
                                </Grid>

                                <StackPanel Grid.Column="1" Margin="14,0,0,0">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                    <TextBlock Style="{StaticResource MetaText}" Text="{Binding Description}" Margin="0,3,0,0" />
                                </StackPanel>

                                <TextBlock Grid.Column="2"
                                           Style="{StaticResource MetaText}"
                                           Text="{Binding SizeText}"
                                           VerticalAlignment="Center"
                                           Margin="12,0,0,0" />
                            </Grid>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>
    </DataTemplate>

    <!-- 5. Ready to Install -->
    <DataTemplate x:Key="ReadyStep" DataType="{x:Type vm:SetupViewModel}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0">
                <TextBlock Style="{StaticResource ScreenTitle}" Text="Ready to Install" />
                <TextBlock Style="{StaticResource ScreenSubtitle}" Text="Setup is now ready to install LocalNEXUS on this computer." />
            </StackPanel>

            <Border Grid.Row="1" Style="{StaticResource Panel}" Margin="0,18,0,0" Padding="20,18">
                <StackPanel>
                    <TextBlock Style="{StaticResource MetaText}" Text="DESTINATION" />
                    <TextBlock Style="{StaticResource MonoText}"
                               Foreground="{StaticResource Text.Primary.Brush}"
                               Text="{Binding Destination}"
                               Margin="0,7,0,0" />

                    <TextBlock Style="{StaticResource MetaText}" Text="ENGINES TO FETCH" Margin="0,22,0,0" />

                    <TextBlock Style="{StaticResource MetaText}"
                               Margin="0,10,0,0"
                               TextWrapping="Wrap"
                               Foreground="{StaticResource Status.Warning.Brush}"
                               Visibility="{Binding NothingSelected, Converter={StaticResource BooleanToVisibility}}"
                               Text="Nothing optional is ticked. LocalNEXUS will install and start, but it will not be able to run a model, because no engine was selected on the previous step. Add one later by running this installer again." />

                    <ItemsControl ItemsSource="{Binding FetchList}" Margin="0,8,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,5">
                                    <TextBlock Text="{Binding Label}" HorizontalAlignment="Left" />
                                    <TextBlock Style="{StaticResource MetaText}" Text="{Binding SizeText}" HorizontalAlignment="Right" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </Grid>
    </DataTemplate>

    <!-- 6. Installing -->
    <DataTemplate x:Key="InstallingStep" DataType="{x:Type vm:SetupViewModel}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0">
                <TextBlock Style="{StaticResource ScreenTitle}" Text="Installing" />
                <TextBlock Style="{StaticResource ScreenSubtitle}" Text="Please wait while the engines are downloaded and set up." />
            </StackPanel>

            <StackPanel Grid.Row="1" Margin="0,22,0,0">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="8" Height="8" Fill="{StaticResource Accent.Primary.Brush}" VerticalAlignment="Center">
                        <Ellipse.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.25" Duration="0:0:0.9" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Ellipse.Triggers>
                    </Ellipse>
                    <TextBlock Text="{Binding CurrentFile}" Margin="10,0,0,0" VerticalAlignment="Center" />
                </StackPanel>

                <Grid x:Name="BarTrack" Height="8" Margin="0,12,0,0">
                    <Border CornerRadius="4" Background="{StaticResource Surface.Input.Brush}" />
                    <Border CornerRadius="4"
                            HorizontalAlignment="Left"
                            Background="{StaticResource Accent.GradientHorizontal.Brush}">
                        <Border.Width>
                            <MultiBinding Converter="{StaticResource FractionToWidth}">
                                <Binding Path="InstallFraction" />
                                <Binding Path="ActualWidth" ElementName="BarTrack" />
                            </MultiBinding>
                        </Border.Width>
                    </Border>
                </Grid>

                <TextBlock Style="{StaticResource MetaText}" Text="{Binding PercentText}" Margin="0,8,0,0" />
            </StackPanel>

            <Border Grid.Row="2" Style="{StaticResource LogPanel}" Margin="0,16,0,0" Padding="16,12">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Log}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Style="{StaticResource MonoText}" Text="{Binding}" TextWrapping="Wrap" Margin="0,0,0,2" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>
        </Grid>
    </DataTemplate>

    <!-- 7. Finish -->
    <DataTemplate x:Key="FinishStep" DataType="{x:Type vm:SetupViewModel}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Image Grid.Column="0"
                   Width="64"
                   Height="64"
                   VerticalAlignment="Top"
                   RenderOptions.BitmapScalingMode="HighQuality"
                   Source="/Assets/Brand/Mark.png" />

            <StackPanel Grid.Column="1" Margin="22,0,0,0">
                <TextBlock Style="{StaticResource ScreenTitle}" Text="Completing the LocalNEXUS Setup Wizard" />
                <TextBlock Style="{StaticResource ScreenSubtitle}" Text="Setup has finished installing LocalNEXUS on this computer." />

                <Button Style="{StaticResource QuietButton}"
                        HorizontalAlignment="Left"
                        Padding="0"
                        MinWidth="0"
                        Margin="0,20,0,0"
                        Command="{Binding ToggleLaunchCommand}"
                        AutomationProperties.AutomationId="LaunchToggle"
                        AutomationProperties.Name="Launch LocalNEXUS">
                    <StackPanel Orientation="Horizontal">
                        <Grid Width="17" Height="17" VerticalAlignment="Center">
                            <Border CornerRadius="4" BorderBrush="{StaticResource Surface.Border.Brush}" BorderThickness="1" />
                            <Border CornerRadius="4"
                                    Background="{StaticResource Accent.Gradient.Brush}"
                                    Visibility="{Binding LaunchOnFinish, Converter={StaticResource BooleanToVisibility}}">
                                <TextBlock Text="&#xE73E;"
                                           FontFamily="{StaticResource Font.Icons}"
                                           FontSize="9"
                                           Foreground="{StaticResource Text.Inverse.Brush}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                        <TextBlock Text="Launch LocalNEXUS" Margin="10,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
    </DataTemplate>

</ResourceDictionary>
