<Window x:Class="LocalNEXUS.Installer.Views.UninstallWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Remove LocalNEXUS"
        Height="380"
        Width="560"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="{StaticResource Font.Sans}"
        TextOptions.TextFormattingMode="Ideal">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="42" ResizeBorderThickness="0" GlassFrameThickness="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Border Background="{StaticResource Backdrop.Brush}"
            BorderBrush="{StaticResource Surface.Border.Brush}"
            BorderThickness="1"
            CornerRadius="{StaticResource Radius.Window}">
        <Grid Margin="28,20,28,22">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0">
                <TextBlock Style="{StaticResource ScreenTitle}" Text="Remove LocalNEXUS" />
                <TextBlock Style="{StaticResource ScreenSubtitle}" Text="This removes the application and the engine binaries it installed." />
            </StackPanel>

            <StackPanel Grid.Row="1" Margin="0,20,0,0">
                <Button x:Name="DataToggle" Style="{StaticResource QuietButton}" HorizontalAlignment="Left" Padding="0" MinWidth="0">
                    <StackPanel Orientation="Horizontal">
                        <Grid Width="17" Height="17" VerticalAlignment="Center">
                            <Border CornerRadius="4" BorderBrush="{StaticResource Surface.Border.Brush}" BorderThickness="1" />
                            <Border x:Name="DataTick"
                                    CornerRadius="4"
                                    Background="{StaticResource Accent.Gradient.Brush}"
                                    Visibility="Collapsed">
                                <TextBlock Text="&#xE73E;"
                                           FontFamily="{StaticResource Font.Icons}"
                                           FontSize="9"
                                           Foreground="{StaticResource Text.Inverse.Brush}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                        <TextBlock Text="Also remove my settings, saved graphs and models catalogue" Margin="10,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <TextBlock Style="{StaticResource MetaText}"
                           Margin="27,8,0,0"
                           TextWrapping="Wrap"
                           Text="Leave this unticked and your work stays where it is, so reinstalling picks up where you left off. Ticking it also removes the Python runtime, which is a multi gigabyte download to rebuild. Model files themselves are never touched wherever they live." />

                <Border Style="{StaticResource LogPanel}" Margin="0,16,0,0" Padding="14,10" Height="110">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="LogList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Style="{StaticResource MonoText}" Text="{Binding}" TextWrapping="Wrap" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>
            </StackPanel>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <Button x:Name="CancelButton" Style="{StaticResource QuietButton}" Content="Cancel" Margin="0,0,8,0" />
                <Button x:Name="RemoveButton" Style="{StaticResource PrimaryButton}" Content="Remove" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
