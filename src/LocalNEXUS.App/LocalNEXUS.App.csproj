<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>LocalNEXUS.App</RootNamespace>
    <AssemblyName>LocalNEXUS</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>$(BrandIcon)</ApplicationIcon>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <!--
        Bundled as WPF resources rather than as files beside the exe, which is what makes the font
        survive single file publishing: a Resource is compiled into the assembly and reached
        through a pack uri, so there is no path to resolve differently from the IDE and from the
        published exe. JetBrains Mono is OFL licensed and OFL.txt travels with it.
    -->
    <Resource Include="Assets\Fonts\JetBrainsMono-Regular.ttf" />
    <Resource Include="Assets\Fonts\JetBrainsMono-Bold.ttf" />

    <!--
        The brand mark the title bar draws, linked in under a fixed name so the XAML does not
        name a concept. Which file this is comes from BrandConcept in Directory.Build.props.
    -->
    <Resource Include="$(BrandMark)" Link="Assets\Brand\Mark.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Scripting" Version="4.11.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="4.11.0" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.11" />
    <PackageReference Include="ModelContextProtocol.Core" Version="2.2.0" />
    <PackageReference Include="Nodify" Version="7.3.0" />
  </ItemGroup>

</Project>
