<Window x:Class="LocalNEXUS.App.Views.ModelsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:behaviors="clr-namespace:LocalNEXUS.App.Infrastructure.Behaviors"
        xmlns:vm="clr-namespace:LocalNEXUS.App.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:ModelBrowserViewModel}"
        Title="Get a model"
        Height="720"
        Width="880"
        MinHeight="480"
        MinWidth="640"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Surface.Window.Brush}"
        Foreground="{DynamicResource Text.Primary.Brush}"
        FontFamily="{StaticResource Font.Sans}"
        TextOptions.TextFormattingMode="Ideal">

    <!--
        Getting a model, rather than pointing at one already here. It leads with whether each file
        fits, because that is the decision people get wrong and the one they currently only find
        out after the download.

        A window off the activity bar rather than a section in settings. It was a collapsed
        expander inside the Models page of settings, which is three steps behind a gear, and
        somebody who does not already own a model is exactly the person who will not go looking
        there. It is also not a setting: nothing here is a preference, it is a task with a
        progress bar, and it wants to stay open while the work carries on.
    -->

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Style="{StaticResource SectionHeader}"
                   FontSize="{StaticResource Font.Size.Title}"
                   Margin="0,0,0,12"
                   Text="Get a model" />

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,10,0">
            <StackPanel>

                <TextBlock Style="{StaticResource HintText}"
                           TextWrapping="Wrap"
                           Text="Searches Hugging Face for GGUF models. No account and no sign in. A repository that requires one is shown as gated, with a link." />

                <DockPanel Margin="0,10,0,0">
                    <Button DockPanel.Dock="Right"
                            Style="{StaticResource SmallButton}"
                            Margin="8,0,0,0"
                            MinWidth="80"
                            Content="Search"
                            IsDefault="True"
                            Command="{Binding SearchCommand}" />

                    <TextBox Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}"
                             behaviors:TextBoxHelper.Placeholder="qwen2.5-coder, llama-3.1, mistral" />
                </DockPanel>

                <TextBlock Style="{StaticResource HintText}"
                           Margin="0,6,0,0"
                           TextWrapping="Wrap"
                           Text="{Binding CardSummary}" />

                <TextBlock Style="{StaticResource HintText}"
                           Margin="0,6,0,0"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource Status.Warning.Brush}"
                           Text="{Binding Status}"
                           Visibility="{Binding HasStatus, Converter={StaticResource BooleanToVisibility}}" />

                <Button Style="{StaticResource SmallButton}"
                        Margin="0,6,0,0"
                        HorizontalAlignment="Left"
                        Content="Open the page"
                        Command="{Binding OpenLinkCommand}"
                        Visibility="{Binding HasLink, Converter={StaticResource BooleanToVisibility}}" />

                <!-- What the search found. Selecting one lists what is inside it. -->
                <ItemsControl ItemsSource="{Binding Results}" Margin="0,10,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <DockPanel Margin="0,2">
                                <Button DockPanel.Dock="Right"
                                        Style="{StaticResource SmallButton}"
                                        Margin="8,0,0,0"
                                        Content="Files"
                                        Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}" />

                                <TextBlock DockPanel.Dock="Right"
                                           Style="{StaticResource HintText}"
                                           Margin="8,0,0,0"
                                           VerticalAlignment="Center"
                                           Text="{Binding Downloads, StringFormat={}{0:N0} downloads}" />

                                <TextBlock VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           Text="{Binding Id}" />
                            </DockPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- The files, and what each one would mean for this machine. -->
                <ItemsControl ItemsSource="{Binding Files}"
                              Margin="0,12,0,0"
                              Visibility="{Binding HasSelection, Converter={StaticResource BooleanToVisibility}}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,8"
                                    Padding="10,8"
                                    CornerRadius="3"
                                    Background="{DynamicResource Surface.Card.Brush}">
                                <StackPanel>
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right"
                                                Style="{StaticResource SmallButton}"
                                                Margin="8,0,0,0"
                                                MinWidth="94"
                                                Content="{Binding ActionLabel}"
                                                IsEnabled="{Binding IsIdle}"
                                                Command="{Binding DataContext.DownloadCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}" />

                                        <TextBlock DockPanel.Dock="Right"
                                                   Style="{StaticResource MonoText}"
                                                   Margin="8,0,0,0"
                                                   VerticalAlignment="Center"
                                                   Text="{Binding SizeLabel}" />

                                        <TextBlock FontWeight="SemiBold"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"
                                                   Text="{Binding Quantisation}" />
                                    </DockPanel>

                                    <TextBlock Style="{StaticResource MonoText}"
                                               Margin="0,3,0,0"
                                               Foreground="{DynamicResource Text.Muted.Brush}"
                                               TextTrimming="CharacterEllipsis"
                                               Text="{Binding File.Path}" />

                                    <TextBlock Margin="0,5,0,0" TextWrapping="Wrap" Text="{Binding FitText}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource HintText}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding WillNotFit}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource Status.Warning.Brush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <TextBlock Style="{StaticResource HintText}"
                                               Margin="0,3,0,0"
                                               TextWrapping="Wrap"
                                               Text="{Binding VerificationText}" />

                                    <TextBlock Style="{StaticResource HintText}"
                                               Margin="0,3,0,0"
                                               TextWrapping="Wrap"
                                               Foreground="{DynamicResource Status.Warning.Brush}"
                                               Text="One part of a model split across several files. Downloading this alone does not give you a model."
                                               Visibility="{Binding IsOnePartOfSeveral, Converter={StaticResource BooleanToVisibility}}" />

                                    <DockPanel Margin="0,6,0,0"
                                               Visibility="{Binding IsDownloading, Converter={StaticResource BooleanToVisibility}}">
                                        <Button DockPanel.Dock="Right"
                                                Style="{StaticResource SmallButton}"
                                                Margin="8,0,0,0"
                                                Content="Discard"
                                                ToolTip="Stops and deletes what has been downloaded so far."
                                                Command="{Binding DataContext.DiscardCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}" />

                                        <Button DockPanel.Dock="Right"
                                                Style="{StaticResource SmallButton}"
                                                Margin="8,0,0,0"
                                                Content="Stop"
                                                ToolTip="Stops, and keeps what arrived so it can carry on later."
                                                Command="{Binding DataContext.StopCommand, RelativeSource={RelativeSource AncestorType=Window}}" />

                                        <TextBlock Style="{StaticResource HintText}"
                                                   VerticalAlignment="Center"
                                                   Text="{Binding ProgressText}" />
                                    </DockPanel>

                                    <TextBlock Style="{StaticResource HintText}"
                                               Margin="0,5,0,0"
                                               TextWrapping="Wrap"
                                               Text="{Binding Note}"
                                               Visibility="{Binding HasNote, Converter={StaticResource BooleanToVisibility}}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
