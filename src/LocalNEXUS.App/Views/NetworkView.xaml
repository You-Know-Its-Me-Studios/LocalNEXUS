<UserControl x:Class="LocalNEXUS.App.Views.NetworkView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:net="clr-namespace:LocalNEXUS.App.ViewModels.Network"
             xmlns:behaviors="clr-namespace:LocalNEXUS.App.Infrastructure.Behaviors"
             xmlns:vm="clr-namespace:LocalNEXUS.App.ViewModels"
             d:DataContext="{d:DesignInstance Type=vm:NetworkViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Background="Transparent">

    <!--
        Every model the network can serve, one per row, sortable.

        The coverage bar is a segment per section of the pipeline, coloured by what the mesh
        reports about that section, so the shape of a split model and the health of each piece of
        it are the same picture. A model still being assembled has blue segments, never red:
        something coming up has not failed at anything.

        Four columns say "not reported" instead of a number. The mesh does not tell us a model's
        size on disk or its throughput, and a table that made those up would be lying exactly where
        somebody would trust it.
    -->

    <!--
        No fill of its own, so the window base layer shows behind the table and a theme that can
        be seen through is seen through here as it is on the canvas. The status strip, the column
        headings and the note underneath keep the fill they were inheriting and stay opaque, the
        same treatment the tab strip and the request bar get on the Workspace.
    -->

    <UserControl.Resources>

        <!-- One segment per section, coloured by that section's own coverage. -->
        <DataTemplate x:Key="CoverageSegment">
            <Border Width="14"
                    Height="9"
                    Margin="0,0,2,0"
                    CornerRadius="1"
                    ToolTip="{Binding StatusDetail}"
                    Background="{Binding Coverage, Converter={StaticResource ResourceLookup}, ConverterParameter=SectionCoverage}" />
        </DataTemplate>

    </UserControl.Resources>

    <DockPanel>

        <!--
            Escape backs out of whatever the inspector is pinned to, which is what escape means
            everywhere else in this window.
        -->
        <DockPanel.InputBindings>
            <KeyBinding Key="Escape" Command="{Binding ClearInspectorCommand}" />
        </DockPanel.InputBindings>

        <!-- What the mesh itself is doing, above the table. -->
        <Border DockPanel.Dock="Top"
                Background="{DynamicResource Surface.Window.Brush}"
                BorderBrush="{DynamicResource Surface.Border.Brush}"
                BorderThickness="0,0,0,1"
                Padding="16,9">
            <DockPanel>
                <Grid DockPanel.Dock="Right" Width="200">
                    <TextBox Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}" />

                    <!-- A watermark, because a filter box that looks like an empty box is furniture. -->
                    <TextBlock Text="Filter models"
                               Margin="9,0,0,0"
                               VerticalAlignment="Center"
                               IsHitTestVisible="False"
                               FontSize="{StaticResource Font.Size.Small}"
                               Foreground="{DynamicResource Text.Muted.Brush}"
                               Visibility="{Binding FilterText, Converter={StaticResource StringToVisibility}, ConverterParameter=Invert}" />
                </Grid>

                <!--
                    Turning the node on lives here, beside the line that says it is off, rather
                    than in Settings where it was. Nothing else about the mesh is in Settings that
                    somebody needs mid use, and a start button on a different screen from the one
                    the feature lives on is a start button nobody finds.
                -->
                <!--
                    Asking the public directory who else is out there. A button rather than
                    something that happens on its own, because it is the only thing here that
                    reaches past the local network without a model being run.
                -->
                <Button DockPanel.Dock="Right"
                        Style="{StaticResource SmallButton}"
                        Margin="10,0,0,0"
                        MinWidth="110"
                        VerticalAlignment="Center"
                        Content="{Binding FindMeshesText}"
                        ToolTip="Asks the public directory which meshes are out there and lists them here. Nothing about this machine is published by asking."
                        Command="{Binding FindMeshesCommand}" />

                <Button DockPanel.Dock="Right"
                        Style="{StaticResource SmallButton}"
                        Margin="10,0,0,0"
                        MinWidth="110"
                        VerticalAlignment="Center"
                        Content="{Binding StartButtonText}"
                        ToolTip="Starts the mesh node with the settings on the left, or stops it if it is already up."
                        Command="{Binding ToggleMeshCommand}" />

                <Ellipse Style="{StaticResource StateDot}"
                         Margin="0,0,9,0"
                         Fill="{Binding Mesh.State, Converter={StaticResource ResourceLookup}, ConverterParameter=MeshNodeState}" />

                <TextBlock Text="{Binding Mesh.MeshName}"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           Margin="0,0,10,0" />

                <TextBlock Style="{StaticResource MutedText}"
                           VerticalAlignment="Center"
                           Text="{Binding Mesh.StatusText}" />

                <!--
                    Which mesh this is, which the node state does not say. Joining sets a token and
                    changes nothing visible until the node restarts, so without this somebody who
                    joined one saw exactly what they saw before.
                -->
                <TextBlock Style="{StaticResource MutedText}"
                           VerticalAlignment="Center"
                           Margin="10,0,0,0"
                           Foreground="{DynamicResource Text.Muted.Brush}"
                           Text="{Binding MembershipText}" />
            </DockPanel>
        </Border>

        <!--
            What the last thing pressed here did. This tab wrote its answers to the activity feed,
            which is only drawn in the Workspace, so joining a mesh reported itself twice into a
            panel this section never shows and read as a button that did nothing.
        -->
        <Border DockPanel.Dock="Top"
                Background="{DynamicResource Surface.Panel.Brush}"
                BorderBrush="{DynamicResource Surface.Border.Brush}"
                BorderThickness="0,0,0,1"
                Padding="16,8"
                Visibility="{Binding HasNotice, Converter={StaticResource BooleanToVisibility}}">
            <DockPanel>
                <Button DockPanel.Dock="Right"
                        Style="{StaticResource IconButton}"
                        Margin="10,0,0,0"
                        Content="&#xE711;"
                        ToolTip="Dismiss"
                        AutomationProperties.Name="Dismiss"
                        Command="{Binding DismissNoticeCommand}" />

                <TextBlock TextWrapping="Wrap"
                           VerticalAlignment="Center"
                           Text="{Binding Notice}"
                           Foreground="{DynamicResource Text.Primary.Brush}"
                           Visibility="{Binding NoticeIsProblem, Converter={StaticResource BooleanToVisibility}, ConverterParameter=Invert}" />

                <TextBlock TextWrapping="Wrap"
                           VerticalAlignment="Center"
                           Text="{Binding Notice}"
                           Foreground="{DynamicResource Status.Danger.Brush}"
                           Visibility="{Binding NoticeIsProblem, Converter={StaticResource BooleanToVisibility}}" />
            </DockPanel>
        </Border>

        <!--
            Where this machine stands, under the results and above the legend, and always there.
            The table answers what is out there; this answers what you are in, which is a different
            question and had no place to be asked. It carried a mesh being joined only for the two
            seconds a dismissable strip was on screen.
        -->
        <Border DockPanel.Dock="Bottom"
                Background="{DynamicResource Surface.Panel.Brush}"
                BorderBrush="{DynamicResource Surface.Border.Brush}"
                BorderThickness="0,1,0,0"
                Padding="16,12">
            <StackPanel>
                <DockPanel>
                    <!--
                        Only when there is one to leave. A button that goes grey and stays grey has
                        to be explained; one that is not there does not.
                    -->
                    <Button DockPanel.Dock="Right"
                            Style="{StaticResource SmallButton}"
                            Margin="12,0,0,0"
                            VerticalAlignment="Center"
                            Content="Leave and host your own again"
                            Command="{Binding LeaveMeshCommand}"
                            Visibility="{Binding IsGuestInAnotherMesh, Converter={StaticResource BooleanToVisibility}}" />

                    <Ellipse Style="{StaticResource StateDot}"
                             Margin="0,0,9,0"
                             VerticalAlignment="Center"
                             Fill="{Binding Mesh.State, Converter={StaticResource ResourceLookup}, ConverterParameter=MeshNodeState}" />

                    <TextBlock Text="{Binding MembershipHeading}"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                </DockPanel>

                <TextBlock Style="{StaticResource HintText}"
                           Margin="0,4,0,0"
                           TextWrapping="Wrap"
                           Text="{Binding MembershipDetail}" />

                <ProgressBar Margin="0,8,0,0"
                             Height="3"
                             IsIndeterminate="True"
                             Visibility="{Binding IsJoining, Converter={StaticResource BooleanToVisibility}}" />

                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Style="{StaticResource FieldLabel}" Margin="0,0,0,2" Text="Mesh" />
                        <TextBlock Style="{StaticResource MonoText}"
                                   TextWrapping="Wrap"
                                   Text="{Binding MembershipMeshName}" />
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Style="{StaticResource FieldLabel}" Margin="0,0,0,2" Text="In it" />
                        <TextBlock Style="{StaticResource MonoText}" Text="{Binding MembershipSize}" />
                    </StackPanel>

                    <StackPanel Grid.Column="4">
                        <TextBlock Style="{StaticResource FieldLabel}" Margin="0,0,0,2" Text="Node" />
                        <TextBlock Style="{StaticResource MonoText}"
                                   TextWrapping="Wrap"
                                   Text="{Binding Mesh.StatusText}" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!--
            What each heading means, in the order they appear. Plain sentences: somebody reading
            this is asking what a word means, and an answer they have to decode twice is not one.

            Anything the mesh does not measure says so here rather than in the cell, so the table
            keeps its shape and the reason is in one place.
        -->
        <Border DockPanel.Dock="Bottom"
                Background="{DynamicResource Surface.Window.Brush}"
                BorderBrush="{DynamicResource Surface.Border.Brush}"
                BorderThickness="0,1,0,0"
                Padding="16,8">
            <ItemsControl>
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,0,20,4">
                        <TextBlock Style="{StaticResource MonoText}"
                                   Margin="0,0,7,0"
                                   Foreground="{DynamicResource Text.Secondary.Brush}"
                                   Text="NAME" />
                        <TextBlock Style="{StaticResource MutedText}" Text="The model name, or the mesh name for a search result." />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,20,4">
                        <TextBlock Style="{StaticResource MonoText}"
                                   Margin="0,0,7,0"
                                   Foreground="{DynamicResource Text.Secondary.Brush}"
                                   Text="SIZE" />
                        <TextBlock Style="{StaticResource MutedText}" Text="How much memory it takes. For a mesh, how much its machines have in total." />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,20,4">
                        <TextBlock Style="{StaticResource MonoText}"
                                   Margin="0,0,7,0"
                                   Foreground="{DynamicResource Text.Secondary.Brush}"
                                   Text="COVERAGE" />
                        <TextBlock Style="{StaticResource MutedText}" Text="The model split into parts. A filled block means a machine is running that part." />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,20,4">
                        <TextBlock Style="{StaticResource MonoText}"
                                   Margin="0,0,7,0"
                                   Foreground="{DynamicResource Text.Secondary.Brush}"
                                   Text="SOURCES" />
                        <TextBlock Style="{StaticResource MutedText}" Text="How many machines are running it." />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,20,4">
                        <TextBlock Style="{StaticResource MonoText}"
                                   Margin="0,0,7,0"
                                   Foreground="{DynamicResource Text.Secondary.Brush}"
                                   Text="BACKUPS" />
                        <TextBlock Style="{StaticResource MutedText}" Text="Spare machines ready to take over if one drops out. Zero means no safety net." />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,20,4">
                        <TextBlock Style="{StaticResource MonoText}"
                                   Margin="0,0,7,0"
                                   Foreground="{DynamicResource Text.Secondary.Brush}"
                                   Text="STATUS" />
                        <TextBlock Style="{StaticResource MutedText}" Text="Whether you can use it right now." />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,20,4">
                        <TextBlock Style="{StaticResource MonoText}"
                                   Margin="0,0,7,0"
                                   Foreground="{DynamicResource Text.Secondary.Brush}"
                                   Text="CTX" />
                        <TextBlock Style="{StaticResource MutedText}" Text="How much text the model can take in at once." />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,20,4">
                        <TextBlock Style="{StaticResource MonoText}"
                                   Margin="0,0,7,0"
                                   Foreground="{DynamicResource Text.Secondary.Brush}"
                                   Text="CONTENTS" />
                        <TextBlock Style="{StaticResource MutedText}" Text="For a mesh, the models it runs. For a model, the machines running it." />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,20,4">
                        <TextBlock Style="{StaticResource MonoText}"
                                   Margin="0,0,7,0"
                                   Foreground="{DynamicResource Text.Secondary.Brush}"
                                   Text="VERIFIED" />
                        <TextBlock Style="{StaticResource MutedText}" Text="When the mesh last checked on it." />
                    </StackPanel>
            </ItemsControl>
        </Border>

        <!--
            One horizontal scroller around the headings and the rows together, because two would
            drift apart the moment either was scrolled. With both side panels open the table is
            wider than what is left of the window, and the last columns were simply unreachable:
            no bar, no way across, and nothing saying anything had been cut off.

            Vertical scrolling is disabled here and left to the list inside, so the headings stay
            put while the rows move under them.
        -->
        <ScrollViewer HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Disabled"
                      behaviors:HorizontalWheelBehavior.IsEnabled="True">
            <DockPanel MinWidth="1136">

        <!-- Column headings. -->
        <Border DockPanel.Dock="Top"
                Background="{DynamicResource Surface.Window.Brush}"
                BorderBrush="{DynamicResource Surface.Border.Brush}"
                BorderThickness="0,0,0,1"
                Padding="16,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <!--
                        Widths are sized to the longest thing each column actually prints, which is
                        "not reported" in three of them. They were sized to their headings instead,
                        so the values were clipped to "not repo..." and ran into the column beside
                        them. The name column keeps the slack, because a name is the one thing here
                        that has no length anybody can predict.
                    -->
                    <ColumnDefinition Width="240" />
                    <ColumnDefinition Width="96" />
                    <ColumnDefinition Width="112" />
                    <ColumnDefinition Width="76" />
                    <ColumnDefinition Width="76" />
                    <ColumnDefinition Width="104" />
                    <ColumnDefinition Width="112" />
                    <ColumnDefinition Width="*" MinWidth="220" />
                    <ColumnDefinition Width="88" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Style="{StaticResource ColumnHeader}" Content="NAME"
                        Command="{Binding SortCommand}" CommandParameter="{x:Static net:ModelColumn.Name}" />
                <Button Grid.Column="1" Style="{StaticResource ColumnHeader}" Content="SIZE"
                        IsEnabled="False" ToolTip="Not reported by the mesh." />
                <Button Grid.Column="2" Style="{StaticResource ColumnHeader}" Content="COVERAGE"
                        Command="{Binding SortCommand}" CommandParameter="{x:Static net:ModelColumn.Coverage}" />
                <Button Grid.Column="3" Style="{StaticResource ColumnHeader}" Content="SOURCES"
                        Command="{Binding SortCommand}" CommandParameter="{x:Static net:ModelColumn.Sources}" />
                <Button Grid.Column="4" Style="{StaticResource ColumnHeader}" Content="BACKUPS"
                        Command="{Binding SortCommand}" CommandParameter="{x:Static net:ModelColumn.Spare}" />
                <Button Grid.Column="5" Style="{StaticResource ColumnHeader}" Content="STATUS"
                        Command="{Binding SortCommand}" CommandParameter="{x:Static net:ModelColumn.Status}" />
                <Button Grid.Column="6" Style="{StaticResource ColumnHeader}" Content="CTX"
                        Command="{Binding SortCommand}" CommandParameter="{x:Static net:ModelColumn.Context}" />
                <Button Grid.Column="7" Style="{StaticResource ColumnHeader}" Content="CONTENTS"
                        Command="{Binding SortCommand}" CommandParameter="{x:Static net:ModelColumn.Contents}" />
                <Button Grid.Column="8" Style="{StaticResource ColumnHeader}" Content="VERIFIED"
                        IsEnabled="False" ToolTip="The last time the mesh saw a source holding part of this model." />
            </Grid>
        </Border>

        <Grid>
            <ListBox ItemsSource="{Binding VisibleRows}"
                     SelectedItem="{Binding SelectedRow}"
                     ItemContainerStyle="{StaticResource TableRow}"
                     Background="Transparent"
                     BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <!-- The same widths as the headings above, or the two disagree. -->
                                <ColumnDefinition Width="240" />
                                <ColumnDefinition Width="96" />
                                <ColumnDefinition Width="112" />
                                <ColumnDefinition Width="76" />
                                <ColumnDefinition Width="76" />
                                <ColumnDefinition Width="104" />
                                <ColumnDefinition Width="112" />
                                <ColumnDefinition Width="*" MinWidth="220" />
                                <ColumnDefinition Width="88" />
                            </Grid.ColumnDefinitions>

                            <!-- Name, quantization, and a lock when it is listed but invite gated. -->
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,0,10,0">
                                <TextBlock Style="{StaticResource MonoText}"
                                           FontSize="{StaticResource Font.Size.Normal}"
                                           Text="&#xE72E;"
                                           FontFamily="{StaticResource Font.Icons}"
                                           Margin="0,0,6,0"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource Text.Muted.Brush}"
                                           ToolTip="In a private mesh, so reachable only with an invite."
                                           Visibility="{Binding IsInviteOnly, Converter={StaticResource BooleanToVisibility}}" />

                                <TextBlock Style="{StaticResource MonoText}"
                                           FontSize="{StaticResource Font.Size.Normal}"
                                           Text="{Binding Name}"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding ModelId}" />

                                <Border Style="{StaticResource Tag}" Margin="8,0,0,0">
                                    <TextBlock Style="{StaticResource TagText}" Text="{Binding Quantisation}" />
                                </Border>
                            </StackPanel>

                            <TextBlock Grid.Column="1"
                                       Style="{StaticResource MonoText}"
                                       Margin="0,0,14,0"
                                       Foreground="{DynamicResource Text.Muted.Brush}"
                                       Text="{Binding SizeText}"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" />

                            <!-- One segment per section of the pipeline. -->
                            <Grid Grid.Column="2" Margin="0,0,10,0">
                                <ItemsControl ItemsSource="{Binding Sections}"
                                              ItemTemplate="{StaticResource CoverageSegment}"
                                              VerticalAlignment="Center">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>

                                <Border Height="9"
                                        Width="72"
                                        HorizontalAlignment="Left"
                                        CornerRadius="1"
                                        VerticalAlignment="Center"
                                        Background="{DynamicResource Surface.Track.Brush}"
                                        ToolTip="The mesh has not reported how this model is assembled yet."
                                        Visibility="{Binding HasSections, Converter={StaticResource BooleanToVisibility}, ConverterParameter=Invert}" />
                            </Grid>

                            <TextBlock Grid.Column="3"
                                       Style="{StaticResource MonoText}"
                                       Margin="0,0,14,0"
                                       Text="{Binding SourceCount}"
                                       VerticalAlignment="Center" />

                            <TextBlock Grid.Column="4"
                                       Style="{StaticResource MonoText}"
                                       Margin="0,0,14,0"
                                       Text="{Binding SpareCount}"
                                       VerticalAlignment="Center"
                                       Foreground="{Binding Strength, Converter={StaticResource ResourceLookup}, ConverterParameter=SectionCoverage}" />

                            <StackPanel Grid.Column="5" Orientation="Horizontal" Margin="0,0,14,0" VerticalAlignment="Center">
                                <Ellipse Style="{StaticResource StateDot}"
                                         Width="6" Height="6"
                                         Margin="0,0,6,0"
                                         Fill="{Binding Availability, Converter={StaticResource ResourceLookup}, ConverterParameter=ModelAvailability}" />
                                <TextBlock Text="{Binding StatusText}"
                                           FontSize="{StaticResource Font.Size.Small}"
                                           Foreground="{Binding Availability, Converter={StaticResource ResourceLookup}, ConverterParameter=ModelAvailability}" />
                            </StackPanel>

                            <TextBlock Grid.Column="6"
                                       Style="{StaticResource MonoText}"
                                       Margin="0,0,14,0"
                                       Text="{Binding ContextText}"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" />

                            <TextBlock Grid.Column="7"
                                       Style="{StaticResource MonoText}"
                                       Margin="0,0,14,0"
                                       Text="{Binding ContentsText}"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding ContentsText}" />


                            <TextBlock Grid.Column="8"
                                       Style="{StaticResource MonoText}"
                                       Margin="0,0,14,0"
                                       Foreground="{DynamicResource Text.Muted.Brush}"
                                       Text="{Binding LastVerifiedText}"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <TextBlock HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Margin="24"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       IsHitTestVisible="False"
                       Foreground="{DynamicResource Text.Muted.Brush}"
                       Text="{Binding Mesh.EmptyModelsText}"
                       Visibility="{Binding VisibleRows.Count, Converter={StaticResource CountToVisibility}, ConverterParameter=Invert}" />
        </Grid>
            </DockPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
