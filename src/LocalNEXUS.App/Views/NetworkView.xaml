<UserControl x:Class="LocalNEXUS.App.Views.NetworkView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:net="clr-namespace:LocalNEXUS.App.ViewModels.Network"
             xmlns:distributed="clr-namespace:LocalNEXUS.App.Services.Distributed"
             xmlns:behaviors="clr-namespace:LocalNEXUS.App.Infrastructure.Behaviors"
             xmlns:vm="clr-namespace:LocalNEXUS.App.ViewModels"
             d:DataContext="{d:DesignInstance Type=vm:NetworkViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Background="{DynamicResource Surface.Window.Brush}">

    <!--
        The Network tab.

        Two states rather than one. With the node off there is nothing to watch, so the middle is a
        start screen that says what a mesh is and offers the three things somebody can do. With it
        on, the middle is what the mesh holds: models first, because they are the reason the tab
        exists, and the meshes themselves as one grouped list under them.

        Host settings are not on this screen. They are a form somebody edits rarely and applies,
        and they used to be the permanent middle of the left rail, which put a memory policy and a
        restart warning in front of anybody who came to look at a model. They open over the tab
        from the header instead.

        Opaque on purpose. This sits over the canvas, and with a see through theme the graph's text
        was legible through the table.
    -->

    <UserControl.Resources>

        <!-- One segment per section, coloured by that section's own coverage. -->
        <DataTemplate x:Key="CoverageSegment">
            <Border Width="14"
                    Height="9"
                    Margin="0,0,2,0"
                    CornerRadius="1"
                    ToolTip="{Binding StatusDetail}"
                    Background="{Binding Coverage, Converter={StaticResource ResourceLookup}, ConverterParameter=SectionCoverage}" />
        </DataTemplate>

        <!--
            One row of the mesh list, whichever kind of mesh it is. A template selector by type
            would be three templates saying the same thing, so the row reads the shared shape and
            each kind fills it in.
        -->
        <DataTemplate x:Key="MeshRow">
            <Border Padding="34,6,16,6" Background="Transparent">
                <DockPanel>
                    <Button DockPanel.Dock="Right"
                            Style="{StaticResource LinkButton}"
                            Margin="10,0,0,0"
                            VerticalAlignment="Center"
                            Content="{Binding RowActionText}"
                            Command="{Binding DataContext.MeshRowActionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}"
                            Visibility="{Binding HasRowAction, Converter={StaticResource BooleanToVisibility}}" />

                    <TextBlock DockPanel.Dock="Right"
                               Style="{StaticResource MonoText}"
                               Margin="10,0,0,0"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource Text.Muted.Brush}"
                               Text="{Binding RowDetail}" />

                    <Ellipse Style="{StaticResource StateDot}"
                             Width="6" Height="6"
                             Margin="0,0,8,0"
                             VerticalAlignment="Center"
                             Fill="{Binding RowStateBrushKey, Converter={StaticResource BrushKey}}" />

                    <TextBlock Text="{Binding RowTitle}"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                </DockPanel>
            </Border>
        </DataTemplate>

    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--
            The one place node and membership state is said. It was here, in the inspector, in a
            table column and twice in the status bar, so none of the five read as the important one.
        -->
        <Border Grid.Row="0"
                Background="{DynamicResource Surface.Panel.Brush}"
                BorderBrush="{DynamicResource Surface.Border.Brush}"
                BorderThickness="0,0,0,1"
                Padding="16,10">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Style="{StaticResource SmallButton}"
                            MinWidth="104"
                            VerticalAlignment="Center"
                            Content="{Binding StartButtonText}"
                            Command="{Binding ToggleMeshCommand}" />

                    <Button Style="{StaticResource SmallButton}"
                            Margin="8,0,0,0"
                            VerticalAlignment="Center"
                            Content="Host settings"
                            ToolTip="Mesh name, publishing, what this machine offers, and the invite."
                            Command="{Binding OpenHostSettingsCommand}" />
                </StackPanel>

                <Ellipse Style="{StaticResource StateDot}"
                         Margin="0,0,9,0"
                         VerticalAlignment="Center"
                         Fill="{Binding Mesh.State, Converter={StaticResource ResourceLookup}, ConverterParameter=MeshNodeState}" />

                <TextBlock VerticalAlignment="Center"
                           FontWeight="SemiBold"
                           Text="{Binding Mesh.StatusText}" />

                <TextBlock Style="{StaticResource MutedText}"
                           Margin="10,0,0,0"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           Text="{Binding MembershipText}" />
            </DockPanel>
        </Border>

        <!--
            The toolbar, which replaced four filter groups in the rail. A search box and one status,
            because status is the only one anybody reaches for and the other three inferred their
            answers from what the mesh reports.
        -->
        <Border Grid.Row="1"
                Background="{DynamicResource Surface.Window.Brush}"
                BorderBrush="{DynamicResource Surface.Border.Brush}"
                BorderThickness="0,0,0,1"
                Padding="16,8"
                Visibility="{Binding IsNodeOn, Converter={StaticResource BooleanToVisibility}}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Style="{StaticResource SmallButton}"
                            VerticalAlignment="Center"
                            Content="Join with an invite"
                            Command="{Binding JoinWithInviteCommand}" />

                    <Button Style="{StaticResource SmallButton}"
                            Margin="8,0,0,0"
                            MinWidth="104"
                            VerticalAlignment="Center"
                            Content="{Binding FindMeshesText}"
                            ToolTip="Asks the public directory which meshes are out there. Nothing about this machine is published by asking."
                            Command="{Binding FindMeshesCommand}" />
                </StackPanel>

                <ComboBox DockPanel.Dock="Right"
                          Width="150"
                          Margin="10,0,0,0"
                          VerticalAlignment="Center"
                          ItemsSource="{Binding StatusFilters}"
                          SelectedItem="{Binding StatusFilter}"
                          AutomationProperties.Name="Filter by status" />

                <TextBox Width="220"
                         HorizontalAlignment="Left"
                         VerticalAlignment="Center"
                         behaviors:TextBoxHelper.Placeholder="Search models"
                         Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.Name="Search models" />
            </DockPanel>
        </Border>

        <!--
            The start screen. The node is off by default and this tab is optional, so this is what
            most people see first, and it is the one place the three shaping facts are said.
        -->
        <Border Grid.Row="2"
                Background="{DynamicResource Surface.Window.Brush}"
                Padding="16"
                Visibility="{Binding IsNodeOff, Converter={StaticResource BooleanToVisibility}}">
            <StackPanel MaxWidth="560"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <DockPanel>
                    <Button DockPanel.Dock="Right"
                            Style="{StaticResource PrimaryButton}"
                            Margin="16,0,0,0"
                            VerticalAlignment="Center"
                            Content="Turn on"
                            Command="{Binding ToggleMeshCommand}" />

                    <TextBlock FontSize="{StaticResource Font.Size.Large}"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center"
                               Text="Node is off. Everything runs locally." />
                </DockPanel>

                <TextBlock Style="{StaticResource HintText}"
                           Margin="0,12,0,0"
                           TextWrapping="Wrap"
                           Text="A mesh pools GPUs across machines to run a model none could run alone. It is optional, and it is slower, not faster." />

                <StackPanel Orientation="Horizontal" Margin="0,22,0,0">
                    <Button Style="{StaticResource SmallButton}"
                            MinWidth="120"
                            Content="Host a mesh"
                            Command="{Binding HostAMeshCommand}" />

                    <Button Style="{StaticResource SmallButton}"
                            Margin="8,0,0,0"
                            MinWidth="140"
                            Content="Join with an invite"
                            Command="{Binding JoinWithInviteCommand}" />

                    <Button Style="{StaticResource SmallButton}"
                            Margin="8,0,0,0"
                            MinWidth="140"
                            Content="Browse public meshes"
                            Command="{Binding FindMeshesCommand}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- The live view: models, then the meshes they come from. -->
        <Grid Grid.Row="2" Visibility="{Binding IsNodeOn, Converter={StaticResource BooleanToVisibility}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="2*" MinHeight="120" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" MinHeight="110" />
            </Grid.RowDefinitions>

            <!--
                Models. Four columns, all of which the mesh actually reports, so nothing needs to
                scroll sideways. Size, context, contents, backups and last verified moved into the
                inspector, where a curious person looks, rather than being a wall of "not reported"
                across every row.
            -->
            <DockPanel Grid.Row="0">
                <Border DockPanel.Dock="Top"
                        Background="{DynamicResource Surface.Window.Brush}"
                        BorderBrush="{DynamicResource Surface.Border.Brush}"
                        BorderThickness="0,0,0,1"
                        Padding="16,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="200" />
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="90" />
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" Style="{StaticResource ColumnHeader}" Content="MODEL"
                                Command="{Binding SortCommand}" CommandParameter="{x:Static net:ModelColumn.Name}" />
                        <Button Grid.Column="1" Style="{StaticResource ColumnHeader}" Content="COVERAGE"
                                ToolTip="The model split into parts. A filled block means a machine is running that part."
                                Command="{Binding SortCommand}" CommandParameter="{x:Static net:ModelColumn.Coverage}" />
                        <Button Grid.Column="2" Style="{StaticResource ColumnHeader}" Content="STATUS"
                                Command="{Binding SortCommand}" CommandParameter="{x:Static net:ModelColumn.Status}" />
                        <Button Grid.Column="3" Style="{StaticResource ColumnHeader}" Content="MACHINES"
                                Command="{Binding SortCommand}" CommandParameter="{x:Static net:ModelColumn.Sources}" />
                    </Grid>
                </Border>

                <Grid>
                    <ListBox ItemsSource="{Binding VisibleRows}"
                             SelectedItem="{Binding SelectedRow}"
                             ItemContainerStyle="{StaticResource TableRow}"
                             Background="Transparent"
                             BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" MinWidth="200" />
                                        <ColumnDefinition Width="140" />
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="90" />
                                    </Grid.ColumnDefinitions>

                                    <!--
                                        The name as a person would recognise it. The mesh names a
                                        local model by the hash of its file, so where the node says
                                        which file it was asked for, that is what is shown, and the
                                        full id is on the tool tip either way.
                                    -->
                                    <TextBlock Grid.Column="0"
                                               Style="{StaticResource MonoText}"
                                               Margin="0,0,14,0"
                                               FontSize="{StaticResource Font.Size.Normal}"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               Text="{Binding Name}"
                                               ToolTip="{Binding ModelId}" />

                                    <Grid Grid.Column="1" Margin="0,0,14,0">
                                        <ItemsControl ItemsSource="{Binding Sections}"
                                                      ItemTemplate="{StaticResource CoverageSegment}"
                                                      VerticalAlignment="Center">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                        </ItemsControl>

                                        <Border Height="9"
                                                Width="72"
                                                HorizontalAlignment="Left"
                                                CornerRadius="1"
                                                VerticalAlignment="Center"
                                                Background="{DynamicResource Surface.Track.Brush}"
                                                ToolTip="The mesh has not reported how this model is assembled yet."
                                                Visibility="{Binding HasSections, Converter={StaticResource BooleanToVisibility}, ConverterParameter=Invert}" />
                                    </Grid>

                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="0,0,14,0" VerticalAlignment="Center">
                                        <Ellipse Style="{StaticResource StateDot}"
                                                 Width="6" Height="6"
                                                 Margin="0,0,6,0"
                                                 Fill="{Binding Availability, Converter={StaticResource ResourceLookup}, ConverterParameter=ModelAvailability}" />
                                        <TextBlock Text="{Binding StatusText}"
                                                   FontSize="{StaticResource Font.Size.Small}"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{Binding Availability, Converter={StaticResource ResourceLookup}, ConverterParameter=ModelAvailability}" />
                                    </StackPanel>

                                    <TextBlock Grid.Column="3"
                                               Style="{StaticResource MonoText}"
                                               VerticalAlignment="Center"
                                               Text="{Binding SourceCount}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Margin="24"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               IsHitTestVisible="False"
                               Foreground="{DynamicResource Text.Muted.Brush}"
                               Text="{Binding Mesh.EmptyModelsText}"
                               Visibility="{Binding VisibleRows.Count, Converter={StaticResource CountToVisibility}, ConverterParameter=Invert}" />
                </Grid>
            </DockPanel>

            <GridSplitter Grid.Row="1"
                          Height="5"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Center"
                          ResizeBehavior="PreviousAndNext"
                          ResizeDirection="Rows"
                          AutomationProperties.Name="Resize the meshes list" />

            <!--
                The meshes, as one grouped list. Yours, joined and found were a one row table,
                another table, and rows mixed into the model table. They are the same kind of thing
                at three distances, so they are three groups of one list and the model table is
                left to models.
            -->
            <DockPanel Grid.Row="2" Background="{DynamicResource Surface.Window.Brush}">
                <Border DockPanel.Dock="Top"
                        BorderBrush="{DynamicResource Surface.Border.Brush}"
                        BorderThickness="0,1,0,1"
                        Padding="16,7">
                    <TextBlock Text="Meshes" FontWeight="SemiBold" />
                </Border>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding MeshGroups}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type net:MeshGroup}">
                                <StackPanel>
                                    <!-- The heading is the control that opens the group. -->
                                    <Button Style="{StaticResource GroupHeader}"
                                            Command="{Binding ToggleCommand}">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right"
                                                       Style="{StaticResource MonoText}"
                                                       VerticalAlignment="Center"
                                                       Foreground="{DynamicResource Text.Muted.Brush}"
                                                       Text="{Binding Count}" />

                                            <TextBlock FontFamily="{StaticResource Font.Icons}"
                                                       FontSize="10"
                                                       Margin="0,0,8,0"
                                                       VerticalAlignment="Center"
                                                       Foreground="{DynamicResource Text.Muted.Brush}"
                                                       Text="{Binding Chevron}" />

                                            <TextBlock Text="{Binding Title}" VerticalAlignment="Center" />
                                        </DockPanel>
                                    </Button>

                                    <StackPanel Visibility="{Binding IsExpanded, Converter={StaticResource BooleanToVisibility}}">
                                        <TextBlock Style="{StaticResource HintText}"
                                                   Margin="34,2,16,8"
                                                   TextWrapping="Wrap"
                                                   Text="{Binding EmptyText}"
                                                   Visibility="{Binding IsEmpty, Converter={StaticResource BooleanToVisibility}}" />

                                        <ItemsControl ItemsSource="{Binding Items}"
                                                      ItemTemplate="{StaticResource MeshRow}" />
                                    </StackPanel>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Grid>

        <!--
            Host settings, over the tab rather than in it. A form that is edited rarely and applied,
            and which was the permanent middle of the left rail.
        -->
        <Grid Grid.RowSpan="3"
              Visibility="{Binding IsHostSettingsOpen, Converter={StaticResource BooleanToVisibility}}">
            <Border Background="{DynamicResource Surface.Scrim.Brush}">
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick" Command="{Binding CloseHostSettingsCommand}" />
                </Border.InputBindings>
            </Border>

            <Border Width="380"
                    HorizontalAlignment="Right"
                    Background="{DynamicResource Surface.Panel.Brush}"
                    BorderBrush="{DynamicResource Surface.Border.Brush}"
                    BorderThickness="1,0,0,0">
                <DockPanel>
                    <Border DockPanel.Dock="Top"
                            BorderBrush="{DynamicResource Surface.Border.Brush}"
                            BorderThickness="0,0,0,1"
                            Padding="16,12">
                        <DockPanel>
                            <Button DockPanel.Dock="Right"
                                    Style="{StaticResource IconButton}"
                                    Content="&#xE711;"
                                    ToolTip="Close"
                                    AutomationProperties.Name="Close host settings"
                                    Command="{Binding CloseHostSettingsCommand}" />

                            <TextBlock Text="Host settings" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </DockPanel>
                    </Border>

                    <!-- Applying is the point of the panel, so it is pinned rather than scrolled to. -->
                    <Border DockPanel.Dock="Bottom"
                            BorderBrush="{DynamicResource Surface.Border.Brush}"
                            BorderThickness="0,1,0,0"
                            Padding="16,12">
                        <StackPanel>
                            <Button Style="{StaticResource PrimaryButton}"
                                    HorizontalAlignment="Left"
                                    Content="{Binding ApplyButtonText}"
                                    Command="{Binding ApplySettingsCommand}" />

                            <TextBlock Style="{StaticResource HintText}"
                                       Margin="0,6,0,0"
                                       Text="Changes apply on restart." />

                            <TextBlock Style="{StaticResource HintText}"
                                       Margin="0,4,0,0"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource Text.Primary.Brush}"
                                       Text="{Binding Notice}"
                                       Visibility="{Binding HasNotice, Converter={StaticResource BooleanToVisibility}}" />
                        </StackPanel>
                    </Border>

                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16,14">
                        <StackPanel>
                            <TextBlock Style="{StaticResource FieldLabel}" Margin="0,0,0,2" Text="Mesh name" />
                            <TextBox Text="{Binding MeshName, UpdateSourceTrigger=LostFocus}"
                                     behaviors:TextBoxHelper.Placeholder="A name for the mesh you host" />

                            <!-- Only when it is actually true, which is the only time it explains anything. -->
                            <TextBlock Style="{StaticResource HintText}"
                                       Margin="0,4,0,0"
                                       TextWrapping="Wrap"
                                       Text="Ignored while you are joined to someone else's."
                                       Visibility="{Binding HasJoined, Converter={StaticResource BooleanToVisibility}}" />

                            <CheckBox Style="{StaticResource ToggleSwitch}"
                                      Margin="0,16,0,0"
                                      Content="Publish this mesh publicly"
                                      IsChecked="{Binding Publish}" />
                            <TextBlock Style="{StaticResource HintText}"
                                       Margin="0,4,0,0"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource Status.Warning.Brush}"
                                       Text="Off: only this network can find it. On: listed publicly, but joining still needs the invite." />

                            <CheckBox Style="{StaticResource ToggleSwitch}"
                                      Margin="0,16,0,0"
                                      Content="Offer this machine"
                                      IsChecked="{Binding Contribute}" />

                            <TextBlock Style="{StaticResource FieldLabel}" Text="Memory" />
                            <Grid Visibility="{Binding HasMemoryReading, Converter={StaticResource BooleanToVisibility}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Slider Grid.Column="0"
                                        VerticalAlignment="Center"
                                        Minimum="0"
                                        Maximum="{Binding MemoryMaximumGb}"
                                        Value="{Binding MemoryShareGb}"
                                        Ticks="{Binding MemoryTicks}"
                                        IsSnapToTickEnabled="False"
                                        AutomationProperties.Name="Memory to share" />

                                <TextBlock Grid.Column="1"
                                           Style="{StaticResource MonoText}"
                                           Margin="10,0,0,0"
                                           VerticalAlignment="Center"
                                           Text="{Binding MemoryShareLabel}" />
                            </Grid>

                            <DockPanel Margin="0,4,0,0">
                                <!-- The policy behind the number, on demand rather than as a paragraph. -->
                                <TextBlock DockPanel.Dock="Right"
                                           FontFamily="{StaticResource Font.Icons}"
                                           FontSize="12"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource Text.Muted.Brush}"
                                           Text="&#xE946;"
                                           ToolTip="{Binding MemorySummary}" />

                                <CheckBox Content="Share all of it"
                                          IsChecked="{Binding OfferAllMemory}"
                                          Visibility="{Binding HasMemoryReading, Converter={StaticResource BooleanToVisibility}}" />
                            </DockPanel>

                            <TextBlock Style="{StaticResource FieldLabel}" Text="Models" />
                            <TextBlock Style="{StaticResource HintText}"
                                       Margin="0,0,0,4"
                                       TextWrapping="Wrap"
                                       Text="Nothing is shared until you tick one."
                                       Visibility="{Binding IsOfferingNothing, Converter={StaticResource BooleanToVisibility}}" />

                            <ItemsControl ItemsSource="{Binding OfferedModels}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <!--
                                            A model the mesh cannot serve is shown and disabled
                                            rather than hidden. Hiding it would leave somebody
                                            looking for a model they know is on the machine with
                                            no explanation for its absence.
                                        -->
                                        <CheckBox Margin="0,3"
                                                  IsChecked="{Binding IsOffered}"
                                                  IsEnabled="{Binding IsOfferable}"
                                                  ToolTip="{Binding OfferRefusal}"
                                                  AutomationProperties.Name="{Binding Name}">
                                            <StackPanel Margin="2,0,0,0">
                                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                    <TextBlock Style="{StaticResource MonoText}"
                                                               Foreground="{DynamicResource Text.Muted.Brush}"
                                                               Text="{Binding Quantisation}" />
                                                    <TextBlock Style="{StaticResource MonoText}"
                                                               Margin="8,0,0,0"
                                                               Foreground="{DynamicResource Text.Muted.Brush}"
                                                               Text="{Binding SizeLabel}" />
                                                </StackPanel>
                                                <TextBlock Style="{StaticResource HintText}"
                                                           Margin="0,2,0,0"
                                                           TextWrapping="Wrap"
                                                           Text="{Binding OfferRefusal}"
                                                           Visibility="{Binding IsOfferable, Converter={StaticResource BooleanToVisibility}, ConverterParameter=Invert}" />
                                            </StackPanel>
                                        </CheckBox>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Style="{StaticResource HintText}"
                                       Margin="0,4,0,0"
                                       TextWrapping="Wrap"
                                       Text="No models found on this machine. Add a folder in Settings, Models."
                                       Visibility="{Binding OfferedModels.Count, Converter={StaticResource CountToVisibility}, ConverterParameter=Invert}" />

                            <TextBlock Style="{StaticResource FieldLabel}" Text="Port" />
                            <TextBox Text="{Binding ApiPort, UpdateSourceTrigger=LostFocus}" MaxWidth="120" HorizontalAlignment="Left" />

                            <TextBlock Style="{StaticResource FieldLabel}" Text="Invite" />
                            <TextBox Style="{StaticResource MonoTextBox}"
                                     Text="{Binding InviteToken, Mode=OneWay}"
                                     IsReadOnly="True"
                                     MaxHeight="70"
                                     TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"
                                     Visibility="{Binding Mesh.HasInviteToken, Converter={StaticResource BooleanToVisibility}}" />

                            <TextBlock Style="{StaticResource HintText}"
                                       Text="Start the node to get one."
                                       Visibility="{Binding Mesh.HasInviteToken, Converter={StaticResource BooleanToVisibility}, ConverterParameter=Invert}" />

                            <StackPanel Orientation="Horizontal"
                                        Margin="0,8,0,0"
                                        Visibility="{Binding Mesh.HasInviteToken, Converter={StaticResource BooleanToVisibility}}">
                                <Button Style="{StaticResource SmallButton}" Content="Copy" Command="{Binding CopyInviteCommand}" />
                                <Button Style="{StaticResource SmallButton}"
                                        Margin="8,0,0,0"
                                        Content="New"
                                        ToolTip="Rotates this node's key, which makes every invite handed out so far stop working."
                                        Command="{Binding RegenerateInviteCommand}" />
                            </StackPanel>

                            <!-- Joining lives here too, since it is the other half of membership. -->
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Join another mesh" />
                            <TextBox Text="{Binding TypedToken, UpdateSourceTrigger=PropertyChanged}"
                                     FontFamily="{StaticResource Font.Mono}"
                                     behaviors:TextBoxHelper.Placeholder="Paste invite token" />
                            <Button Style="{StaticResource SmallButton}"
                                    Margin="0,8,0,14"
                                    HorizontalAlignment="Left"
                                    Content="Join it"
                                    Command="{Binding JoinMeshCommand}" />
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
        <!--
            Distributed inference: splitting one safetensors model across machines of your own.
            Its own row rather than a corner of the host settings, because it is not part of the
            mesh and does not care whether the node is on. It was in that slide over first, where
            it was invisible unless somebody opened a panel about a different feature.
        -->
        <Border Grid.Row="3"
                Background="{DynamicResource Surface.Panel.Brush}"
                BorderBrush="{DynamicResource Surface.Border.Brush}"
                BorderThickness="0,1,0,0"
                Padding="16,12">
            <Expander IsExpanded="{Binding DistributedEnabled, Mode=OneWay}">
                <Expander.Header>
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right"
                                   Style="{StaticResource HintText}"
                                   Margin="12,0,0,0"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   Text="{Binding DistributedSummary}" />

                        <TextBlock Text="Distributed inference" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </DockPanel>
                </Expander.Header>

                <StackPanel Margin="0,10,0,0" MaxWidth="620" HorizontalAlignment="Left">
                    <TextBlock Style="{StaticResource HintText}"
                               Margin="0,0,0,6"
                               TextWrapping="Wrap"
                               Text="For a safetensors model too large for this machine. Its layers are split across the machines listed below, each running the distributed peer from a command line." />

                    <CheckBox Content="Split large safetensors models across machines"
                              IsChecked="{Binding DistributedEnabled}" />

                    <TextBlock Style="{StaticResource FieldLabel}" Text="Shared secret" />
                    <TextBlock Style="{StaticResource HintText}"
                               Margin="0,0,0,4"
                               TextWrapping="Wrap"
                               Text="The same value on every machine. A peer refuses to listen on an address the network can reach without one. Leave blank only when every machine is this one." />
                    <TextBox Style="{StaticResource MonoTextBox}"
                             Text="{Binding DistributedSecret, UpdateSourceTrigger=LostFocus}" />

                    <TextBlock Style="{StaticResource FieldLabel}" Text="Machines" />

                    <ItemsControl ItemsSource="{Binding DistributedPeers}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,2">
                                    <Button DockPanel.Dock="Right"
                                            Style="{StaticResource SmallButton}"
                                            Margin="6,0,0,0"
                                            Content="Remove"
                                            ToolTip="Takes it off the list. Nothing on that machine is stopped."
                                            Command="{Binding DataContext.RemoveDistributedPeerCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" />

                                    <TextBlock Style="{StaticResource MonoText}"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               Text="{Binding Address}" />
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <DockPanel Margin="0,6,0,0">
                        <Button DockPanel.Dock="Right"
                                Style="{StaticResource SmallButton}"
                                Margin="6,0,0,0"
                                Content="Add"
                                IsEnabled="{Binding CanAddDistributedPeer}"
                                Command="{Binding AddDistributedPeerCommand}" />

                        <TextBox Style="{StaticResource MonoTextBox}"
                                 Text="{Binding TypedPeer, UpdateSourceTrigger=PropertyChanged}"
                                 behaviors:TextBoxHelper.Placeholder="192.168.1.20:8749" />
                    </DockPanel>
                </StackPanel>
            </Expander>
        </Border>

    </Grid>
</UserControl>
