<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Deep slate. Cool and very dark, with a bright blue accent. -->

    <Color x:Key="Surface.WindowColor">#FF0D1117</Color>
    <Color x:Key="Surface.PanelColor">#FF161B22</Color>
    <Color x:Key="Surface.CardColor">#FF1C2128</Color>
    <Color x:Key="Surface.InputColor">#FF0D1117</Color>
    <Color x:Key="Surface.BorderColor">#FF30363D</Color>
    <Color x:Key="Surface.ChromeColor">#FF010409</Color>
    <Color x:Key="Surface.HoverColor">#FF1F242C</Color>
    <Color x:Key="Surface.SelectedColor">#FF163356</Color>
    <Color x:Key="Surface.TrackColor">#FF272D36</Color>
    <Color x:Key="Surface.ScrimColor">#B2000000</Color>

    <Color x:Key="Text.PrimaryColor">#FFE6EDF3</Color>
    <Color x:Key="Text.SecondaryColor">#FF8B949E</Color>
    <Color x:Key="Text.MutedColor">#FF7D8590</Color>
    <Color x:Key="Text.InverseColor">#FF0D1117</Color>

    <Color x:Key="Accent.PrimaryColor">#FF58A6FF</Color>
    <Color x:Key="Accent.NeutralColor">#FF6E7681</Color>

    <Color x:Key="Status.SuccessColor">#FF3FB950</Color>
    <Color x:Key="Status.InfoColor">#FF58A6FF</Color>
    <Color x:Key="Status.DangerColor">#FFF85149</Color>
    <Color x:Key="Status.WarningColor">#FFD29922</Color>

    <Color x:Key="Diff.AddedColor">#FF3FB950</Color>
    <Color x:Key="Diff.RemovedColor">#FFF85149</Color>

    <Color x:Key="NodeType.PromptColor">#FF58A6FF</Color>
    <Color x:Key="NodeType.TriageColor">#FF79C0FF</Color>
    <Color x:Key="NodeType.ModelColor">#FFBC8CFF</Color>
    <Color x:Key="NodeType.ReshapeColor">#FF3FB950</Color>
    <Color x:Key="NodeType.DebateColor">#FFD29922</Color>
    <Color x:Key="NodeType.JudgeColor">#FFA371F7</Color>
    <Color x:Key="NodeType.CompilerCheckColor">#FFFF7B72</Color>
    <Color x:Key="NodeType.OutputColor">#FFD29922</Color>
    <Color x:Key="NodeType.TextOutputColor">#FF7EE787</Color>
    <Color x:Key="NodeType.AgentColor">#FF39C5CF</Color>
    <Color x:Key="NodeType.LoopColor">#FFF778BA</Color>

    <Color x:Key="Pin.TextColor">#FF58A6FF</Color>
    <Color x:Key="Pin.CodeColor">#FFFFA657</Color>

    <!--
        The three stops of the surface gradient, which the window base layer and the canvas take.
        A flat theme sets all three to its window colour, so the gradient brush is painted the same
        way for every theme and nothing has to branch on which one is in force.
    -->
    <Color x:Key="Surface.GradientStartColor">#FF0D1117</Color>
    <Color x:Key="Surface.GradientMidColor">#FF0D1117</Color>
    <Color x:Key="Surface.GradientEndColor">#FF0D1117</Color>

</ResourceDictionary>
