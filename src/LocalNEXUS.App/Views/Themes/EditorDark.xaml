<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        VS Code Dark+. The reference theme: the shell was built to this palette, so anything that
        looks wrong here is wrong in the layout rather than in the colours.

        Every theme defines exactly these keys and nothing else. Brushes.xaml turns them into the
        semantic brushes the rest of the application binds to, which is why a theme never mentions
        a node state, a coverage level or a control.
    -->

    <Color x:Key="Surface.WindowColor">#FF1E1E1E</Color>
    <Color x:Key="Surface.PanelColor">#FF252526</Color>
    <Color x:Key="Surface.CardColor">#FF2D2D30</Color>
    <Color x:Key="Surface.InputColor">#FF3C3C3C</Color>
    <Color x:Key="Surface.BorderColor">#FF3E3E42</Color>
    <Color x:Key="Surface.ChromeColor">#FF323233</Color>
    <Color x:Key="Surface.HoverColor">#FF2A2D2E</Color>
    <Color x:Key="Surface.SelectedColor">#FF04395E</Color>
    <Color x:Key="Surface.TrackColor">#FF3A3A3C</Color>
    <Color x:Key="Surface.ScrimColor">#B2000000</Color>

    <Color x:Key="Text.PrimaryColor">#FFD4D4D4</Color>
    <Color x:Key="Text.SecondaryColor">#FFA6A6A6</Color>
    <Color x:Key="Text.MutedColor">#FF858585</Color>
    <Color x:Key="Text.InverseColor">#FFFFFFFF</Color>

    <Color x:Key="Accent.PrimaryColor">#FF007ACC</Color>
    <Color x:Key="Accent.NeutralColor">#FF6E6E6E</Color>

    <Color x:Key="Status.SuccessColor">#FF4EC9B0</Color>
    <Color x:Key="Status.InfoColor">#FF569CD6</Color>
    <Color x:Key="Status.DangerColor">#FFF48771</Color>
    <Color x:Key="Status.WarningColor">#FFDCDCAA</Color>

    <Color x:Key="Diff.AddedColor">#FF4EC9B0</Color>
    <Color x:Key="Diff.RemovedColor">#FFF48771</Color>

    <Color x:Key="NodeType.PromptColor">#FF569CD6</Color>
    <Color x:Key="NodeType.TriageColor">#FF4FC1FF</Color>
    <Color x:Key="NodeType.ModelColor">#FFC586C0</Color>
    <Color x:Key="NodeType.ReshapeColor">#FF4EC9B0</Color>
    <Color x:Key="NodeType.DebateColor">#FFCE9178</Color>
    <Color x:Key="NodeType.JudgeColor">#FFB5CEA8</Color>
    <Color x:Key="NodeType.CompilerCheckColor">#FFD16D9E</Color>
    <Color x:Key="NodeType.OutputColor">#FFDCDCAA</Color>
    <Color x:Key="NodeType.TextOutputColor">#FFB5CEA8</Color>
    <Color x:Key="NodeType.AgentColor">#FF4EC9B0</Color>
    <Color x:Key="NodeType.LoopColor">#FFC586C0</Color>

    <Color x:Key="Pin.TextColor">#FF569CD6</Color>
    <Color x:Key="Pin.CodeColor">#FFCE9178</Color>

    <!--
        The three stops of the surface gradient, which the window base layer and the canvas take.
        A flat theme sets all three to its window colour, so the gradient brush is painted the same
        way for every theme and nothing has to branch on which one is in force.
    -->
    <Color x:Key="Surface.GradientStartColor">#FF1E1E1E</Color>
    <Color x:Key="Surface.GradientMidColor">#FF1E1E1E</Color>
    <Color x:Key="Surface.GradientEndColor">#FF1E1E1E</Color>

</ResourceDictionary>
