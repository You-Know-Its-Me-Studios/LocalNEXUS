<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Near black, with a violet accent. The highest contrast of the dark themes. -->

    <Color x:Key="Surface.WindowColor">#FF0B0B0D</Color>
    <Color x:Key="Surface.PanelColor">#FF131316</Color>
    <Color x:Key="Surface.CardColor">#FF1A1A1F</Color>
    <Color x:Key="Surface.InputColor">#FF0F0F12</Color>
    <Color x:Key="Surface.BorderColor">#FF27272A</Color>
    <Color x:Key="Surface.ChromeColor">#FF09090B</Color>
    <Color x:Key="Surface.HoverColor">#FF1C1C21</Color>
    <Color x:Key="Surface.SelectedColor">#FF2A1F5C</Color>
    <Color x:Key="Surface.TrackColor">#FF232328</Color>
    <Color x:Key="Surface.ScrimColor">#B2000000</Color>

    <Color x:Key="Text.PrimaryColor">#FFE4E4E7</Color>
    <Color x:Key="Text.SecondaryColor">#FFA1A1AA</Color>
    <Color x:Key="Text.MutedColor">#FF71717A</Color>
    <Color x:Key="Text.InverseColor">#FFFFFFFF</Color>

    <Color x:Key="Accent.PrimaryColor">#FF7C5CFF</Color>
    <Color x:Key="Accent.NeutralColor">#FF52525B</Color>

    <Color x:Key="Status.SuccessColor">#FF4ADE80</Color>
    <Color x:Key="Status.InfoColor">#FF7C5CFF</Color>
    <Color x:Key="Status.DangerColor">#FFFF5C5C</Color>
    <Color x:Key="Status.WarningColor">#FFFBBF24</Color>

    <Color x:Key="Diff.AddedColor">#FF4ADE80</Color>
    <Color x:Key="Diff.RemovedColor">#FFFF5C5C</Color>

    <Color x:Key="NodeType.PromptColor">#FF60A5FA</Color>
    <Color x:Key="NodeType.TriageColor">#FF22D3EE</Color>
    <Color x:Key="NodeType.ModelColor">#FF7C5CFF</Color>
    <Color x:Key="NodeType.ReshapeColor">#FF4ADE80</Color>
    <Color x:Key="NodeType.DebateColor">#FFFBBF24</Color>
    <Color x:Key="NodeType.JudgeColor">#FF22D3EE</Color>
    <Color x:Key="NodeType.CompilerCheckColor">#FFF472B6</Color>
    <Color x:Key="NodeType.OutputColor">#FFFBBF24</Color>
    <Color x:Key="NodeType.TextOutputColor">#FF86EFAC</Color>
    <Color x:Key="NodeType.AgentColor">#FF2DD4BF</Color>

    <Color x:Key="Pin.TextColor">#FF60A5FA</Color>
    <Color x:Key="Pin.CodeColor">#FFF0ABFC</Color>

    <!--
        The three stops of the surface gradient, which the window base layer and the canvas take.
        A flat theme sets all three to its window colour, so the gradient brush is painted the same
        way for every theme and nothing has to branch on which one is in force.
    -->
    <Color x:Key="Surface.GradientStartColor">#FF0B0B0D</Color>
    <Color x:Key="Surface.GradientMidColor">#FF0B0B0D</Color>
    <Color x:Key="Surface.GradientEndColor">#FF0B0B0D</Color>

</ResourceDictionary>
