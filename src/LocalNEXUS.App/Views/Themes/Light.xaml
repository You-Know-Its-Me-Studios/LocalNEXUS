<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Light. Chosen rather than inverted, because inverting a dark palette is exactly how a light
        theme ends up with an unreadable warning colour.

        Three decisions worth knowing:

        The four status colours are darkened until each clears 4.5:1 against white, because they
        are used as text as well as as dots. Yellow is the one that cannot survive the trip and
        becomes a dark amber; a light theme with a pale yellow warning has a warning nobody reads.

        The canvas is slightly grey and the node body is white, which is the opposite of the dark
        themes. A white node on a white canvas has no edge, and the accent bar alone is not enough
        separation for a graph of a dozen nodes.

        Accent.Neutral is dark enough to read as text rather than only as a dot, because it is what
        a Pending node uses and Pending still has to be legible while being quiet.
    -->

    <Color x:Key="Surface.WindowColor">#FFF8F8F8</Color>
    <Color x:Key="Surface.PanelColor">#FFF3F3F3</Color>
    <Color x:Key="Surface.CardColor">#FFFFFFFF</Color>
    <Color x:Key="Surface.InputColor">#FFFFFFFF</Color>
    <Color x:Key="Surface.BorderColor">#FFD0D0D0</Color>
    <Color x:Key="Surface.ChromeColor">#FFE8E8E8</Color>
    <Color x:Key="Surface.HoverColor">#FFEAEAEA</Color>
    <Color x:Key="Surface.SelectedColor">#FFCCE5FF</Color>
    <Color x:Key="Surface.TrackColor">#FFE1E1E1</Color>
    <Color x:Key="Surface.ScrimColor">#66000000</Color>

    <Color x:Key="Text.PrimaryColor">#FF1F1F1F</Color>
    <Color x:Key="Text.SecondaryColor">#FF4C4C4C</Color>
    <Color x:Key="Text.MutedColor">#FF6E6E6E</Color>
    <Color x:Key="Text.InverseColor">#FFFFFFFF</Color>

    <Color x:Key="Accent.PrimaryColor">#FF0066B8</Color>
    <Color x:Key="Accent.NeutralColor">#FF767676</Color>

    <Color x:Key="Status.SuccessColor">#FF107C41</Color>
    <Color x:Key="Status.InfoColor">#FF0066B8</Color>
    <Color x:Key="Status.DangerColor">#FFC42B1C</Color>
    <Color x:Key="Status.WarningColor">#FF8A5A00</Color>

    <Color x:Key="Diff.AddedColor">#FF107C41</Color>
    <Color x:Key="Diff.RemovedColor">#FFC42B1C</Color>

    <Color x:Key="NodeType.PromptColor">#FF0066B8</Color>
    <Color x:Key="NodeType.TriageColor">#FF0F7285</Color>
    <Color x:Key="NodeType.ModelColor">#FF7719AA</Color>
    <Color x:Key="NodeType.ReshapeColor">#FF107C41</Color>
    <Color x:Key="NodeType.DebateColor">#FFB35C00</Color>
    <Color x:Key="NodeType.JudgeColor">#FF6B21A8</Color>
    <Color x:Key="NodeType.CompilerCheckColor">#FFB5237E</Color>
    <Color x:Key="NodeType.OutputColor">#FF8A5A00</Color>
    <Color x:Key="NodeType.TextOutputColor">#FF1A7F37</Color>
    <Color x:Key="NodeType.AgentColor">#FF0A6E75</Color>

    <Color x:Key="Pin.TextColor">#FF0066B8</Color>
    <Color x:Key="Pin.CodeColor">#FFA1260D</Color>

    <!--
        The three stops of the surface gradient, which the window base layer and the canvas take.
        A flat theme sets all three to its window colour, so the gradient brush is painted the same
        way for every theme and nothing has to branch on which one is in force.
    -->
    <Color x:Key="Surface.GradientStartColor">#FFF8F8F8</Color>
    <Color x:Key="Surface.GradientMidColor">#FFF8F8F8</Color>
    <Color x:Key="Surface.GradientEndColor">#FFF8F8F8</Color>

</ResourceDictionary>
