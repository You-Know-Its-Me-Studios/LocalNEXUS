<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Mystic. The installer's palette, brought into the application so the first thing anyone
        sees and the thing they see afterwards look like one product.

        Every value below that the installer already had is the installer's value, character for
        character, taken from Views\Theme\InstallerTheme.xaml in LocalNEXUS.Installer. Four keys
        have no counterpart there, because the installer is a wizard with no nodes, no selection
        and no scrollbar tracks, and each of those is noted where it appears.

        Two things separate this theme from the other five, and both are declared as capabilities
        rather than inferred from its name: its gradient stops are three different colours, and its
        window base layer may be made translucent.
    -->

    <!-- Surfaces. The installer's, verbatim. -->
    <Color x:Key="Surface.WindowColor">#FF14161F</Color>
    <Color x:Key="Surface.PanelColor">#FF101219</Color>
    <Color x:Key="Surface.CardColor">#FF181A24</Color>
    <Color x:Key="Surface.InputColor">#FF1C1F2B</Color>
    <Color x:Key="Surface.BorderColor">#24FFFFFF</Color>
    <Color x:Key="Surface.ChromeColor">#FF0F111A</Color>
    <Color x:Key="Surface.HoverColor">#12FFFFFF</Color>
    <Color x:Key="Surface.ScrimColor">#B2000000</Color>

    <!-- The installer has nothing selected and no scrollbar tracks, so these two are new. -->
    <Color x:Key="Surface.SelectedColor">#2E7C8BFF</Color>
    <Color x:Key="Surface.TrackColor">#14FFFFFF</Color>

    <!-- Type. The installer's, verbatim. -->
    <Color x:Key="Text.PrimaryColor">#FFEEF0FB</Color>
    <Color x:Key="Text.SecondaryColor">#A6F1F2FB</Color>
    <Color x:Key="Text.MutedColor">#66F1F2FB</Color>
    <Color x:Key="Text.InverseColor">#FFFFFFFF</Color>

    <!--
        Accent. The primary is the installer's. The neutral is new: the installer has no notion of
        a thing that has not happened yet, which is what this colour is always for.
    -->
    <Color x:Key="Accent.PrimaryColor">#FF8A87F7</Color>
    <Color x:Key="Accent.NeutralColor">#FF6E7291</Color>

    <!-- Status. The installer's, verbatim, its error colour being this one's danger. -->
    <Color x:Key="Status.SuccessColor">#FF4ADE80</Color>
    <Color x:Key="Status.InfoColor">#FF5CA4FF</Color>
    <Color x:Key="Status.DangerColor">#FFF87171</Color>
    <Color x:Key="Status.WarningColor">#FFFBBF24</Color>

    <Color x:Key="Diff.AddedColor">#FF4ADE80</Color>
    <Color x:Key="Diff.RemovedColor">#FFF87171</Color>

    <!--
        Node types. New, the installer having no graph. Six hues far enough apart to tell at a
        glance, drawn from the two ends of the installer's accent gradient and its status colours
        so nothing here is a colour the product does not already use somewhere.
    -->
    <Color x:Key="NodeType.PromptColor">#FF5CA4FF</Color>
    <Color x:Key="NodeType.TriageColor">#FF4CC9F0</Color>
    <Color x:Key="NodeType.ModelColor">#FFAE6BF3</Color>
    <Color x:Key="NodeType.ReshapeColor">#FF4ADE80</Color>
    <Color x:Key="NodeType.DebateColor">#FFFF8FA3</Color>
    <Color x:Key="NodeType.JudgeColor">#FF4CC9F0</Color>
    <Color x:Key="NodeType.CompilerCheckColor">#FFF072B6</Color>
    <Color x:Key="NodeType.OutputColor">#FFFBBF24</Color>
    <Color x:Key="NodeType.TextOutputColor">#FF86EFAC</Color>
    <Color x:Key="NodeType.AgentColor">#FF2DD4BF</Color>

    <Color x:Key="Pin.TextColor">#FF5CA4FF</Color>
    <Color x:Key="Pin.CodeColor">#FFE9A178</Color>

    <!--
        The surface gradient, and the only theme where the three stops differ.

        The first two are the installer's backdrop, verbatim. The third is where its violet glow
        sits, resolved to an opaque colour: the installer paints #3357308C over the bottom, and a
        stop here cannot carry that alpha because this brush already sits under a translucency of
        its own and two would compound. So the wash is composited once, at the weight the installer
        uses, against the same bottom colour, and the hue is taken to the magenta end of the accent
        gradient where the eye reads it as a wash rather than as a second blue.
    -->
    <Color x:Key="Surface.GradientStartColor">#FF1A1D2E</Color>
    <Color x:Key="Surface.GradientMidColor">#FF0E1018</Color>
    <Color x:Key="Surface.GradientEndColor">#FF2B203F</Color>

</ResourceDictionary>
