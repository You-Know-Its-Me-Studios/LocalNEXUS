<UserControl x:Class="LocalNEXUS.App.Views.FrontDoorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:LocalNEXUS.App.ViewModels"
             d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <!--
        The first thing the application asks, and the only thing it asks before anything works.

        A graph with no project cannot do anything: nothing is indexed, so there is nothing to plan
        against, nothing to compare a proposed type to, no references to compile against and
        nowhere to write. So there is no dismissal that lands on an empty workspace, because an
        empty workspace does not look empty, it looks broken.

        The recent list is the answer nearly every time, so it is first and needs one click. The
        two pickers are under it, and the way out for somebody who only wants to lend this machine
        to the mesh is last, because it is the rarest.
    -->

    <Border Background="{DynamicResource Surface.Scrim.Brush}"
            Visibility="{Binding FrontDoor.IsOpen, Converter={StaticResource BooleanToVisibility}}">
        <Border Width="560"
                MaxHeight="660"
                VerticalAlignment="Center"
                HorizontalAlignment="Center"
                CornerRadius="6"
                Background="{DynamicResource Surface.Card.Brush}"
                BorderThickness="1"
                BorderBrush="{DynamicResource Surface.Border.Brush}">

            <DockPanel DataContext="{Binding FrontDoor}" Margin="18">

                <StackPanel DockPanel.Dock="Top">
                    <TextBlock FontSize="{StaticResource Font.Size.Title}"
                               FontWeight="SemiBold"
                               Text="What are you working on" />

                    <TextBlock Style="{StaticResource HintText}"
                               Margin="0,4,0,0"
                               TextWrapping="Wrap"
                               Text="A graph works inside a project: it reads what is there, checks what it writes against it, and writes into it. Pick one to start." />

                    <TextBlock Style="{StaticResource HintText}"
                               Margin="0,8,0,0"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource Field.Error.Brush}"
                               Text="{Binding Problem}"
                               Visibility="{Binding Problem, Converter={StaticResource StringToVisibility}}" />
                </StackPanel>

                <!--
                    The two pickers and the way out, under the list rather than beside it, so the
                    list is what the eye lands on.
                -->
                <StackPanel DockPanel.Dock="Bottom" Margin="0,14,0,0">
                    <Button HorizontalContentAlignment="Left"
                            Padding="12,8"
                            Command="{Binding OpenProjectCommand}">
                        <StackPanel>
                            <TextBlock Text="Open a project" FontWeight="SemiBold" />
                            <TextBlock Style="{StaticResource HintText}"
                                       TextWrapping="Wrap"
                                       Text="Choose a folder that already holds a codebase." />
                        </StackPanel>
                    </Button>

                    <Button Margin="0,6,0,0"
                            HorizontalContentAlignment="Left"
                            Padding="12,8"
                            Command="{Binding StartProjectCommand}">
                        <StackPanel>
                            <TextBlock Text="Start a project in a folder" FontWeight="SemiBold" />
                            <TextBlock Style="{StaticResource HintText}"
                                       TextWrapping="Wrap"
                                       Text="Choose an empty folder, or make a new one in the picker. You will be asked what goes where next." />
                        </StackPanel>
                    </Button>

                    <Button Margin="0,10,0,0"
                            HorizontalContentAlignment="Left"
                            Padding="12,8"
                            Command="{Binding ContributeOnlyCommand}">
                        <StackPanel>
                            <TextBlock Text="I am only contributing this machine" FontWeight="SemiBold" />
                            <TextBlock Style="{StaticResource HintText}"
                                       TextWrapping="Wrap"
                                       Text="Lend this machine's GPU to the mesh without opening anything. Goes straight to Network." />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!--
                    What almost every session actually wants.

                    The two commands reach out through the ItemsControl rather than through this
                    UserControl, whose own DataContext is the window's and does not have them: the
                    front door's view model is set on the DockPanel above, so the ItemsControl is
                    the nearest ancestor that has it.
                -->
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top"
                               Style="{StaticResource SectionHeader}"
                               Margin="0,16,0,6"
                               Text="Recent" />

                    <TextBlock DockPanel.Dock="Top"
                               Style="{StaticResource HintText}"
                               TextWrapping="Wrap"
                               Text="Nothing has been opened here yet."
                               Visibility="{Binding IsFirstRun, Converter={StaticResource BooleanToVisibility}}" />

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Recents.Items}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,0,0,6">

                                        <!--
                                            Only on a row that is not there any more, because
                                            forgetting a project somebody still has is not
                                            something to offer beside every one of them.
                                        -->
                                        <Button DockPanel.Dock="Right"
                                                Style="{StaticResource SmallButton}"
                                                Margin="6,0,0,0"
                                                VerticalAlignment="Center"
                                                Content="Remove"
                                                ToolTip="Takes it off this list. Nothing on disk is touched."
                                                Visibility="{Binding IsMissing, Converter={StaticResource BooleanToVisibility}}"
                                                Command="{Binding DataContext.ForgetCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}" />

                                        <Button HorizontalContentAlignment="Left"
                                                Padding="12,8"
                                                IsEnabled="{Binding IsAvailable}"
                                                ToolTip="{Binding Path}"
                                                Command="{Binding DataContext.OpenRecentCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}">
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Right"
                                                           Style="{StaticResource HintText}"
                                                           Margin="10,0,0,0"
                                                           VerticalAlignment="Center"
                                                           Text="{Binding WhenText}" />

                                                <StackPanel>
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                                    <TextBlock Style="{StaticResource MonoText}"
                                                               Foreground="{DynamicResource Text.Muted.Brush}"
                                                               TextTrimming="CharacterEllipsis"
                                                               Text="{Binding Path}" />
                                                </StackPanel>
                                            </DockPanel>
                                        </Button>
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </DockPanel>
        </Border>
    </Border>
</UserControl>
