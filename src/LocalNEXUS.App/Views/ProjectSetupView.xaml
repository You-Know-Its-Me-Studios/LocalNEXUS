<UserControl x:Class="LocalNEXUS.App.Views.ProjectSetupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:LocalNEXUS.App.ViewModels"
             d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <!--
        Asked once, the first time a project is opened, and never again. Everything on it has a
        default that works, and skipping takes them, because a window that reappears until it is
        filled in is a window people learn to dismiss without reading.

        A layer over the window rather than a dialog, following the node search: what is behind it
        stays visible, and it costs an escape rather than a trip to a title bar.
    -->

    <Border Background="{DynamicResource Surface.Scrim.Brush}"
            Visibility="{Binding ProjectSetup.IsOpen, Converter={StaticResource BooleanToVisibility}}">
        <Border Width="520"
                MaxHeight="640"
                VerticalAlignment="Center"
                HorizontalAlignment="Center"
                CornerRadius="6"
                Background="{DynamicResource Surface.Card.Brush}"
                BorderThickness="1"
                BorderBrush="{DynamicResource Surface.Border.Brush}">

            <DockPanel DataContext="{Binding ProjectSetup}" Margin="18">

                <StackPanel DockPanel.Dock="Top">
                    <TextBlock FontSize="{StaticResource Font.Size.Title}"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"
                               Text="{Binding ProjectName, StringFormat='Setting up {0}'}" />

                    <TextBlock Style="{StaticResource HintText}"
                               Margin="0,4,0,0"
                               TextWrapping="Wrap"
                               Text="Asked once. Everything here can be changed later in Settings under Project." />
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                    <Button Style="{StaticResource SmallButton}"
                            Margin="0,0,8,0"
                            MinWidth="88"
                            Content="Skip"
                            ToolTip="Take the defaults. Nothing is blocked, and this is not asked again."
                            Command="{Binding SkipCommand}" />
                    <Button Style="{StaticResource PrimaryButton}"
                            MinWidth="96"
                            Content="Save"
                            Command="{Binding SaveCommand}" />
                </StackPanel>

                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,16,0,0">
                    <StackPanel>

                        <TextBlock Style="{StaticResource FieldLabel}" Text="Where generated code goes" />
                        <ComboBox Margin="0,2,0,0"
                                  IsEditable="True"
                                  ItemsSource="{Binding FolderChoices}"
                                  Text="{Binding ScriptsFolder, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Style="{StaticResource HintText}"
                                   Margin="0,4,0,14"
                                   TextWrapping="Wrap"
                                   Text="Relative to the project root. The list is folders this project already has; type anything else for one that does not exist yet." />

                        <TextBlock Style="{StaticResource FieldLabel}" Text="Project kind" />
                        <ComboBox Margin="0,2,0,0"
                                  ItemsSource="{Binding Kinds}"
                                  SelectedItem="{Binding Kind}" />
                        <TextBlock Style="{StaticResource HintText}"
                                   Margin="0,4,0,14"
                                   TextWrapping="Wrap"
                                   Text="{Binding KindNote}" />

                        <TextBlock Style="{StaticResource FieldLabel}" Text="Default model for this project" />
                        <ComboBox Margin="0,2,0,0"
                                  ItemsSource="{Binding Models}"
                                  SelectedItem="{Binding DefaultModel}"
                                  DisplayMemberPath="DisplayName" />
                        <TextBlock Style="{StaticResource HintText}"
                                   Margin="0,4,0,14"
                                   TextWrapping="Wrap"
                                   Text="Stays on this machine and is never committed, because it is a path that exists here and may not anywhere else." />

                        <TextBlock Style="{StaticResource FieldLabel}" Text="Answer MCP tool calls for this project" />
                        <CheckBox Margin="0,2,0,0"
                                  IsChecked="{Binding McpServerEnabled}"
                                  Content="Allow other tools to open and run this project" />
                        <TextBlock Style="{StaticResource HintText}"
                                   Margin="0,4,0,14"
                                   TextWrapping="Wrap"
                                   Text="Off unless the installation itself is also answering, which is a separate switch in Settings and is off by default." />

                        <TextBlock Style="{StaticResource FieldLabel}" Text="Share these settings" />
                        <CheckBox Margin="0,2,0,0"
                                  IsChecked="{Binding ShareSettings}"
                                  Content="Commit the folder and the project kind with the repository" />
                        <TextBlock Style="{StaticResource HintText}"
                                   Margin="0,4,0,0"
                                   TextWrapping="Wrap"
                                   Text="{Binding SharingNote}" />
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Border>
</UserControl>
