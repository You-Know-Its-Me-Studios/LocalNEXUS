<UserControl x:Class="LocalNEXUS.App.Views.Shell.WorkspaceWelcomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:LocalNEXUS.App.ViewModels"
             d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <!--
        What the Workspace is with no project open.

        It used to be the whole tab, live and unable to do anything: a canvas offering templates
        that had nowhere to write, a request box with a Run button that would fail, a rail saying
        no nodes yet, an inspector saying select a node, a panel saying nothing is wrong, and a
        status bar saying no project. Six pieces of furniture narrating the same emptiness in six
        different sentences, none of them the one thing to do about it.

        This says the one thing, and carries the walkthrough, which is onboarding rather than
        workspace furniture and belongs where somebody is being onboarded.
    -->

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24">
        <StackPanel MaxWidth="620" HorizontalAlignment="Center" VerticalAlignment="Center">

            <TextBlock Text="LocalNEXUS"
                       FontSize="{StaticResource Font.Size.Title}"
                       FontWeight="SemiBold" />

            <TextBlock Style="{StaticResource HintText}"
                       Margin="0,8,0,0"
                       TextWrapping="Wrap"
                       Text="Open a project to start. A project is a folder holding a codebase for the models to work on." />

            <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                <Button Style="{StaticResource PrimaryButton}"
                        MinWidth="140"
                        Content="Open a project"
                        Command="{Binding OpenProjectCommand}" />

                <Button Style="{StaticResource SmallButton}"
                        Margin="8,0,0,0"
                        MinWidth="140"
                        Content="Recent projects"
                        ToolTip="Projects you have opened before."
                        Command="{Binding ShowFrontDoorCommand}" />
            </StackPanel>

            <!--
                The walkthrough, inline rather than pinned to a rail. Every step is a thing to do
                elsewhere, and this is the moment somebody has done none of them.
            -->
            <Rectangle Height="1" Margin="0,26,0,0" Fill="{DynamicResource Surface.Border.Brush}" />

            <DockPanel Margin="0,20,0,0">
                <TextBlock DockPanel.Dock="Right"
                           Style="{StaticResource HintText}"
                           VerticalAlignment="Center"
                           Text="{Binding Walkthrough.Progress}" />

                <TextBlock Text="Getting started" FontWeight="SemiBold" />
            </DockPanel>

            <ItemsControl ItemsSource="{Binding Walkthrough.Steps}" Margin="0,12,0,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,0,0,14">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Left"
                                           Width="20"
                                           VerticalAlignment="Top"
                                           FontFamily="{StaticResource Font.Icons}"
                                           Foreground="{DynamicResource Status.Success.Brush}"
                                           Text="&#xE73E;"
                                           Visibility="{Binding IsDone, Converter={StaticResource BooleanToVisibility}}" />

                                <TextBlock DockPanel.Dock="Left"
                                           Width="20"
                                           VerticalAlignment="Top"
                                           FontFamily="{StaticResource Font.Icons}"
                                           Foreground="{DynamicResource Text.Muted.Brush}"
                                           Text="&#xE739;"
                                           Visibility="{Binding IsDone, Converter={StaticResource BooleanToVisibility}, ConverterParameter=Invert}" />

                                <TextBlock Text="{Binding Title}"
                                           TextWrapping="Wrap"
                                           VerticalAlignment="Center" />
                            </DockPanel>

                            <TextBlock Style="{StaticResource HintText}"
                                       Margin="20,2,0,0"
                                       TextWrapping="Wrap"
                                       Text="{Binding Detail}" />

                            <Button Margin="20,7,0,0"
                                    HorizontalAlignment="Left"
                                    Style="{StaticResource SmallButton}"
                                    Content="{Binding ActionLabel}"
                                    Command="{Binding Action}"
                                    Visibility="{Binding HasAction, Converter={StaticResource BooleanToVisibility}}" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
