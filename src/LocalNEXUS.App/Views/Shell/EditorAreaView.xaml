<UserControl x:Class="LocalNEXUS.App.Views.Shell.EditorAreaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:LocalNEXUS.App.Infrastructure.Behaviors"
             xmlns:nodify="clr-namespace:Nodify;assembly=Nodify"
             xmlns:vm="clr-namespace:LocalNEXUS.App.ViewModels"
             d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <!--
        The editor area: a tab strip, the request the run is executing, and the canvas.

        The tab strip holds one document. Opening several graphs at once is a change to how running
        and saving work rather than to how they look, and this slice does not change behaviour; the
        strip is the shape the shell has, and the seam for the rest of it when it is wanted.
    -->

    <!--
        No fill of its own. The window base layer below is what shows here, which is what puts
        the theme gradient behind the canvas, and what lets a translucent theme be translucent
        over the largest area the shell has. Every surface in here that carries text paints
        itself and stays solid.
    -->
    <DockPanel Background="Transparent">

        <!-- Tabs -->
        <Border DockPanel.Dock="Top"
                Background="{DynamicResource Surface.Chrome.Brush}"
                BorderBrush="{DynamicResource Surface.Border.Brush}"
                BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal">
                <ToggleButton Style="{StaticResource EditorTab}"
                              IsChecked="True"
                              IsHitTestVisible="False"
                              ToolTip="{Binding Document.PathText}">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Style="{StaticResource StateDot}"
                                 Width="6" Height="6"
                                 Margin="0,0,7,0"
                                 Fill="{Binding Feed.RunState, Converter={StaticResource ResourceLookup}, ConverterParameter=RunState}" />

                        <TextBlock Text="{Binding Document.Name}" />

                        <TextBlock Text="&#x25CF;"
                                   FontSize="8"
                                   Margin="8,0,0,0"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource Text.Secondary.Brush}"
                                   ToolTip="Unsaved changes"
                                   Visibility="{Binding Document.IsDirty, Converter={StaticResource BooleanToVisibility}}" />
                    </StackPanel>
                </ToggleButton>
            </StackPanel>
        </Border>

        <!--
            The request box, under the canvas it drives.

            It used to sit at the very bottom of the window, below the output dock, where it read
            as part of that dock. What it actually feeds is the graph above it, so it belongs in
            the same region as the tabs and the canvas. Being here rather than in the window's
            bottom row is also what keeps it on screen when the output dock is collapsed: the
            transcript can be put away and a request still sent.

            No visibility of its own. The editor area is only on screen in the Workspace, which is
            the condition the binding it used to carry was expressing.
        -->
        <Border DockPanel.Dock="Bottom"
                Background="{DynamicResource Surface.Panel.Brush}"
                BorderBrush="{DynamicResource Surface.Border.Brush}"
                BorderThickness="0,1,0,0"
                Padding="16,10">
            <StackPanel>
                <!--
                    The conversation, above the box that continues it. Bounded in height, because
                    this belongs to the canvas rather than replacing it: the graph is still the
                    machine and the transcript is how it is driven.
                -->
                <DockPanel MaxHeight="240"
                           Margin="0,0,0,10"
                           Visibility="{Binding Feed.Conversation.HasTurns, Converter={StaticResource BooleanToVisibility}}">

                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                        <Button DockPanel.Dock="Right"
                                Style="{StaticResource SmallButton}"
                                MinWidth="120"
                                Content="New conversation"
                                ToolTip="Starts a fresh thread. Nothing is deleted: the old one keeps every word and stays searchable in the run history."
                                Command="{Binding Feed.NewConversationCommand}" />

                        <TextBlock Style="{StaticResource HintText}"
                                   VerticalAlignment="Center"
                                   Text="Conversation" />
                    </DockPanel>

                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  behaviors:AutoScrollBehavior.IsEnabled="True">
                        <ItemsControl ItemsSource="{Binding Feed.Conversation.Turns}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,6"
                                            Padding="10,7"
                                            CornerRadius="4"
                                            Background="{DynamicResource Surface.Card.Brush}"
                                            BorderThickness="1"
                                            BorderBrush="{DynamicResource Surface.Border.Brush}">
                                        <StackPanel>
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Right"
                                                           Style="{StaticResource HintText}"
                                                           Text="{Binding Time}" />
                                                <TextBlock FontWeight="SemiBold"
                                                           FontSize="{StaticResource Font.Size.Small}"
                                                           Text="{Binding Speaker}" />
                                            </DockPanel>

                                            <TextBlock Margin="0,3,0,0"
                                                       TextWrapping="Wrap"
                                                       Text="{Binding Text}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>

                <!--
                    What a run is waiting to hear. Shown beside the box rather than in a dialog,
                    because the answer is typed and the question should be readable while it is
                    being typed.
                -->
                <Border Margin="0,0,0,10"
                        Padding="12,9"
                        CornerRadius="4"
                        Background="{DynamicResource Surface.Card.Brush}"
                        BorderThickness="1"
                        BorderBrush="{DynamicResource Status.Warning.Brush}"
                        Visibility="{Binding Feed.Conversation.IsAwaitingAnswer, Converter={StaticResource BooleanToVisibility}}">
                    <StackPanel>
                        <DockPanel>
                            <Button DockPanel.Dock="Right"
                                    Style="{StaticResource SmallButton}"
                                    MinWidth="150"
                                    Content="Proceed without answering"
                                    ToolTip="Carries on with a stated assumption, which the run says out loud."
                                    Command="{Binding Feed.ProceedWithoutAnsweringCommand}" />

                            <TextBlock FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource Status.Warning.Brush}"
                                       Text="The run is waiting on an answer" />
                        </DockPanel>

                        <TextBlock Style="{StaticResource HintText}"
                                   Margin="0,4,0,0"
                                   TextWrapping="Wrap"
                                   Text="Answer in the box below. Anything you send now is read as the answer rather than as a new request." />
                    </StackPanel>
                </Border>

                <!--
                    A run held on a wire, and the thing it is holding.

                    Whether it is showing is read from the held stop itself rather than from the
                    service that owns it, because this element sets its own DataContext and every
                    other binding on it is resolved against the new one. A path reaching back to
                    the outer view model resolves against the stop, finds nothing, and leaves
                    Visibility at its default, which is visible: the panel was up permanently with
                    nothing in it and two buttons bound to null.

                    Above the request box for the same reason the staged files are: the value is
                    being read and edited, so it wants the width and the wrap that a dialog does
                    not have, and the run is not going anywhere until it is released.

                    A value that is not text is shown and not offered for editing, with the reason
                    said rather than a box that would accept typing and discard it.
                -->
                <Border Margin="0,0,0,10"
                        Padding="12,9"
                        CornerRadius="4"
                        Background="{DynamicResource Surface.Card.Brush}"
                        BorderThickness="1"
                        BorderBrush="{DynamicResource Breakpoint.Marker.Brush}"
                        DataContext="{Binding Breakpoints.Current}"
                        Visibility="{Binding Converter={StaticResource NullToVisibility}}">
                    <StackPanel>
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Style="{StaticResource SmallButton}"
                                        Margin="0,0,6,0"
                                        Content="Release unchanged"
                                        ToolTip="Carry on with the value exactly as it arrived."
                                        Command="{Binding DiscardCommand}" />
                                <Button Style="{StaticResource PrimaryButton}"
                                        MinWidth="88"
                                        Content="Continue"
                                        ToolTip="Carry on, with whatever the box now holds."
                                        Command="{Binding ContinueCommand}" />
                            </StackPanel>

                            <TextBlock FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource Breakpoint.Marker.Brush}"
                                       TextTrimming="CharacterEllipsis"
                                       Text="{Binding Where}" />
                        </DockPanel>

                        <TextBlock Style="{StaticResource HintText}"
                                   Margin="0,4,0,0"
                                   TextWrapping="Wrap"
                                   Text="{Binding ReadOnlyReason}"
                                   Visibility="{Binding IsEditable, Converter={StaticResource BooleanToVisibility}, ConverterParameter=Invert}" />

                        <TextBox Margin="0,8,0,0"
                                 Style="{StaticResource MonoTextBox}"
                                 Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                                 IsReadOnly="{Binding IsEditable, Converter={StaticResource BooleanToInverse}}"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 MinHeight="60"
                                 MaxHeight="220"
                                 Padding="8,6" />
                    </StackPanel>
                </Border>

                <!--
                    What the last run could not finish, above the box that resolves it.
                    Here rather than in a dialog because the answer is typed, and the
                    thing being answered should be readable while it is being typed.
                -->
                <Border Margin="0,0,0,10"
                        Padding="12,9"
                        CornerRadius="4"
                        Background="{DynamicResource Surface.Card.Brush}"
                        BorderThickness="1"
                        BorderBrush="{DynamicResource Surface.Border.Brush}"
                        Visibility="{Binding Feed.Staging.HasPending, Converter={StaticResource BooleanToVisibility}}">
                    <StackPanel>
                        <DockPanel>
                            <Button DockPanel.Dock="Right"
                                    Style="{StaticResource SmallButton}"
                                    Content="Discard all"
                                    ToolTip="Forgets every attempt below. No file on disk is touched."
                                    AutomationProperties.Name="Discard every staged attempt"
                                    Command="{Binding Feed.DiscardAllStagedCommand}" />

                            <TextBlock FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource Status.Warning.Brush}"
                                       Text="{Binding Feed.Staging.Summary}" />
                        </DockPanel>

                        <TextBlock Style="{StaticResource HintText}"
                                   Margin="0,4,0,0"
                                   TextWrapping="Wrap"
                                   Text="Everything that compiled is already written. These were not, and nothing on disk was changed for them. Open one to see what was attempted, then either say what to do below and run again, or discard it. They are kept with the project, so closing the application does not lose them." />

                        <ItemsControl ItemsSource="{Binding Feed.Staging.Pending}" Margin="0,8,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,8">
                                        <DockPanel>
                                            <!--
                                                Named rather than an X. Both actions here remove
                                                something and neither touches the disk, and a bare
                                                icon left it to be guessed which one it was.
                                            -->
                                            <Button DockPanel.Dock="Right"
                                                    Style="{StaticResource SmallButton}"
                                                    Margin="6,0,0,0"
                                                    VerticalAlignment="Top"
                                                    Content="Discard"
                                                    ToolTip="Forgets this one attempt. The file on disk is not touched."
                                                    AutomationProperties.Name="Discard this attempt"
                                                    Command="{Binding DataContext.Feed.DiscardStagedCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}" />

                                            <StackPanel>
                                                <TextBlock Style="{StaticResource MonoText}"
                                                           TextTrimming="CharacterEllipsis"
                                                           Text="{Binding Summary}" />
                                                <TextBlock Style="{StaticResource HintText}"
                                                           TextWrapping="Wrap"
                                                           Text="{Binding ReasonText}" />
                                            </StackPanel>
                                        </DockPanel>

                                        <!--
                                            What was actually tried, which is what the decision
                                            turns on: retype the request, edit the file by hand, or
                                            throw the attempt away. Folded away per the feed's own
                                            rule, because it is a wall of code until it is wanted.
                                        -->
                                        <Expander Margin="0,4,0,0" Header="What was attempted">
                                            <StackPanel Margin="0,4,0,0">
                                                <TextBox Text="{Binding Detail, Mode=OneWay}"
                                                         IsReadOnly="True"
                                                         BorderThickness="0"
                                                         Background="Transparent"
                                                         Foreground="{DynamicResource Text.Secondary.Brush}"
                                                         FontFamily="{StaticResource Font.Mono}"
                                                         FontSize="{StaticResource Font.Size.Small}"
                                                         TextWrapping="Wrap"
                                                         Padding="0"
                                                         MaxHeight="160"
                                                         VerticalScrollBarVisibility="Auto"
                                                         HorizontalScrollBarVisibility="Disabled"
                                                         Visibility="{Binding HasDetail, Converter={StaticResource BooleanToVisibility}}" />

                                                <TextBlock Style="{StaticResource HintText}"
                                                           Margin="0,8,0,0"
                                                           TextWrapping="Wrap"
                                                           Text="{Binding AttemptLabel}" />

                                                <TextBox Margin="0,2,0,0"
                                                         Text="{Binding Content, Mode=OneWay}"
                                                         IsReadOnly="True"
                                                         BorderThickness="0"
                                                         Background="Transparent"
                                                         Foreground="{DynamicResource Text.Secondary.Brush}"
                                                         FontFamily="{StaticResource Font.Mono}"
                                                         FontSize="{StaticResource Font.Size.Small}"
                                                         TextWrapping="NoWrap"
                                                         Padding="0"
                                                         MaxHeight="260"
                                                         VerticalScrollBarVisibility="Auto"
                                                         HorizontalScrollBarVisibility="Auto"
                                                         Visibility="{Binding HasAttempt, Converter={StaticResource BooleanToVisibility}}" />
                                            </StackPanel>
                                        </Expander>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                <Grid Grid.Column="0">
                    <!--
                        Images arrive here, by paste or by drop. The image itself goes no further:
                        a vision model reads it and what joins the request is the text it produced,
                        which is why the graph and its pins are untouched by any of it.
                    -->
                    <TextBox Text="{Binding Feed.RequestText, UpdateSourceTrigger=PropertyChanged}"
                             behaviors:ImageDropBehavior.IsEnabled="True"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             MinHeight="34"
                             MaxHeight="120"
                             Padding="10,7" />

                    <!--
                        The instruction, on the box it is about. It used to be a line above the
                        canvas, which was only ever compensating for the box being somewhere else,
                        and a watermark says the same thing where somebody is already looking.
                    -->
                    <TextBlock Text="Describe a request, then press Run or Ctrl+Enter."
                               Margin="11,0,0,0"
                               VerticalAlignment="Center"
                               IsHitTestVisible="False"
                               Foreground="{DynamicResource Text.Muted.Brush}"
                               Visibility="{Binding Feed.RequestText, Converter={StaticResource StringToVisibility}, ConverterParameter=Invert}" />
                </Grid>

                <StackPanel Grid.Column="2" VerticalAlignment="Stretch">
                    <!--
                        Per send rather than per node, because most requests do not need search and
                        whoever is typing knows which do. It is absent rather than disabled when
                        there is no key, since a toggle for something unavailable teaches people it
                        does not work.
                    -->
                    <CheckBox Margin="0,0,0,6"
                              Content="Search the web"
                              IsChecked="{Binding Feed.SearchThisSend}"
                              ToolTip="Let every Model node in this run call web search when it needs something newer than its training. Snippets only; no page is fetched."
                              Visibility="{Binding Feed.CanSearch, Converter={StaticResource BooleanToVisibility}}" />

                    <!--
                        Said on screen rather than only in the tooltip. It is a per send switch that
                        reaches every Model node in the run, which is not what a checkbox beside one
                        input box looks like, and a tooltip is not where somebody finds that out.
                    -->
                    <TextBlock Style="{StaticResource HintText}"
                               Margin="0,0,0,6"
                               MaxWidth="150"
                               TextWrapping="Wrap"
                               Text="Applies to every Model node in this run."
                               Visibility="{Binding Feed.SearchThisSend, Converter={StaticResource BooleanToVisibility}}" />

                    <Button Style="{StaticResource PrimaryButton}"
                            MinWidth="96"
                            Content="Run"
                            Command="{Binding Feed.RunCommand}" />
                </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!--
            The canvas and the search over it.

            Nodes can be added from the Edit menu, from a right click, by double clicking empty
            canvas, or by dragging a wire out and letting go over nothing. The last two are what a
            node editor is expected to have, and the fourth is the fastest of them because the pin
            it came from says which node types could possibly go on the end.

            The search is a layer over the canvas rather than a window, so the graph stays visible
            behind it and dismissing it costs an escape rather than a trip to a title bar.
        -->
        <Grid>
        <nodify:NodifyEditor ItemsSource="{Binding Document.Nodes}"
                             Connections="{Binding Graph.Connections}"
                             PendingConnection="{Binding PendingConnection}"
                             ItemTemplate="{StaticResource NodeTemplate}"
                             ItemContainerStyle="{StaticResource NodeContainerStyle}"
                             ConnectionTemplate="{StaticResource ConnectionTemplate}"
                             PendingConnectionTemplate="{StaticResource PendingConnectionTemplate}"
                             DisconnectConnectorCommand="{Binding DisconnectPinCommand}"
                             RemoveConnectionCommand="{Binding RemoveConnectionCommand}"
                             GridCellSize="16"
                             DisplayConnectionsOnTop="False"
                             behaviors:CanvasSearchBehavior.Search="{Binding NodeSearch}"
                             Background="Transparent">
            <nodify:NodifyEditor.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Add node"
                              ItemsSource="{Binding NodePalette}"
                              IsEnabled="{Binding IsWorkspace}">
                        <MenuItem.ItemContainerStyle>
                            <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                                <Setter Property="Header" Value="{Binding DisplayName}" />
                                <Setter Property="ToolTip" Value="{Binding Description}" />
                                <Setter Property="CommandParameter" Value="{Binding TypeKey}" />
                                <Setter Property="Command" Value="{Binding Command}" />
                            </Style>
                        </MenuItem.ItemContainerStyle>
                    </MenuItem>
                    <Separator />
                    <MenuItem Header="Delete selected"
                              InputGestureText="Del"
                              Command="{Binding DeleteSelectionCommand}" />
                </ContextMenu>
            </nodify:NodifyEditor.ContextMenu>
        </nodify:NodifyEditor>

        <!--
            What an empty canvas says.

            A first launch used to be a grid and nothing else, which tells somebody that the
            application opened and nothing about what to do next. The templates are here rather
            than only on the File menu because this is where the eye already is, and they are the
            same list, so one of them cannot go stale.

            Hit test invisible except for the buttons, so the canvas underneath still takes a
            double click and a right click while this is showing.
        -->
        <StackPanel VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    MaxWidth="460"
                    IsHitTestVisible="True"
                    Visibility="{Binding ShowTemplates, Converter={StaticResource BooleanToVisibility}}">
            <TextBlock Text="Nothing on the canvas yet"
                       HorizontalAlignment="Center"
                       FontSize="{StaticResource Font.Size.Large}"
                       Foreground="{DynamicResource Text.Secondary.Brush}" />

            <TextBlock Style="{StaticResource HintText}"
                       Margin="0,6,0,0"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       Text="Start from one of these, or double click anywhere to add a node. Every template runs as it is once a model is chosen on each Model node." />

            <ItemsControl ItemsSource="{Binding Templates}" Margin="0,14,0,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Margin="0,0,0,6"
                                HorizontalContentAlignment="Left"
                                Padding="12,8"
                                ToolTip="{Binding Description}"
                                Command="{Binding DataContext.ApplyTemplateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}">
                            <StackPanel>
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                <TextBlock Style="{StaticResource HintText}"
                                           TextWrapping="Wrap"
                                           MaxWidth="400"
                                           Text="{Binding Description}" />
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!--
                The way out. A suggestion that cannot be refused is not a suggestion, and without
                this the only ways past the templates were to take one or to put a node down.
            -->
            <Button Margin="0,8,0,0"
                    HorizontalContentAlignment="Left"
                    Padding="12,8"
                    ToolTip="Puts these away and leaves the canvas empty. Double click anywhere to add a node."
                    Command="{Binding DataContext.DismissTemplatesCommand, RelativeSource={RelativeSource AncestorType=UserControl}}">
                <StackPanel>
                    <TextBlock Text="Build on my own" FontWeight="SemiBold" />
                    <TextBlock Style="{StaticResource HintText}"
                               TextWrapping="Wrap"
                               MaxWidth="400"
                               Text="Start from an empty canvas. Double click anywhere to add a node." />
                </StackPanel>
            </Button>
        </StackPanel>

        <!--
            Dimmed behind, so a click that lands anywhere else closes the search rather than
            reaching the canvas underneath and starting something.

            The dimming and the card are siblings rather than one inside the other, and that is
            the whole of why clicking a result works. Input bindings are evaluated on the way down
            through every element the pointer is over, outermost first, so with the card inside the
            dimming a click on a result reached the close binding before it reached the row: the
            search closed and nothing was placed. Side by side, a click on the card never passes
            through the dimming at all.
        -->
        <Grid Visibility="{Binding NodeSearch.IsOpen, Converter={StaticResource BooleanToVisibility}}">
            <Border Background="{DynamicResource Surface.Scrim.Brush}">
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick" Command="{Binding NodeSearch.CloseCommand}" />
                </Border.InputBindings>
            </Border>

            <Border Width="380"
                    MaxHeight="360"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Padding="0"
                    CornerRadius="6"
                    Background="{DynamicResource Surface.Card.Brush}"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource Surface.Border.Brush}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top"
                               Style="{StaticResource HintText}"
                               Margin="12,10,12,0"
                               Text="{Binding NodeSearch.Prompt}" />

                    <!--
                        Enter places the highlighted row and escape closes, which is what makes
                        this usable without the mouse leaving where the node is going.
                    -->
                    <TextBox DockPanel.Dock="Top"
                             x:Name="NodeSearchBox"
                             Margin="12,6,12,10"
                             Padding="8,6"
                             behaviors:FocusOnVisibleBehavior.IsEnabled="True"
                             Text="{Binding NodeSearch.Query, UpdateSourceTrigger=PropertyChanged}">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding NodeSearch.PlaceCommand}" />
                            <KeyBinding Key="Escape" Command="{Binding NodeSearch.CloseCommand}" />
                            <KeyBinding Key="Down" Command="{Binding NodeSearch.SelectNextCommand}" />
                            <KeyBinding Key="Up" Command="{Binding NodeSearch.SelectPreviousCommand}" />
                        </TextBox.InputBindings>
                    </TextBox>

                    <TextBlock DockPanel.Dock="Bottom"
                               Style="{StaticResource HintText}"
                               Margin="12,8,12,12"
                               TextWrapping="Wrap"
                               Visibility="{Binding NodeSearch.HasResults, Converter={StaticResource BooleanToVisibility}, ConverterParameter=Invert}"
                               Text="Nothing matches. Every node type is offered here, so a name that finds nothing is a name no node has." />

                    <!--
                        Stretched rows, so a click anywhere across a row is a click on that row
                        rather than only one that landed on the words.
                    -->
                    <ListBox ItemsSource="{Binding NodeSearch.Results}"
                             SelectedItem="{Binding NodeSearch.Selected}"
                             Background="Transparent"
                             BorderThickness="0"
                             HorizontalContentAlignment="Stretch"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding NodeSearch.PlaceCommand}" />
                            <KeyBinding Key="Escape" Command="{Binding NodeSearch.CloseCommand}" />
                        </ListBox.InputBindings>
                        <ListBox.ItemTemplate>
                            <DataTemplate>

                                <!--
                                    One click places the row and closes the search, which is what
                                    clicking a thing in a list of things to add means. It used to
                                    take two, so a single click selected a row and then sat there.

                                    The row hands itself to the command rather than letting it read
                                    the highlight, because whether the list has updated its
                                    selection by the time this runs depends on which element saw
                                    the press first. Transparent so the whole row is clickable and
                                    not only the text.
                                -->
                                <StackPanel Margin="4,3" Background="Transparent">
                                    <StackPanel.InputBindings>
                                        <MouseBinding MouseAction="LeftClick"
                                                      Command="{Binding DataContext.NodeSearch.PlaceCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                      CommandParameter="{Binding}" />
                                    </StackPanel.InputBindings>

                                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                                    <TextBlock Style="{StaticResource HintText}"
                                               TextWrapping="Wrap"
                                               Text="{Binding Detail}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
        </Grid>
        </Grid>
    </DockPanel>
</UserControl>
