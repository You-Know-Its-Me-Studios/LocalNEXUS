<UserControl x:Class="LocalNEXUS.App.Views.Shell.InspectorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:LocalNEXUS.App.ViewModels"
             d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Background="{DynamicResource Surface.Panel.Brush}">

    <!--
        One slot, reused everywhere. In the Workspace it holds the selected node; in the Network it
        holds whichever machine, model or coverage section is selected. The slot always means the
        same thing: what can I do about the thing I just clicked.

        The header is the same shell every time, a coloured bar, a title, a type tag and a state
        pill, and the panel below it is picked by the type of what is selected. A node with nothing
        to configure gets a header and a sentence explaining what it does, and no fields, because
        an empty panel is the honest answer and inventing fields to fill it is not.
    -->

    <Grid>
        <DockPanel Visibility="{Binding InspectorContent, Converter={StaticResource NullToVisibility}}">

            <Border DockPanel.Dock="Top"
                    BorderBrush="{DynamicResource Surface.Border.Brush}"
                    BorderThickness="0,0,0,1"
                    Padding="0,10,12,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Rectangle Grid.Column="0"
                               Style="{StaticResource AccentBar}"
                               Margin="10,0,10,0"
                               Fill="{Binding InspectorHeader.AccentKey, Converter={StaticResource BrushKey}}" />

                    <TextBlock Grid.Column="1"
                               Text="{Binding InspectorHeader.Title}"
                               FontWeight="SemiBold"
                               FontSize="{StaticResource Font.Size.Large}"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />

                    <Border Grid.Column="2" Style="{StaticResource Tag}" Margin="8,0,0,0">
                        <TextBlock Style="{StaticResource TagText}" Text="{Binding InspectorHeader.TypeTag}" />
                    </Border>

                    <TextBlock Grid.Column="4"
                               Text="{Binding InspectorHeader.StateText}"
                               FontSize="{StaticResource Font.Size.Small}"
                               VerticalAlignment="Center"
                               Foreground="{Binding InspectorHeader.StateKey, Converter={StaticResource BrushKey}}" />

                    <!--
                        A way back out. Clicking into a coverage section pinned the inspector to it
                        with nothing that went back up, and the Network picks a model on load, so
                        there was never a state with nothing selected to return to. One press goes
                        up a level, the next lets go entirely.

                        Network only. In the Workspace the selection belongs to the canvas, and
                        clicking empty space there already clears it.
                    -->
                    <Button Grid.Column="5"
                            Style="{StaticResource IconButton}"
                            Margin="8,0,0,0"
                            Content="&#xE711;"
                            ToolTip="Back out of this. Press again to select nothing."
                            AutomationProperties.Name="Close the inspector"
                            Command="{Binding Network.ClearInspectorCommand}"
                            Visibility="{Binding IsNetwork, Converter={StaticResource BooleanToVisibility}}" />
                </Grid>
            </Border>

            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16,12">
                <StackPanel>

                    <!-- Renaming is common to every node, so it lives here rather than in each panel. -->
                    <StackPanel Visibility="{Binding SelectedNode, Converter={StaticResource NullToVisibility}}">
                        <TextBlock Style="{StaticResource FieldLabel}" Margin="0,0,0,4" Text="Title" />
                        <TextBox Text="{Binding SelectedNode.Title, UpdateSourceTrigger=PropertyChanged}" />

                        <Rectangle Height="1"
                                   Margin="0,14,0,2"
                                   Fill="{DynamicResource Surface.Border.Brush}" />
                    </StackPanel>

                    <ContentControl Content="{Binding InspectorContent}" />
                </StackPanel>
            </ScrollViewer>
        </DockPanel>

        <TextBlock HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   TextWrapping="Wrap"
                   TextAlignment="Center"
                   Margin="24"
                   Foreground="{DynamicResource Text.Muted.Brush}"
                   Visibility="{Binding InspectorContent, Converter={StaticResource NullToVisibility}, ConverterParameter=Invert}">
            <TextBlock.Style>
                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                    <Setter Property="Text" Value="Select a node to edit its settings." />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsNetwork}" Value="True">
                            <Setter Property="Text" Value="Select a model, a machine or a coverage section." />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
    </Grid>
</UserControl>
