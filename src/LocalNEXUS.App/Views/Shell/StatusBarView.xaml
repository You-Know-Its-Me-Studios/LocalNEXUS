<UserControl x:Class="LocalNEXUS.App.Views.Shell.StatusBarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:LocalNEXUS.App.ViewModels"
             d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Height="24"
             Background="{DynamicResource Surface.Chrome.Brush}">

    <!--
        The status bar. Four things that are always true and one that depends on where you are.

        Every one of them is a dot and a word, and the dot is resolved from the state enum rather
        than from a rule written here, so the three way distinction the whole application is built
        on, healthy and working and failed, is the same three colours in every one of them. A mesh
        node that is starting and a Python environment that is downloading are both blue, and
        neither can accidentally be drawn as the red that means something broke.
    -->

    <Grid>
        <!--
            Centred, and that is load bearing. This bar has a fixed height, so a row left to
            stretch fills all of it, and a TextBlock given more height than its text draws that
            text at the top of what it was given while the dot beside it centres in the middle.
            The two then disagree by half the leftover height. Centring the row makes it as tall
            as the text, which is what puts the dot and the word on the same line.
        -->
        <StackPanel Orientation="Horizontal" Margin="10,0,0,0" VerticalAlignment="Center">

            <StackPanel Orientation="Horizontal"
                        Margin="0,0,16,0"
                        ToolTip="The state of the current or most recent run.">
                <Ellipse Style="{StaticResource StateDot}"
                         Width="6" Height="6"
                         Margin="0,0,6,0"
                         Fill="{Binding Feed.RunState, Converter={StaticResource ResourceLookup}, ConverterParameter=RunState}" />
                <TextBlock FontSize="{StaticResource Font.Size.Micro}" Text="{Binding Feed.RunState}" />
            </StackPanel>

            <!--
                A dot and nothing else. The sentence beside it repeated what the Network tab says
                across its whole header, so between the two of them and the tab's own inspector the
                same fact was on screen three times and none of them read as the one to trust.
                The tool tip keeps it reachable from any tab.
            -->
            <StackPanel Orientation="Horizontal"
                        Margin="0,0,16,0"
                        ToolTip="{Binding Network.Mesh.StatusText}">
                <Ellipse Style="{StaticResource StateDot}"
                         Width="6" Height="6"
                         Margin="0,0,6,0"
                         Fill="{Binding Network.Mesh.State, Converter={StaticResource ResourceLookup}, ConverterParameter=MeshNodeState}" />
                <TextBlock FontSize="{StaticResource Font.Size.Micro}" Text="Mesh" />
            </StackPanel>

            <StackPanel Orientation="Horizontal"
                        Margin="0,0,16,0"
                        ToolTip="{Binding PythonEnvironment.Environment.StatusText}">
                <Ellipse Style="{StaticResource StateDot}"
                         Width="6" Height="6"
                         Margin="0,0,6,0"
                         Fill="{Binding PythonEnvironment.Environment.State, Converter={StaticResource ResourceLookup}, ConverterParameter=PythonEnvironmentState}" />
                <TextBlock FontSize="{StaticResource Font.Size.Micro}" Text="Python" />
                <TextBlock FontSize="{StaticResource Font.Size.Micro}"
                           Margin="4,0,0,0"
                           Foreground="{DynamicResource Text.Secondary.Brush}"
                           Text="{Binding PythonEnvironment.Environment.State}" />
            </StackPanel>

            <!--
                What the last run left behind. Hidden when there is nothing, because a count of
                zero waiting files is not news and a status bar that always says something is a
                status bar nobody reads.
            -->
            <StackPanel Orientation="Horizontal"
                        Margin="0,0,16,0"
                        ToolTip="Files an earlier run could not finish. Say what to do about them in the box below."
                        Visibility="{Binding Feed.Staging.HasPending, Converter={StaticResource BooleanToVisibility}}">
                <Ellipse Style="{StaticResource StateDot}"
                         Width="6" Height="6"
                         Margin="0,0,6,0"
                         Fill="{DynamicResource Status.Warning.Brush}" />
                <TextBlock FontSize="{StaticResource Font.Size.Micro}" Text="{Binding Feed.Staging.Summary}" />
            </StackPanel>

            <StackPanel Orientation="Horizontal"
                        Margin="0,0,16,0"
                        ToolTip="{Binding Project.StatusText}">
                <Ellipse Style="{StaticResource StateDot}"
                         Width="6" Height="6"
                         Margin="0,0,6,0"
                         Fill="{Binding ProjectIndex.State, Converter={StaticResource ResourceLookup}, ConverterParameter=ProjectIndexState}" />
                <TextBlock FontSize="{StaticResource Font.Size.Micro}"
                           Text="{Binding Project.ProjectName, TargetNullValue=No project}" />
                <TextBlock FontSize="{StaticResource Font.Size.Micro}"
                           Margin="4,0,0,0"
                           Foreground="{DynamicResource Text.Secondary.Brush}"
                           Text="{Binding Project.KindText}"
                           Visibility="{Binding Project.HasProject, Converter={StaticResource BooleanToVisibility}}" />
            </StackPanel>
        </StackPanel>

        <!-- What the section currently showing amounts to. -->
        <TextBlock HorizontalAlignment="Right"
                   VerticalAlignment="Center"
                   Margin="0,0,12,0"
                   Style="{StaticResource MonoText}"
                   FontSize="{StaticResource Font.Size.Micro}"
                   Foreground="{DynamicResource Text.Secondary.Brush}"
                   Text="{Binding StatusSummary}" />
    </Grid>
</UserControl>
