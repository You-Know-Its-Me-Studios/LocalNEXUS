<UserControl x:Class="LocalNEXUS.App.Views.Shell.NetworkSideBarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:LocalNEXUS.App.ViewModels"
             d:DataContext="{d:DesignInstance Type=vm:NetworkViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Background="{DynamicResource Surface.Panel.Brush}">

    <!--
        The machines in the mesh, and nothing else.

        This rail used to hold three unrelated things stacked: four filter groups acting on the
        table, a whole host settings form acting on the node, and this list. The filters became one
        dropdown in the toolbar, because a table that usually holds one row does not need four
        groups with live counts; the settings became a panel that opens on demand, because they are
        edited rarely and applied. What is left is the one thing here that is worth watching.
    -->

    <DockPanel>
        <TextBlock DockPanel.Dock="Top" Style="{StaticResource SideBarHeader}" Text="MACHINES" />

        <TextBlock DockPanel.Dock="Top"
                   Style="{StaticResource HintText}"
                   Margin="14,0,14,10"
                   TextWrapping="Wrap"
                   Text="{Binding Mesh.EmptySourcesText}"
                   Visibility="{Binding Machines.Count, Converter={StaticResource CountToVisibility}, ConverterParameter=Invert}" />

        <ListBox ItemsSource="{Binding Machines}"
                 SelectedItem="{Binding SelectedSource}"
                 ItemContainerStyle="{StaticResource ListRow}"
                 Background="Transparent"
                 BorderThickness="0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <DockPanel Margin="0,3">
                        <Ellipse DockPanel.Dock="Left"
                                 Style="{StaticResource StateDot}"
                                 Margin="0,0,8,0"
                                 VerticalAlignment="Center"
                                 Fill="{Binding State, Converter={StaticResource ResourceLookup}, ConverterParameter=SourceState}" />

                        <StackPanel>
                            <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Style="{StaticResource MonoText}"
                                       Foreground="{DynamicResource Text.Muted.Brush}"
                                       TextTrimming="CharacterEllipsis"
                                       Text="{Binding CapabilityText}" />
                        </StackPanel>
                    </DockPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</UserControl>
