<UserControl x:Class="LocalNEXUS.App.Views.Shell.NetworkSideBarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:LocalNEXUS.App.ViewModels"
             d:DataContext="{d:DesignInstance Type=vm:NetworkViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Background="{DynamicResource Surface.Panel.Brush}">

    <!--
        The machines in the mesh, and nothing else.

        This rail used to hold three unrelated things stacked: four filter groups acting on the
        table, a whole host settings form acting on the node, and this list. The filters became one
        dropdown in the toolbar, because a table that usually holds one row does not need four
        groups with live counts; the settings became a panel that opens on demand, because they are
        edited rarely and applied. What is left is the one thing here that is worth watching.
    -->

    <DockPanel>

        <!--
            What this machine is in, before the machines it can see. The engine reports peers as one
            flat list with no mesh attached to any of them, so being in two meshes looked exactly
            like being in none, and a node that had not met a peer yet left the panel empty while it
            was plainly running.

            Read from what this install decided rather than from what the engine has noticed, so it
            is right the moment something is joined. Which mesh a peer belongs to is not reported and
            is not guessed at, which is why the two lists are separate rather than nested.
        -->
        <TextBlock DockPanel.Dock="Top" Style="{StaticResource SideBarHeader}" Text="CONNECTED TO" />

        <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding ConnectedMeshes}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <DockPanel Margin="14,3">
                        <Ellipse DockPanel.Dock="Left"
                                 Style="{StaticResource StateDot}"
                                 Width="6" Height="6"
                                 Margin="0,0,8,0"
                                 VerticalAlignment="Center"
                                 Fill="{Binding RowStateBrushKey, Converter={StaticResource BrushKey}}" />

                        <StackPanel>
                            <TextBlock Text="{Binding RowTitle}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Style="{StaticResource MonoText}"
                                       Foreground="{DynamicResource Text.Muted.Brush}"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding RowDetail}"
                                       Text="{Binding RowDetail}" />
                        </StackPanel>
                    </DockPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock DockPanel.Dock="Top"
                   Style="{StaticResource HintText}"
                   Margin="14,0,14,10"
                   TextWrapping="Wrap"
                   Text="Nothing. Start the node to host your own mesh, or join one."
                   Visibility="{Binding HasConnections, Converter={StaticResource BooleanToVisibility}, ConverterParameter=Invert}" />

        <TextBlock DockPanel.Dock="Top"
                   Style="{StaticResource SideBarHeader}"
                   Margin="0,10,0,0"
                   Text="MACHINES" />

        <TextBlock DockPanel.Dock="Top"
                   Style="{StaticResource HintText}"
                   Margin="14,0,14,10"
                   TextWrapping="Wrap"
                   Text="{Binding Mesh.EmptySourcesText}"
                   Visibility="{Binding Machines.Count, Converter={StaticResource CountToVisibility}, ConverterParameter=Invert}" />

        <ListBox ItemsSource="{Binding Machines}"
                 SelectedItem="{Binding SelectedSource}"
                 ItemContainerStyle="{StaticResource ListRow}"
                 Background="Transparent"
                 BorderThickness="0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <DockPanel Margin="0,3">
                        <Ellipse DockPanel.Dock="Left"
                                 Style="{StaticResource StateDot}"
                                 Margin="0,0,8,0"
                                 VerticalAlignment="Center"
                                 Fill="{Binding State, Converter={StaticResource ResourceLookup}, ConverterParameter=SourceState}" />

                        <StackPanel>
                            <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Style="{StaticResource MonoText}"
                                       Foreground="{DynamicResource Text.Muted.Brush}"
                                       TextTrimming="CharacterEllipsis"
                                       Text="{Binding CapabilityText}" />
                        </StackPanel>
                    </DockPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</UserControl>
