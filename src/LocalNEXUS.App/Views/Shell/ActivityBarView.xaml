<UserControl x:Class="LocalNEXUS.App.Views.Shell.ActivityBarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:LocalNEXUS.App.ViewModels"
             d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Width="48"
             Background="{DynamicResource Surface.Chrome.Brush}">

    <!--
        The activity bar. Two primary views and the settings gear, and each icon carries a dot for
        the thing behind it: the run for the Workspace, the mesh node for the Network.

        The dots are the rule about states in one place. A run that is going and a mesh that is
        still discovering peers both take the info colour, never the danger one, so the strip
        never says something broke while it is coming up.
    -->

    <DockPanel>

        <!-- Settings is not a section. It opens over whatever is showing and closes back onto it. -->
        <Button DockPanel.Dock="Bottom"
                Style="{StaticResource IconButton}"
                Width="48"
                Height="46"
                FontSize="16"
                Margin="0,0,0,6"
                Content="&#xE713;"
                ToolTip="Settings"
                AutomationProperties.Name="Settings"
                Command="{Binding OpenSettingsCommand}" />

        <!--
            The record of past runs, a window of its own for the same reason extensions is one:
            reading what went wrong last time while setting up the next attempt means having both
            on screen at once.
        -->
        <Button DockPanel.Dock="Bottom"
                Style="{StaticResource IconButton}"
                Width="48"
                Height="46"
                FontSize="16"
                Content="&#xE81C;"
                ToolTip="Run history: every run this project has had, and putting one back."
                AutomationProperties.Name="Run history"
                Command="{Binding OpenHistoryCommand}" />

        <!--
            Getting a model. It is here rather than in settings because somebody who has no model
            yet is the one person guaranteed not to go looking behind a gear for one, and because
            a download is a task that runs for minutes rather than a preference.
        -->
        <Button DockPanel.Dock="Bottom"
                Style="{StaticResource IconButton}"
                Width="48"
                Height="46"
                FontSize="16"
                Content="&#xE896;"
                ToolTip="Get a model: search Hugging Face, see what fits this machine, and download it."
                AutomationProperties.Name="Get a model"
                Command="{Binding OpenModelsCommand}" />

        <!--
            Extensions is a window of its own, opened from here and left open while the work
            carries on. It sits above the gear because it is a place rather than a setting.
        -->
        <Button DockPanel.Dock="Bottom"
                Style="{StaticResource IconButton}"
                Width="48"
                Height="46"
                FontSize="16"
                Content="&#xEA86;"
                ToolTip="Extensions: what this project adds to the application."
                AutomationProperties.Name="Extensions"
                Command="{Binding OpenExtensionsCommand}" />

        <StackPanel DockPanel.Dock="Top">

            <Grid ToolTip="Workspace: the canvas, its run outline and the node inspector.">
                <RadioButton Style="{StaticResource ActivityBarButton}"
                             GroupName="PrimarySection"
                             Content="&#xE8A9;"
                             AutomationProperties.Name="Workspace"
                             IsChecked="{Binding IsWorkspace, Mode=TwoWay}" />

                <!-- A badge on the corner of an icon, with no text to line up with. -->
                <Ellipse Style="{StaticResource StateDot}"
                         HorizontalAlignment="Right"
                         VerticalAlignment="Top"
                         Margin="0,9,7,0"
                         RenderTransform="{x:Null}"
                         Fill="{Binding Feed.RunState, Converter={StaticResource ResourceLookup}, ConverterParameter=RunState}" />
            </Grid>

            <!--
                The Spec tab, hidden until the extension that brings it is installed. Hidden rather
                than disabled: a greyed out tab promises that something happens if you find the
                right thing to click, and there is nothing behind this one until it is there.
            -->
            <Grid ToolTip="Spec: changes, their artifacts and what state each one is in."
                  Visibility="{Binding IsSpecAvailable, Converter={StaticResource BooleanToVisibility}}">
                <RadioButton Style="{StaticResource ActivityBarButton}"
                             GroupName="PrimarySection"
                             Content="&#xE8A5;"
                             AutomationProperties.Name="Spec"
                             IsChecked="{Binding IsSpec, Mode=TwoWay}" />
            </Grid>

            <Grid ToolTip="Network: what the mesh can serve, and what this machine contributes.">
                <RadioButton Style="{StaticResource ActivityBarButton}"
                             GroupName="PrimarySection"
                             Content="&#xE968;"
                             AutomationProperties.Name="Network"
                             IsChecked="{Binding IsNetwork, Mode=TwoWay}" />

                <!-- A badge on the corner of an icon, with no text to line up with. -->
                <Ellipse Style="{StaticResource StateDot}"
                         HorizontalAlignment="Right"
                         VerticalAlignment="Top"
                         Margin="0,9,7,0"
                         RenderTransform="{x:Null}"
                         Fill="{Binding Network.Mesh.State, Converter={StaticResource ResourceLookup}, ConverterParameter=MeshNodeState}" />
            </Grid>

        </StackPanel>

        <Border />
    </DockPanel>
</UserControl>
