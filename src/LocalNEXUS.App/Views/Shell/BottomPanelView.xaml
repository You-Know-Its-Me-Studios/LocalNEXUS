<UserControl x:Class="LocalNEXUS.App.Views.Shell.BottomPanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:LocalNEXUS.App.Infrastructure.Behaviors"
             xmlns:views="clr-namespace:LocalNEXUS.App.Views"
             xmlns:vm="clr-namespace:LocalNEXUS.App.ViewModels"
             d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Background="{DynamicResource Surface.Window.Brush}">

    <!--
        The bottom dock. Three tabs answering three different questions: what is wrong with the
        code now, what happened during the run, and what was written verbatim. Collapsing any two
        of them into one loses the reason somebody opened it.
    -->

    <DockPanel>

        <Border DockPanel.Dock="Top"
                Background="{DynamicResource Surface.Window.Brush}"
                BorderBrush="{DynamicResource Surface.Border.Brush}"
                BorderThickness="0,1,0,1">
            <Grid>
                <StackPanel Orientation="Horizontal">

                    <ToggleButton Style="{StaticResource PanelTab}"
                                  IsChecked="{Binding PanelTab, Converter={StaticResource EnumToBoolean}, ConverterParameter=Problems, Mode=OneWay}"
                                  Command="{Binding ShowPanelTabCommand}"
                                  CommandParameter="{x:Static vm:BottomPanelTab.Problems}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Problems" />
                            <TextBlock Style="{StaticResource CountText}"
                                       Text="{Binding Problems.Count}"
                                       Foreground="{DynamicResource Status.Danger.Brush}"
                                       Visibility="{Binding Problems.Count, Converter={StaticResource CountToVisibility}}" />
                            <TextBlock Style="{StaticResource CountText}"
                                       Text="0"
                                       Visibility="{Binding Problems.Count, Converter={StaticResource CountToVisibility}, ConverterParameter=Invert}" />
                        </StackPanel>
                    </ToggleButton>

                    <ToggleButton Style="{StaticResource PanelTab}"
                                  IsChecked="{Binding PanelTab, Converter={StaticResource EnumToBoolean}, ConverterParameter=Activity, Mode=OneWay}"
                                  Command="{Binding ShowPanelTabCommand}"
                                  CommandParameter="{x:Static vm:BottomPanelTab.Activity}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Activity" />
                            <TextBlock Style="{StaticResource CountText}" Text="{Binding Feed.Events.Count}" />
                        </StackPanel>
                    </ToggleButton>

                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,8,0">
                    <!--
                        What the Output tab was. Two buttons rather than a second copy of the same
                        events with every body already open.
                    -->
                    <Button Style="{StaticResource IconButton}"
                            Content="&#xE746;"
                            ToolTip="Open every entry"
                            AutomationProperties.Name="Open every entry"
                            Command="{Binding ExpandTranscriptCommand}"
                            Visibility="{Binding PanelTab, Converter={StaticResource EnumToVisibility}, ConverterParameter=Activity}" />

                    <Button Style="{StaticResource IconButton}"
                            Content="&#xE745;"
                            ToolTip="Close every entry"
                            AutomationProperties.Name="Close every entry"
                            Command="{Binding CollapseTranscriptCommand}"
                            Visibility="{Binding PanelTab, Converter={StaticResource EnumToVisibility}, ConverterParameter=Activity}" />

                    <Button Style="{StaticResource IconButton}"
                            Content="&#xE8C8;"
                            ToolTip="Copy everything in this panel"
                            AutomationProperties.Name="Copy this panel"
                            Command="{Binding CopyPanelCommand}" />

                    <Button Style="{StaticResource IconButton}"
                            Content="&#xE74D;"
                            ToolTip="Clear the transcript"
                            AutomationProperties.Name="Clear the transcript"
                            Command="{Binding Feed.ClearFeedCommand}" />

                    <Button Style="{StaticResource IconButton}"
                            Content="&#xE73F;"
                            ToolTip="Hide the panel"
                            AutomationProperties.Name="Hide the panel"
                            Command="{Binding TogglePanelCommand}" />
                </StackPanel>
            </Grid>
        </Border>

        <!--
            The three tabs are overlaid and switched by visibility rather than docked, because a
            dock panel gives its remaining space to one child and there are three here.
        -->
        <Grid>

        <!-- Problems -->
        <Grid Visibility="{Binding PanelTab, Converter={StaticResource EnumToVisibility}, ConverterParameter=Problems}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16,8">
                <ItemsControl ItemsSource="{Binding Problems.Problems}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                                           Style="{StaticResource MonoText}"
                                           Width="16"
                                           Text="{Binding SeverityGlyph}"
                                           Foreground="{Binding Severity, Converter={StaticResource ResourceLookup}, ConverterParameter=CompileSeverity}" />

                                <TextBlock Grid.Column="1"
                                           Style="{StaticResource MonoText}"
                                           Margin="0,0,10,0"
                                           FontWeight="SemiBold"
                                           Text="{Binding File}"
                                           ToolTip="{Binding NodeTitle}" />

                                <TextBlock Grid.Column="2"
                                           Style="{StaticResource MonoText}"
                                           Margin="0,0,10,0"
                                           Foreground="{DynamicResource Text.Muted.Brush}"
                                           Text="{Binding LocationText}" />

                                <TextBlock Grid.Column="3"
                                           Style="{StaticResource MonoText}"
                                           Margin="0,0,10,0"
                                           Foreground="{DynamicResource Text.Muted.Brush}"
                                           Text="{Binding Id}" />

                                <TextBox Grid.Column="4"
                                         Style="{StaticResource SelectableText}"
                                         TextWrapping="Wrap"
                                         Text="{Binding Message, Mode=OneWay}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <TextBlock HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       IsHitTestVisible="False"
                       Foreground="{DynamicResource Text.Muted.Brush}"
                       Text="No problems with the generated code."
                       Visibility="{Binding Problems.Count, Converter={StaticResource CountToVisibility}, ConverterParameter=Invert}" />
        </Grid>

        <!-- Activity -->
        <views:ActivityFeedView DataContext="{Binding Feed}"
                                Visibility="{Binding DataContext.PanelTab, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource EnumToVisibility}, ConverterParameter=Activity}" />

        </Grid>
    </DockPanel>
</UserControl>
