<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        The parts the shell is assembled from: the activity bar, the two kinds of tab, the rows
        that make up the side bar and the model table, and the small badges and pills that carry
        state.

        These are here rather than in Theme.xaml because they are this interface rather than the
        controls WPF ships. Nothing in this file names a colour.
    -->

    <!-- A square, quiet button that is only a glyph. Used for window controls and row actions. -->
    <Style x:Key="IconButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Text.Secondary.Brush}" />
        <Setter Property="FontFamily" Value="{StaticResource Font.Icons}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Width" Value="28" />
        <Setter Property="Height" Value="26" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="4">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Surface.Hover.Brush}" />
                            <Setter Property="Foreground" Value="{DynamicResource Text.Primary.Brush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.35" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        The strip down the inner edge of a side panel, carrying the chevron that collapses it.

        It is present whether the panel is open or shut, which is what leaves something to press
        when it is shut: a panel that disappears completely takes its own way back with it and
        reads as a fault rather than as having been put away. The chevron sits at the top, where
        the panel's own header is, so the control does not move when the panel goes.
    -->
    <Style x:Key="PanelStrip" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource Surface.Panel.Brush}" />
        <Setter Property="Foreground" Value="{DynamicResource Text.Muted.Brush}" />
        <Setter Property="FontFamily" Value="{StaticResource Font.Icons}" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="Width" Value="20" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root" Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Top"
                                          Margin="0,10,0,0" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Surface.Hover.Brush}" />
                            <Setter Property="Foreground" Value="{DynamicResource Text.Primary.Brush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Window controls. Close goes red on hover, the others take the ordinary hover. -->
    <Style x:Key="WindowButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
        <Setter Property="Width" Value="42" />
        <Setter Property="Height" Value="30" />
        <Setter Property="FontSize" Value="10" />
    </Style>

    <Style x:Key="WindowCloseButton" TargetType="Button" BasedOn="{StaticResource WindowButton}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root" Background="Transparent">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Status.Danger.Brush}" />
                            <Setter Property="Foreground" Value="{DynamicResource Text.Inverse.Brush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        The activity bar. The selected item carries an accent rule down its leading edge, which is
        the one piece of chrome that says where you are without reading anything.
    -->
    <Style x:Key="ActivityBarButton" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource Text.Muted.Brush}" />
        <Setter Property="FontFamily" Value="{StaticResource Font.Icons}" />
        <Setter Property="FontSize" Value="17" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid Width="48" Height="46" Background="Transparent">
                        <Rectangle x:Name="Rule"
                                   Width="2"
                                   HorizontalAlignment="Left"
                                   Fill="Transparent" />
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Rule" Property="Fill" Value="{DynamicResource Text.Primary.Brush}" />
                            <Setter Property="Foreground" Value="{DynamicResource Text.Primary.Brush}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource Text.Primary.Brush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Editor tabs. Flat, with an accent rule on top of the active one and a dirty dot. -->
    <Style x:Key="EditorTab" TargetType="ToggleButton">
        <Setter Property="Foreground" Value="{DynamicResource Text.Secondary.Brush}" />
        <Setter Property="FontSize" Value="{StaticResource Font.Size.Normal}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Root"
                            Background="{DynamicResource Surface.Panel.Brush}"
                            BorderBrush="{DynamicResource Surface.Border.Brush}"
                            BorderThickness="0,0,1,0">
                        <Grid>
                            <Rectangle x:Name="Rule"
                                       Height="1"
                                       VerticalAlignment="Top"
                                       Fill="Transparent" />
                            <ContentPresenter Margin="14,8" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Surface.Window.Brush}" />
                            <Setter TargetName="Rule" Property="Fill" Value="{DynamicResource Accent.Primary.Brush}" />
                            <Setter Property="Foreground" Value="{DynamicResource Text.Primary.Brush}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource Text.Primary.Brush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Bottom panel tabs. Underlined rather than filled, so the panel below reads as one surface. -->
    <Style x:Key="PanelTab" TargetType="ToggleButton">
        <Setter Property="Foreground" Value="{DynamicResource Text.Secondary.Brush}" />
        <Setter Property="FontSize" Value="{StaticResource Font.Size.Normal}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border Background="Transparent" Padding="14,7,14,0">
                        <StackPanel>
                            <ContentPresenter VerticalAlignment="Center" />
                            <Rectangle x:Name="Underline" Height="1" Margin="0,6,0,0" Fill="Transparent" />
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource Text.Primary.Brush}" />
                            <Setter TargetName="Underline" Property="Fill" Value="{DynamicResource Accent.Primary.Brush}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource Text.Primary.Brush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Side bar section headings. Small, spaced, and quiet. -->
    <Style x:Key="SideBarHeader" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Text.Muted.Brush}" />
        <Setter Property="FontSize" Value="{StaticResource Font.Size.Micro}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="14,12,14,8" />
    </Style>

    <!-- A full width row in a list: the run outline, the filter groups, the machines. -->
    <Style x:Key="ListRow" TargetType="ListBoxItem">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Padding" Value="14,4" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Root" Background="Transparent" Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Surface.Hover.Brush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Surface.Selected.Brush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        A row of the model table. The selected row takes an accent rule on its leading edge rather
        than a fill, because the row already carries a coverage bar and a status colour and a third
        block of colour behind them would drown both.
    -->
    <Style x:Key="TableRow" TargetType="ListBoxItem">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Root"
                            Background="Transparent"
                            BorderBrush="{DynamicResource Surface.Border.Brush}"
                            BorderThickness="0,0,0,1">
                        <Grid>
                            <Rectangle x:Name="Rule" Width="2" HorizontalAlignment="Left" Fill="Transparent" />
                            <ContentPresenter Margin="14,7" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Surface.Hover.Brush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Surface.Hover.Brush}" />
                            <Setter TargetName="Rule" Property="Fill" Value="{DynamicResource Accent.Primary.Brush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Sortable column headings. -->
    <Style x:Key="ColumnHeader" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Text.Muted.Brush}" />
        <Setter Property="FontFamily" Value="{StaticResource Font.Mono}" />
        <Setter Property="FontSize" Value="{StaticResource Font.Size.Micro}" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root" Background="Transparent" Padding="0,7">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource Text.Primary.Brush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A button that reads as a link, for the small actions inside a panel. -->
    <Style x:Key="LinkButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Accent.Primary.Brush}" />
        <Setter Property="FontSize" Value="{StaticResource Font.Size.Small}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="Transparent" Padding="0,2">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource Text.Primary.Brush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{DynamicResource Status.Danger.Brush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Status.Danger.Brush}" />
        <Setter Property="Foreground" Value="{DynamicResource Text.Inverse.Brush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="12,4" />
        <Setter Property="FontSize" Value="{StaticResource Font.Size.Small}" />
    </Style>

    <!--
        The switch used for offering this machine's compute. A switch rather than a check box
        because it turns something on in the world rather than ticking a preference.
    -->
    <Style x:Key="ToggleSwitch" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource Text.Primary.Brush}" />
        <Setter Property="FontSize" Value="{StaticResource Font.Size.Normal}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Border x:Name="Track"
                                Width="34" Height="18"
                                CornerRadius="9"
                                VerticalAlignment="Center"
                                Background="{DynamicResource Surface.Track.Brush}"
                                BorderBrush="{DynamicResource Surface.Border.Brush}"
                                BorderThickness="1">
                            <Ellipse x:Name="Knob"
                                     Width="12" Height="12"
                                     HorizontalAlignment="Left"
                                     Margin="3,0,0,0"
                                     Fill="{DynamicResource Text.Secondary.Brush}" />
                        </Border>
                        <ContentPresenter Margin="10,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource Accent.Primary.Brush}" />
                            <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource Accent.Primary.Brush}" />
                            <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                            <Setter TargetName="Knob" Property="Margin" Value="0,0,3,0" />
                            <Setter TargetName="Knob" Property="Fill" Value="{DynamicResource Text.Inverse.Brush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A small outlined label, used for a node type and for a quantization. -->
    <Style x:Key="Tag" TargetType="Border">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource Surface.Border.Brush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="3" />
        <Setter Property="Padding" Value="5,1" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="TagText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Text.Secondary.Brush}" />
        <Setter Property="FontFamily" Value="{StaticResource Font.Mono}" />
        <Setter Property="FontSize" Value="{StaticResource Font.Size.Micro}" />
    </Style>

    <!-- The count beside a panel tab or a filter row. -->
    <Style x:Key="CountText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Text.Muted.Brush}" />
        <Setter Property="FontSize" Value="{StaticResource Font.Size.Micro}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="6,0,0,0" />
    </Style>

    <!-- The bar down the leading edge of a node and of an inspector, coloured by node type. -->
    <Style x:Key="AccentBar" TargetType="Rectangle">
        <Setter Property="Width" Value="3" />
        <Setter Property="RadiusX" Value="1.5" />
        <Setter Property="RadiusY" Value="1.5" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
    </Style>

    <!-- The dot that carries a state. One shape, every state enum. -->
    <!--
        A state dot, sitting beside the label it belongs to.

        Centred on the row, and then a pixel lower again. The row is only as tall as the text,
        so centring puts the dot on the middle of the ink, and the ink of a mixed case word
        reaches higher than it looks: ascenders on d, l and a capital pull the top of the band
        up while nothing pulls the bottom down. The middle of that band therefore sits above
        the middle the eye reads, and a pixel is the difference at the sizes this is drawn at.

        A render transform rather than a margin, for two reasons. A margin set here loses to
        the margin nearly every one of these sets for its own spacing, and a render transform
        takes no part in layout, so the dot moves without anything beside it shifting to
        follow.
    -->
    <!--
        A state as a colour with the word inside it, for where a dot is too little and a sentence
        is too much. The colour comes from the same table the dots read, so a state added there is
        a badge here without anything else being written down.
    -->
    <Style x:Key="StateBadge" TargetType="Border">
        <Setter Property="CornerRadius" Value="3" />
        <Setter Property="Padding" Value="7,2" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="StateBadgeText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Text.Inverse.Brush}" />
        <Setter Property="FontSize" Value="{StaticResource Font.Size.Small}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="StateDot" TargetType="Ellipse">
        <Setter Property="Width" Value="7" />
        <Setter Property="Height" Value="7" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="RenderTransform">
            <Setter.Value>
                <TranslateTransform Y="1" />
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
