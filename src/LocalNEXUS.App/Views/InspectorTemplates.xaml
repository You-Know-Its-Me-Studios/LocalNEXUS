<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:distributed="clr-namespace:LocalNEXUS.App.Services.Distributed"
                    xmlns:net="clr-namespace:LocalNEXUS.App.ViewModels.Network">

    <!--
        What the one inspector slot shows when the Network has the selection. The Workspace half of
        the same slot is in SettingsTemplates.xaml, one template per node type; between them they
        are the whole of "what can I do about the selected thing".

        Coverage is a table rather than a chain of boxes. A chain looks like a pipeline, which is
        true, but the questions asked of it are which layers, held by whom, with how much slack,
        and those are columns. The uncovered row is the one that matters and it is named in red
        with the rest of the table intact around it, so the gap is read in context rather than as
        an error message on its own.
    -->

    <!-- A model the mesh knows about. -->
    <DataTemplate DataType="{x:Type distributed:NetworkServedModel}">
        <StackPanel>

            <TextBlock Style="{StaticResource HintText}"
                       Margin="0,0,0,10"
                       Foreground="{Binding Availability, Converter={StaticResource ResourceLookup}, ConverterParameter=ModelAvailability}"
                       Text="{Binding ChainStatusText}" />

            <TextBlock Style="{StaticResource SectionHeader}" Text="Coverage" />

            <Grid Margin="0,8,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="80" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="1" Style="{StaticResource MonoText}" Foreground="{DynamicResource Text.Muted.Brush}" Text="LAYERS" />
                <TextBlock Grid.Column="2" Style="{StaticResource MonoText}" Foreground="{DynamicResource Text.Muted.Brush}" Text="COVERED BY" />
                <TextBlock Grid.Column="3" Style="{StaticResource MonoText}" Foreground="{DynamicResource Text.Muted.Brush}" Text="BACKUPS" />
            </Grid>

            <!--
                Selecting a section hands the slot over to it, which is how an uncovered section
                becomes a panel about fixing that section rather than a red row somebody has to
                interpret.
            -->
            <ListBox ItemsSource="{Binding Plan.Assignments}"
                     SelectedItem="{Binding DataContext.Network.SelectedSection, RelativeSource={RelativeSource AncestorType=UserControl}}"
                     Background="Transparent"
                     BorderThickness="0">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource ListRow}">
                        <Setter Property="Padding" Value="0,5" />
                    </Style>
                </ListBox.ItemContainerStyle>

                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Ellipse Grid.Column="0"
                                     Style="{StaticResource StateDot}"
                                     HorizontalAlignment="Left"
                                     Fill="{Binding Coverage, Converter={StaticResource ResourceLookup}, ConverterParameter=SectionCoverage}" />

                            <TextBlock Grid.Column="1"
                                       Style="{StaticResource MonoText}"
                                       Text="{Binding Section.LayerRangeText}"
                                       TextTrimming="CharacterEllipsis" />

                            <!--
                                No tool tip. It carried the same sentence already printed directly
                                above the table, so hovering a row said nothing new and covered the
                                original while it did it.
                            -->
                            <TextBlock Grid.Column="2"
                                       Text="{Binding SourceText}"
                                       FontSize="{StaticResource Font.Size.Small}"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{Binding Coverage, Converter={StaticResource ResourceLookup}, ConverterParameter=SectionCoverage}" />

                            <TextBlock Grid.Column="3"
                                       Style="{StaticResource MonoText}"
                                       Text="{Binding SpareSources}"
                                       Foreground="{Binding Coverage, Converter={StaticResource ResourceLookup}, ConverterParameter=SectionCoverage}" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!--
                What a column means, beside the column, because a word nobody can define from
                looking at it is a word that needs saying. Spare was the word and it needed asking
                about, which is the answer to whether it was clear.
            -->
            <TextBlock Style="{StaticResource HintText}"
                       Margin="0,6,0,0"
                       TextWrapping="Wrap"
                       Text="Backups are just other machines that can take over if the one handling a section drops out. No throughput info from the mesh is provided, and only the size of meshes that show up in the directory are displayed. For everything else, the value reported by the mesh is used instead of trying to guess." />

            <TextBlock Style="{StaticResource HintText}"
                       Margin="0,6,0,0"
                       TextWrapping="Wrap"
                       Text="{Binding RequirementText}" />

            <TextBlock Style="{StaticResource HintText}"
                       Text="Read from the mesh." />
        </StackPanel>
    </DataTemplate>

    <!-- One machine in the mesh. -->
    <DataTemplate DataType="{x:Type distributed:InferenceSource}">
        <StackPanel>

            <TextBlock Style="{StaticResource HintText}"
                       Margin="0,0,0,10"
                       Text="Reported by the mesh. Nothing about another machine can be changed from here." />

            <TextBlock Style="{StaticResource FieldLabel}" Text="Peer key" />
            <TextBox Text="{Binding SourceId, Mode=OneWay}"
                     IsReadOnly="True"
                     FontFamily="{StaticResource Font.Mono}"
                     FontSize="{StaticResource Font.Size.Small}"
                     TextWrapping="Wrap" />
            <TextBlock Style="{StaticResource HintText}"
                       Text="This machine's permanent ID on the network." />

            <TextBlock Style="{StaticResource FieldLabel}" Text="What it brings" />
            <TextBlock Text="{Binding CapabilityText}" />

            <TextBlock Style="{StaticResource FieldLabel}" Text="Path to it" />
            <TextBlock Style="{StaticResource MonoText}" Text="{Binding EndpointText}" />

            <TextBlock Style="{StaticResource FieldLabel}" Text="Last seen" />
            <TextBlock Style="{StaticResource MonoText}" Text="{Binding LastSeenText}" />

            <TextBlock Style="{StaticResource FieldLabel}" Text="Engine version" />
            <TextBlock Style="{StaticResource MonoText}"
                       Text="{Binding Version, TargetNullValue=not reported}" />

            <TextBlock Style="{StaticResource FieldLabel}" Text="Trust" />
            <TextBlock Text="{Binding Trust}" />
            <TextBlock Style="{StaticResource HintText}"
                       Text="Everything in a private mesh was invited in, so all of it is trusted." />

            <!-- This machine is the one thing on this screen that is a form rather than a report. -->
            <StackPanel Visibility="{Binding IsThisMachine, Converter={StaticResource BooleanToVisibility}}">
                <Rectangle Height="1" Margin="0,16,0,4" Fill="{DynamicResource Surface.Border.Brush}" />

                <TextBlock Style="{StaticResource SectionHeader}" Margin="0,10,0,0" Text="What this machine offers" />

                <CheckBox Style="{StaticResource ToggleSwitch}"
                          Margin="0,10,0,0"
                          Content="Offer this machine's compute"
                          IsChecked="{Binding DataContext.Network.Contribute, RelativeSource={RelativeSource AncestorType=UserControl}}" />

                <TextBlock Style="{StaticResource FieldLabel}" Text="Memory cap, GB" />
                <TextBox Text="{Binding DataContext.Network.MaxVramGb, RelativeSource={RelativeSource AncestorType=UserControl}, UpdateSourceTrigger=LostFocus}" />

                <Button Style="{StaticResource SmallButton}"
                        Margin="0,12,0,0"
                        HorizontalAlignment="Left"
                        Content="Apply and restart the node"
                        Command="{Binding DataContext.Network.ApplySettingsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
            </StackPanel>
        </StackPanel>
    </DataTemplate>

    <!-- One section of a model, which is the panel for fixing a gap. -->
    <DataTemplate DataType="{x:Type distributed:SourceAssignment}">
        <StackPanel>

            <TextBlock Style="{StaticResource HintText}"
                       Margin="0,0,0,12"
                       Foreground="{Binding Coverage, Converter={StaticResource ResourceLookup}, ConverterParameter=SectionCoverage}"
                       Text="{Binding StatusDetail}" />

            <!-- The two things that would actually resolve a gap, and nothing that would not. -->
            <StackPanel Visibility="{Binding IsBlocking, Converter={StaticResource BooleanToVisibility}}">

                <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionHeader}" Text="Raise this machine's cap" />
                        <TextBlock Style="{StaticResource HintText}"
                                   Text="Raise the cap to let this machine take these layers." />

                        <TextBlock Style="{StaticResource FieldLabel}" Text="Memory cap, GB" />
                        <TextBox Text="{Binding DataContext.Network.MaxVramGb, RelativeSource={RelativeSource AncestorType=UserControl}, UpdateSourceTrigger=LostFocus}" />

                        <Button Style="{StaticResource PrimaryButton}"
                                Margin="0,10,0,0"
                                HorizontalAlignment="Left"
                                Content="Apply and restart the node"
                                Command="{Binding DataContext.Network.ApplySettingsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionHeader}" Text="Invite another machine" />
                        <TextBlock Style="{StaticResource HintText}"
                                   Text="Any machine with room can fill the gap." />

                        <Button Style="{StaticResource SmallButton}"
                                Margin="0,10,0,0"
                                HorizontalAlignment="Left"
                                Content="Copy invite token"
                                Command="{Binding DataContext.Network.CopyInviteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                    </StackPanel>
                </Border>

                <TextBlock Style="{StaticResource HintText}"
                           Text="The mesh does not report how much memory these layers need. It does report that no machine holds them." />
            </StackPanel>

            <!-- A section that is fine says what it is doing and offers nothing to do about it. -->
            <StackPanel Visibility="{Binding IsBlocking, Converter={StaticResource BooleanToVisibility}, ConverterParameter=Invert}">
                <TextBlock Style="{StaticResource FieldLabel}" Text="Covered by" />
                <TextBlock Text="{Binding SourceText}" />

                <TextBlock Style="{StaticResource FieldLabel}" Text="Backups" />
                <TextBlock Text="{Binding CoverageText}"
                           Foreground="{Binding Coverage, Converter={StaticResource ResourceLookup}, ConverterParameter=SectionCoverage}" />

                <TextBlock Style="{StaticResource HintText}"
                           TextWrapping="Wrap"
                           Text="Other machines with room to take these layers over. If the machine holding them goes away, the mesh moves the work to one of these without the model going down." />
            </StackPanel>
        </StackPanel>
    </DataTemplate>

    <!-- A mesh somebody else runs, which the directory listed and this install has not joined. -->
    <DataTemplate DataType="{x:Type distributed:DiscoveredMesh}">
        <StackPanel>

            <TextBlock Style="{StaticResource HintText}"
                       Margin="0,0,0,12"
                       TextWrapping="Wrap"
                       Text="You're looking at a mesh that's being hosted by someone else. The details here come from the person running it, so they're not something this machine can verify. If you want to actually use the mesh, you'll need to join it first." />

            <TextBlock Style="{StaticResource FieldLabel}" Text="Size" />
            <TextBlock TextWrapping="Wrap" Text="{Binding SizeSummary}" />

            <TextBlock Style="{StaticResource FieldLabel}" Text="Serving now" />
            <ItemsControl ItemsSource="{Binding Serving}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Style="{StaticResource MonoText}" TextTrimming="CharacterEllipsis" Text="{Binding}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Style="{StaticResource HintText}"
                       Text="Nothing loaded."
                       Visibility="{Binding Serving.Count, Converter={StaticResource CountToVisibility}, ConverterParameter=Invert}" />

            <!-- What it wants is what a machine joining it could actually contribute. -->
            <TextBlock Style="{StaticResource FieldLabel}" Text="Looking for" />
            <ItemsControl ItemsSource="{Binding Wanted}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Style="{StaticResource MonoText}"
                                   Foreground="{DynamicResource Text.Muted.Brush}"
                                   TextTrimming="CharacterEllipsis"
                                   Text="{Binding}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Style="{StaticResource HintText}"
                       TextWrapping="Wrap"
                       Text="Models it wants and does not have. If your machine holds one of these, joining fills a real gap rather than adding another spare." />

            <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionHeader}" Text="Join this mesh" />
                    <TextBlock Style="{StaticResource HintText}"
                               TextWrapping="Wrap"
                               Text="Gets an invite from the directory and restarts your node into this mesh. Your own mesh stops while you are in theirs, and Leave the mesh puts it back." />

                    <TextBlock Style="{StaticResource HintText}"
                               Margin="0,6,0,0"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource Status.Warning.Brush}"
                               Text="This mesh has not named itself, so the directory can only be asked for the best mesh serving the same model. That may not be this exact one."
                               Visibility="{Binding HasName, Converter={StaticResource BooleanToVisibility}, ConverterParameter=Invert}" />

                    <Button Style="{StaticResource PrimaryButton}"
                            Margin="0,10,0,0"
                            HorizontalAlignment="Left"
                            Content="Join"
                            Command="{Binding DataContext.Network.JoinDiscoveredCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </DataTemplate>

    <!-- One mesh this machine has joined, which is a membership rather than a thing to browse. -->
    <DataTemplate DataType="{x:Type distributed:JoinedMesh}">
        <StackPanel>

            <TextBlock Style="{StaticResource HintText}"
                       Margin="0,0,0,12"
                       TextWrapping="Wrap"
                       Foreground="{Binding State, Converter={StaticResource ResourceLookup}, ConverterParameter=JoinState}"
                       Text="{Binding StateDetail}" />

            <TextBlock Style="{StaticResource FieldLabel}" Text="Where it has got to" />
            <StackPanel Orientation="Horizontal">
                <Ellipse Style="{StaticResource StateDot}"
                         Margin="0,0,7,0"
                         Fill="{Binding State, Converter={StaticResource ResourceLookup}, ConverterParameter=JoinState}" />
                <TextBlock Text="{Binding StateText}"
                           Foreground="{Binding State, Converter={StaticResource ResourceLookup}, ConverterParameter=JoinState}" />
            </StackPanel>

            <TextBlock Style="{StaticResource FieldLabel}" Text="Mesh id" />
            <TextBox Style="{StaticResource SelectableText}"
                     FontFamily="{StaticResource Font.Mono}"
                     Text="{Binding ShortId, Mode=OneWay}" />

            <TextBlock Style="{StaticResource FieldLabel}" Text="Joined" />
            <TextBlock Text="{Binding JoinedText}" />

            <!--
                The invite is shown because it is how somebody else joins the same mesh, and it is
                theirs to pass on. Read only, because editing it here would be joining a different
                mesh under this one's name.
            -->
            <TextBlock Style="{StaticResource FieldLabel}" Text="Its invite" />
            <TextBox Style="{StaticResource MonoTextBox}"
                     Text="{Binding Token, Mode=OneWay}"
                     IsReadOnly="True"
                     MaxHeight="90"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto" />
            <TextBlock Style="{StaticResource HintText}"
                       Margin="0,4,0,0"
                       TextWrapping="Wrap"
                       Text="Pass this on and somebody else can join the same mesh." />

            <Button Style="{StaticResource SmallButton}"
                    Margin="0,14,0,0"
                    HorizontalAlignment="Left"
                    Content="Leave this mesh"
                    Command="{Binding DataContext.Network.LeaveJoinedCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    CommandParameter="{Binding}" />
        </StackPanel>
    </DataTemplate>

    <!-- The mesh this machine hosts, which is the one thing here somebody can change. -->
    <DataTemplate DataType="{x:Type net:HostedMeshRow}">
        <StackPanel>

            <TextBlock Style="{StaticResource HintText}"
                       Margin="0,0,0,12"
                       TextWrapping="Wrap"
                       Foreground="{Binding State, Converter={StaticResource ResourceLookup}, ConverterParameter=MeshNodeState}"
                       Text="{Binding StateDetail}" />

            <TextBlock Style="{StaticResource FieldLabel}" Text="Mesh id" />
            <TextBox Style="{StaticResource SelectableText}"
                     FontFamily="{StaticResource Font.Mono}"
                     Text="{Binding ShortId, Mode=OneWay}" />

            <TextBlock Style="{StaticResource FieldLabel}" Text="Who can find it" />
            <TextBlock Text="{Binding VisibilityText}" />
            <TextBlock Style="{StaticResource HintText}"
                       Margin="0,2,0,0"
                       TextWrapping="Wrap"
                       Text="Publishing is in the panel on the left. Off, only machines on this network can find it; on, it is listed publicly, though joining still needs the invite." />

            <TextBlock Style="{StaticResource FieldLabel}" Text="Members" />
            <TextBlock Text="{Binding MembersText}" />

            <TextBlock Style="{StaticResource FieldLabel}" Text="You are giving" />
            <TextBlock Text="{Binding SharingText}" TextWrapping="Wrap" />

            <!--
                The invite in full, because handing it to somebody is the whole point of hosting.
                Read only: it is minted by the engine and cannot be typed.
            -->
            <TextBlock Style="{StaticResource FieldLabel}" Text="The invite" />
            <TextBox Style="{StaticResource MonoTextBox}"
                     Text="{Binding InviteToken, Mode=OneWay}"
                     IsReadOnly="True"
                     MaxHeight="90"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     Visibility="{Binding HasInvite, Converter={StaticResource BooleanToVisibility}}" />

            <TextBlock Style="{StaticResource HintText}"
                       Margin="0,4,0,0"
                       TextWrapping="Wrap"
                       Text="Start the node and it creates one."
                       Visibility="{Binding HasInvite, Converter={StaticResource BooleanToVisibility}, ConverterParameter=Invert}" />

            <StackPanel Orientation="Horizontal"
                        Margin="0,12,0,0"
                        Visibility="{Binding HasInvite, Converter={StaticResource BooleanToVisibility}}">
                <Button Style="{StaticResource SmallButton}"
                        Content="Copy it"
                        Command="{Binding DataContext.Network.CopyInviteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />

                <Button Style="{StaticResource SmallButton}"
                        Margin="8,0,0,0"
                        Content="New invite"
                        ToolTip="Rotates this node's key, which makes every invite handed out so far stop working."
                        Command="{Binding DataContext.Network.RegenerateInviteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
            </StackPanel>
        </StackPanel>
    </DataTemplate>

</ResourceDictionary>
