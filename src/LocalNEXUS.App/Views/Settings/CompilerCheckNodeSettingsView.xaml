<UserControl x:Class="LocalNEXUS.App.Views.Settings.CompilerCheckNodeSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:nodes="clr-namespace:LocalNEXUS.App.Nodes"
             d:DataContext="{d:DesignInstance Type=nodes:CompilerCheckNode}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <StackPanel>

        <!--
            What it can reach, before anything runs. Under a partial set a type the project defines
            reads as a type that does not exist, and somebody who does not know that spends the
            whole retry limit on errors that were never in the code.
        -->
        <TextBlock Style="{StaticResource SectionHeader}" Text="What it can check against" />

        <Border Margin="0,6,0,0"
                Padding="10,8"
                CornerRadius="4"
                Background="{DynamicResource Surface.Window.Brush}"
                BorderThickness="1"
                BorderBrush="{DynamicResource Surface.Border.Brush}">
            <StackPanel>
                <TextBlock FontWeight="SemiBold"
                           TextWrapping="Wrap"
                           FontSize="{StaticResource Font.Size.Small}"
                           Text="{Binding ReachabilityText}" />

                <TextBlock Margin="0,4,0,0"
                           TextWrapping="Wrap"
                           FontSize="{StaticResource Font.Size.Small}"
                           Foreground="{DynamicResource Text.Secondary.Brush}"
                           Text="{Binding ReachabilityDetail}" />

                <TextBlock Margin="0,6,0,0"
                           TextWrapping="Wrap"
                           FontSize="{StaticResource Font.Size.Small}"
                           Foreground="{DynamicResource Status.Warning.Brush}"
                           Visibility="{Binding ReachabilityIsPartial, Converter={StaticResource BooleanToVisibility}}"
                           Text="The set is incomplete, so a type this project defines will read as a type that does not exist. Errors that a missing reference could explain are marked, and a check whose every error is one of those is reported as inconclusive rather than failed. Nothing is repaired on the strength of them." />
            </StackPanel>
        </Border>

        <TextBlock Style="{StaticResource SectionHeader}" Margin="0,20,0,0" Text="Repair" />

        <TextBlock Style="{StaticResource FieldLabel}" Text="Retry limit" />
        <TextBox Text="{Binding RetryLimit, UpdateSourceTrigger=LostFocus}" />
        <TextBlock Style="{StaticResource HintText}"
                   Text="How many times to ask the model to fix its own code. Each attempt is another model call." />

        <TextBlock Style="{StaticResource SectionHeader}" Margin="0,20,0,0" Text="When it still does not compile" />

        <StackPanel Margin="0,6,0,0">
            <RadioButton Content="Leave it for later and carry on"
                         GroupName="CompileFailure"
                         Margin="0,0,0,4"
                         IsChecked="{Binding FailureBehaviour, Converter={StaticResource EnumToBoolean}, ConverterParameter=StageForLater}" />
            <RadioButton Content="Fault the run"
                         GroupName="CompileFailure"
                         Margin="0,0,0,4"
                         IsChecked="{Binding FailureBehaviour, Converter={StaticResource EnumToBoolean}, ConverterParameter=FaultTheRun}" />
            <RadioButton Content="Continue with a warning"
                         GroupName="CompileFailure"
                         IsChecked="{Binding FailureBehaviour, Converter={StaticResource EnumToBoolean}, ConverterParameter=ContinueWithWarning}" />
        </StackPanel>

        <TextBlock Style="{StaticResource HintText}"
                   TextWrapping="Wrap"
                   Text="Leaving it for later stages the file with its errors, writes the ones that did compile, and runs the rest of the plan. Fault stops the run and writes nothing further. Continue sends the broken code on to be written anyway." />

        <TextBlock Style="{StaticResource SectionHeader}" Margin="0,20,0,0" Text="Last check" />

        <Border Margin="0,6,0,0"
                Padding="10,8"
                CornerRadius="4"
                Background="{DynamicResource Surface.Window.Brush}"
                BorderThickness="1"
                BorderBrush="{DynamicResource Surface.Border.Brush}">
            <StackPanel>
                <DockPanel>
                    <Ellipse DockPanel.Dock="Left"
                             Width="8"
                             Height="8"
                             Margin="0,0,8,0"
                             VerticalAlignment="Center"
                             Fill="{Binding Outcome, Converter={StaticResource ResourceLookup}, ConverterParameter=CompileOutcome}" />
                    <TextBlock VerticalAlignment="Center"
                               TextWrapping="Wrap"
                               FontSize="{StaticResource Font.Size.Small}"
                               Text="{Binding OutcomeText}" />
                </DockPanel>

                <!-- What it compiled against, because a pass against a partial reference set is a weaker claim. -->
                <TextBlock Margin="16,6,0,0"
                           TextWrapping="Wrap"
                           FontSize="{StaticResource Font.Size.Small}"
                           Foreground="{DynamicResource Text.Secondary.Brush}"
                           Text="{Binding ReferenceSummary}"
                           Visibility="{Binding ReferenceSummary, Converter={StaticResource StringToVisibility}}" />

                <TextBox Margin="16,8,0,0"
                         MaxHeight="220"
                         IsReadOnly="True"
                         Style="{StaticResource MonoTextBox}"
                         Text="{Binding LastDiagnostics, Mode=OneWay}"
                         Visibility="{Binding LastDiagnostics, Converter={StaticResource StringToVisibility}}" />
            </StackPanel>
        </Border>

        <TextBlock Style="{StaticResource HintText}"
                   Margin="0,10,0,0"
                   Text="Catches code that will not build, including a member the model invented on a type that does not have it. Put it between the model and the Output node; nothing is written until it passes." />
    </StackPanel>
</UserControl>
