<UserControl x:Class="LocalNEXUS.App.Views.Settings.ModelNodeSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:nodes="clr-namespace:LocalNEXUS.App.Nodes"
             d:DataContext="{d:DesignInstance Type=nodes:ModelNode}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <StackPanel>
        <TextBlock Style="{StaticResource SectionHeader}" Text="Provider" />
        <WrapPanel Margin="0,6,0,0">
            <RadioButton Content="Local"
                         GroupName="Provider"
                         IsChecked="{Binding Provider, Converter={StaticResource EnumToBoolean}, ConverterParameter=Local}" />
            <RadioButton Content="Network"
                         GroupName="Provider"
                         IsChecked="{Binding Provider, Converter={StaticResource EnumToBoolean}, ConverterParameter=Network}" />
            <RadioButton Content="Self hosted"
                         GroupName="Provider"
                         IsChecked="{Binding Provider, Converter={StaticResource EnumToBoolean}, ConverterParameter=SelfHosted}" />
            <RadioButton Content="OpenRouter"
                         GroupName="Provider"
                         IsChecked="{Binding Provider, Converter={StaticResource EnumToBoolean}, ConverterParameter=OpenRouter}" />
            <RadioButton Content="Cloud"
                         GroupName="Provider"
                         ToolTip="A hosted provider you have an account with."
                         IsChecked="{Binding Provider, Converter={StaticResource EnumToBoolean}, ConverterParameter=Cloud}" />
        </WrapPanel>

        <!-- Cloud provider selection -->
        <StackPanel Visibility="{Binding IsCloud, Converter={StaticResource BooleanToVisibility}}">
            <TextBlock Style="{StaticResource FieldLabel}" Text="Provider" />
            <ComboBox ItemsSource="{Binding AvailableProviders}"
                      DisplayMemberPath="DisplayName"
                      SelectedValuePath="Id"
                      SelectedValue="{Binding CloudProviderId}" />

            <TextBlock Style="{StaticResource HintText}" Text="{Binding ProviderStatus}" TextWrapping="Wrap" Margin="0,4,0,0" />

            <TextBlock Style="{StaticResource HintText}"
                       Margin="0,4,0,0"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource Status.Warning.Brush}"
                       Text="This provider has no key yet. Add one in Settings under API keys. The graph is fine; it just cannot run until there is a key."
                       Visibility="{Binding NeedsKey, Converter={StaticResource BooleanToVisibility}}" />

            <TextBlock Style="{StaticResource FieldLabel}" Text="Model id" />
            <TextBox Text="{Binding CloudModelId, UpdateSourceTrigger=PropertyChanged}"
                     FontFamily="{StaticResource Font.Mono}" />
            <TextBlock Style="{StaticResource HintText}"
                       TextWrapping="Wrap"
                       Text="Free text, because a provider serves many models. The rate shown above is for the one that provider is best known for, so a different model may cost more or less." />
        </StackPanel>

        <!-- Local model selection -->
        <StackPanel Visibility="{Binding IsLocal, Converter={StaticResource BooleanToVisibility}}">
            <TextBlock Style="{StaticResource FieldLabel}" Text="Local model" />
            <ComboBox ItemsSource="{Binding Catalog.Models}"
                      SelectedItem="{Binding SelectedLocalModel}">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <!-- Format is on the right as a label. It is information, not a choice. -->
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right"
                                       Margin="12,0,0,0"
                                       VerticalAlignment="Center"
                                       FontSize="{StaticResource Font.Size.Small}"
                                       Foreground="{DynamicResource Text.Secondary.Brush}"
                                       Text="{Binding FormatLabel}" />
                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                        </DockPanel>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>

            <TextBlock Style="{StaticResource HintText}"
                       Text="{Binding DataContext.Catalog.SearchSummary, RelativeSource={RelativeSource AncestorType=Window}}" />

            <WrapPanel Margin="0,8,0,0">
                <Button Style="{StaticResource SmallButton}"
                        Content="Add folder"
                        Margin="0,0,6,4"
                        Command="{Binding DataContext.Catalog.AddFolderCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                <Button Style="{StaticResource SmallButton}"
                        Content="Rescan"
                        Margin="0,0,6,4"
                        Command="{Binding DataContext.Catalog.RefreshCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                <Button Style="{StaticResource SmallButton}"
                        Margin="0,0,6,4"
                        Content="Open models folder"
                        Command="{Binding DataContext.Catalog.OpenModelsFolderCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                <Button Style="{StaticResource SmallButton}"
                        Margin="0,0,0,4"
                        Content="Edit model folders"
                        ToolTip="Opens model-paths.txt, one folder per line, scanned for both formats"
                        Command="{Binding DataContext.Catalog.EditModelPathsCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
            </WrapPanel>

            <!-- Which of the two selections this node actually runs, said plainly. -->
            <Border Margin="0,10,0,0"
                    Padding="10,8"
                    CornerRadius="4"
                    Background="{DynamicResource Surface.Window.Brush}"
                    BorderThickness="1">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="BorderBrush" Value="{DynamicResource Surface.Border.Brush}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsModelFileMissing}" Value="True">
                                <Setter Property="BorderBrush" Value="{DynamicResource Field.Error.Brush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <StackPanel>
                    <TextBlock TextWrapping="Wrap"
                               FontSize="{StaticResource Font.Size.Small}"
                               Text="{Binding ModelSourceText}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                <Setter Property="Foreground" Value="{DynamicResource Text.Secondary.Brush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsModelFileMissing}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource Field.Error.Brush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- The full path is on the tooltip, because the panel is too narrow for most of them. -->
                    <TextBlock Margin="0,6,0,0"
                               FontFamily="{StaticResource Font.Mono}"
                               FontSize="{StaticResource Font.Size.Small}"
                               TextTrimming="CharacterEllipsis"
                               Text="{Binding ModelFilePath}"
                               ToolTip="{Binding ModelFilePath}"
                               Visibility="{Binding HasModelFile, Converter={StaticResource BooleanToVisibility}}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                <Setter Property="Foreground" Value="{DynamicResource Text.Primary.Brush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsModelFileMissing}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource Field.Error.Brush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <WrapPanel Margin="0,8,0,0">
                        <Button Style="{StaticResource SmallButton}"
                                Margin="0,0,6,4"
                                Content="Browse for a file"
                                ToolTip="Run a GGUF from anywhere on disk for this node only, without adding its folder to the catalogue"
                                Command="{Binding BrowseForModelFileCommand}" />
                        <Button Style="{StaticResource SmallButton}"
                                Margin="0,0,6,4"
                                Content="Browse for a folder"
                                ToolTip="A safetensors model is a folder holding config.json beside its weight files, so it is picked as a folder"
                                Command="{Binding BrowseForModelFolderCommand}" />
                        <Button Style="{StaticResource SmallButton}"
                                       Content="Use the catalogue"
                                ToolTip="Drop this node's own model and go back to the selection above"
                                Command="{Binding ClearModelFileCommand}" />
                    </WrapPanel>
                </StackPanel>
            </Border>

            <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Style="{StaticResource FieldLabel}" Margin="0,0,0,4" Text="Context size" />
                    <TextBox Text="{Binding ContextSize, UpdateSourceTrigger=LostFocus}" />
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Style="{StaticResource FieldLabel}" Margin="0,0,0,4" Text="GPU layers" />
                    <TextBox Text="{Binding GpuLayers, UpdateSourceTrigger=LostFocus}" />
                </StackPanel>
            </Grid>
            <TextBlock Style="{StaticResource HintText}"
                       Text="999 puts every layer on the GPU." />

            <!--
                What the server actually has, beside what is asked of it. Both are fixed when the
                model loads, because llama-server allocates its key and value cache at start and
                nothing said to it afterwards moves that, so the two can differ for as long as it
                takes to run again. A difference nobody can see is one somebody meets as a refusal
                naming a context they thought they had changed.
            -->
            <!--
                The badge answers what it is doing and the line under it answers with what. A
                colour is read at a glance and a sentence is not, and the numbers are the part a
                badge has no room for.
            -->
            <DockPanel Margin="0,8,0,0">
                <Button DockPanel.Dock="Right"
                        Style="{StaticResource SmallButton}"
                        Margin="6,0,0,0"
                        Content="Refresh"
                        ToolTip="Reads what the running server has again"
                        Command="{Binding RefreshLoadedCommand}" />

                <Border Style="{StaticResource StateBadge}"
                        Background="{Binding LoadState, Converter={StaticResource ResourceLookup}, ConverterParameter=LocalModelState}">
                    <TextBlock Style="{StaticResource StateBadgeText}" Text="{Binding LoadStateText}" />
                </Border>
            </DockPanel>

            <TextBlock Style="{StaticResource HintText}"
                       Margin="0,4,0,0"
                       TextWrapping="Wrap"
                       Text="{Binding LoadedText}" />

            <TextBlock Style="{StaticResource HintText}"
                       Margin="0,4,0,0"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource Field.Error.Brush}"
                       Text="These take effect when the model loads. The next run stops the running server and starts it again with these values."
                       Visibility="{Binding HasLoadDrift, Converter={StaticResource BooleanToVisibility}}" />

            <TextBlock Style="{StaticResource HintText}"
                       Margin="0,10,0,0"
                       Text="Runs on this machine alone. To use several machines, switch to the network provider." />

            <!--
                The Python runtime, which is what serves safetensors models. Shown always rather
                than only when something is wrong, because it is set up in the background on
                first launch and a person watching for it should be able to find it.
            -->
            <TextBlock Style="{StaticResource SectionHeader}" Margin="0,20,0,0" Text="Python runtime" />

            <Border Margin="0,6,0,0"
                    Padding="10,8"
                    CornerRadius="4"
                    Background="{DynamicResource Surface.Window.Brush}"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource Surface.Border.Brush}"
                    DataContext="{Binding DataContext.PythonEnvironment, RelativeSource={RelativeSource AncestorType=Window}}">
                <StackPanel>
                    <DockPanel>
                        <Ellipse DockPanel.Dock="Left"
                                 Width="8"
                                 Height="8"
                                 Margin="0,0,8,0"
                                 VerticalAlignment="Center"
                                 Fill="{Binding Environment.State, Converter={StaticResource ResourceLookup}, ConverterParameter=PythonEnvironmentState}" />
                        <TextBlock VerticalAlignment="Center"
                                   TextWrapping="Wrap"
                                   FontSize="{StaticResource Font.Size.Small}"
                                   Text="{Binding Environment.StatusText}" />
                    </DockPanel>

                    <TextBlock Margin="16,6,0,0"
                               TextWrapping="Wrap"
                               FontSize="{StaticResource Font.Size.Small}"
                               Foreground="{DynamicResource Text.Secondary.Brush}"
                               Text="{Binding Environment.Stage}" />

                    <TextBlock Margin="16,4,0,0"
                               FontFamily="{StaticResource Font.Mono}"
                               FontSize="{StaticResource Font.Size.Small}"
                               Foreground="{DynamicResource Text.Secondary.Brush}"
                               TextTrimming="CharacterEllipsis"
                               Text="{Binding Environment.Detail}"
                               ToolTip="{Binding Environment.Detail}"
                               Visibility="{Binding Environment.Detail, Converter={StaticResource StringToVisibility}}" />

                    <TextBlock Margin="16,6,0,0"
                               TextWrapping="Wrap"
                               FontSize="{StaticResource Font.Size.Small}"
                               Foreground="{DynamicResource Field.Error.Brush}"
                               Text="{Binding Environment.LastError}"
                               Visibility="{Binding Environment.LastError, Converter={StaticResource StringToVisibility}}" />

                    <TextBlock Margin="16,6,0,0"
                               TextWrapping="Wrap"
                               FontSize="{StaticResource Font.Size.Small}"
                               Foreground="{DynamicResource Text.Secondary.Brush}"
                               Text="{Binding Environment.AcceleratorSummary}"
                               Visibility="{Binding Environment.AcceleratorSummary, Converter={StaticResource StringToVisibility}}" />

                    <WrapPanel Margin="16,8,0,0">
                        <Button Style="{StaticResource SmallButton}"
                                Margin="0,0,6,4"
                                Content="Repair"
                                ToolTip="Builds whatever is missing, reusing everything already downloaded"
                                Command="{Binding RepairCommand}" />
                        <Button Style="{StaticResource SmallButton}"
                                Margin="0,0,6,4"
                                Content="Set up again"
                                ToolTip="Deletes the environment and builds it from the cached downloads"
                                Command="{Binding ResetCommand}" />
                        <Button Style="{StaticResource SmallButton}"
                                       Content="Open runtime folder"
                                Command="{Binding OpenFolderCommand}" />
                    </WrapPanel>
                </StackPanel>
            </Border>

            <TextBlock Style="{StaticResource HintText}"
                       Text="Sets itself up in the background. GGUF models work while it does." />
        </StackPanel>

        <!-- Network served model -->
        <StackPanel Visibility="{Binding IsNetwork, Converter={StaticResource BooleanToVisibility}}">
            <TextBlock Style="{StaticResource FieldLabel}" Text="Network model" />
            <ComboBox ItemsSource="{Binding Mesh.Models}"
                      SelectedItem="{Binding SelectedNetworkModel}">
                <ComboBox.ItemContainerStyle>
                    <Style TargetType="ComboBoxItem" BasedOn="{StaticResource {x:Type ComboBoxItem}}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CanRun}" Value="False">
                                <Setter Property="IsEnabled" Value="False" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ComboBox.ItemContainerStyle>
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right"
                                       Margin="12,0,0,0"
                                       VerticalAlignment="Center"
                                       FontSize="{StaticResource Font.Size.Small}"
                                       Text="{Binding StatusText}"
                                       Foreground="{Binding Strength, Converter={StaticResource ResourceLookup}, ConverterParameter=SectionCoverage}" />
                            <TextBlock Text="{Binding DisplayLabel}" VerticalAlignment="Center" />
                        </DockPanel>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <TextBlock Style="{StaticResource HintText}"
                       Text="Models the network can serve right now. A model that is starting or blocked cannot be picked; the Network tab shows what it is waiting on." />
        </StackPanel>

        <!-- Self hosted server -->
        <StackPanel Visibility="{Binding IsSelfHosted, Converter={StaticResource BooleanToVisibility}}">
            <TextBlock Style="{StaticResource FieldLabel}" Text="Model id" />
            <TextBox Text="{Binding SelfHostedModelId, UpdateSourceTrigger=PropertyChanged}"
                     FontFamily="{StaticResource Font.Mono}" />
            <TextBlock Style="{StaticResource HintText}"
                       Text="The model name your server expects. Set its address under Endpoint." />

            <TextBlock Style="{StaticResource FieldLabel}" Text="API key (optional)" />
            <TextBox Text="{Binding ApiKey, UpdateSourceTrigger=PropertyChanged}"
                     FontFamily="{StaticResource Font.Mono}" />
            <TextBlock Style="{StaticResource HintText}"
                       Text="Only if your server needs one. Stored in plain text in the graph file." />
        </StackPanel>

        <!-- OpenRouter model selection -->
        <StackPanel Visibility="{Binding IsOpenRouter, Converter={StaticResource BooleanToVisibility}}">
            <TextBlock Style="{StaticResource FieldLabel}" Text="OpenRouter model slug" />
            <TextBox Text="{Binding OpenRouterModel, UpdateSourceTrigger=PropertyChanged}"
                     FontFamily="{StaticResource Font.Mono}" />
            <TextBlock Style="{StaticResource HintText}"
                       Text="For example anthropic/claude-sonnet-4 or meta-llama/llama-3.3-70b-instruct" />

            <TextBlock Style="{StaticResource FieldLabel}" Text="API key" />
            <TextBox Text="{Binding ApiKey, UpdateSourceTrigger=PropertyChanged}"
                     FontFamily="{StaticResource Font.Mono}" />
            <TextBlock Style="{StaticResource HintText}"
                       Text="Stored in plain text in the graph file, so take it out before sharing one." />
        </StackPanel>

        <TextBlock Style="{StaticResource SectionHeader}" Margin="0,20,0,0" Text="Prompt" />

        <TextBlock Style="{StaticResource FieldLabel}" Text="System prompt" />
        <TextBox Style="{StaticResource MonoTextBox}"
                 Text="{Binding SystemPrompt, UpdateSourceTrigger=PropertyChanged}"
                 MinHeight="120"
                 MaxHeight="260" />

        <!--
            Said out loud for the same reason the scripts folder says it. A value that arrives from
            somewhere else and then stops following it is the sort of thing somebody changes once,
            expects to apply everywhere, and never finds out did not.
        -->
        <TextBlock Style="{StaticResource HintText}"
                   TextWrapping="Wrap"
                   Text="Set from the project kind when the node was added. Changing it here affects this node only." />

        <!--
            On by default, because a model asked for a file wraps it in a fence whatever the prompt
            says. It used to take a node wired into every graph to undo that.
        -->
        <CheckBox Content="Take a markdown code fence off the reply"
                  Margin="0,10,0,0"
                  IsChecked="{Binding StripCodeFences}" />

        <TextBlock Style="{StaticResource HintText}"
                   TextWrapping="Wrap"
                   Text="Only when the whole reply is one fenced block, so an explanation with code in it is left alone. Turn it off for a model that is meant to produce prose, a plan, or documentation that keeps its code blocks." />

        <TextBlock Style="{StaticResource SectionHeader}" Margin="0,20,0,0" Text="Edits" />

        <StackPanel Margin="0,6,0,0">
            <RadioButton Content="Automatic"
                         GroupName="EditFormat"
                         IsChecked="{Binding EditFormat, Converter={StaticResource EnumToBoolean}, ConverterParameter=Automatic}" />
            <RadioButton Content="Always the whole file"
                         GroupName="EditFormat"
                         IsChecked="{Binding EditFormat, Converter={StaticResource EnumToBoolean}, ConverterParameter=WholeFile}" />
            <RadioButton Content="Always a diff"
                         GroupName="EditFormat"
                         IsChecked="{Binding EditFormat, Converter={StaticResource EnumToBoolean}, ConverterParameter=LineTaggedDiff}" />
        </StackPanel>

        <TextBlock Style="{StaticResource HintText}"
                   Text="How this node asks for a change to a file. Automatic suits most models." />

        <TextBlock Style="{StaticResource SectionHeader}" Margin="0,20,0,0" Text="Sampling" />

        <Grid Margin="0,6,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Style="{StaticResource FieldLabel}" Margin="0,0,0,4" Text="Temperature" />
                <TextBox Text="{Binding Temperature, UpdateSourceTrigger=LostFocus}" />
            </StackPanel>

            <StackPanel Grid.Column="2">
                <TextBlock Style="{StaticResource FieldLabel}" Margin="0,0,0,4" Text="Max tokens" />
                <TextBox Text="{Binding MaxTokens, UpdateSourceTrigger=LostFocus}" />
            </StackPanel>
        </Grid>

        <TextBlock Style="{StaticResource SectionHeader}" Margin="0,20,0,0" Text="Endpoint" />

        <TextBlock Style="{StaticResource FieldLabel}" Text="Base URL" />
        <TextBox Text="{Binding BaseUrl, UpdateSourceTrigger=PropertyChanged}"
                 FontFamily="{StaticResource Font.Mono}" />
        <TextBlock Style="{StaticResource HintText}"
                   Text="Leave blank to let LocalNEXUS run the model. Set it to use a server that is already running." />

        <!--
            What this model may reach for. Nothing is selected until somebody selects it: a model
            that suddenly gains three hundred tools because an extension was installed is a
            surprise, and a run quietly spending its context on schemas nobody asked for is worse.
        -->
        <TextBlock Style="{StaticResource SectionHeader}" Margin="0,20,0,0" Text="Tools" />

        <DockPanel Margin="0,2,0,0">
            <Button DockPanel.Dock="Right"
                    Style="{StaticResource SmallButton}"
                    Margin="6,0,0,0"
                    Content="Refresh"
                    ToolTip="Reads what this project has installed again"
                    Command="{Binding RefreshToolExtensionsCommand}" />

            <TextBlock Style="{StaticResource HintText}"
                       VerticalAlignment="Center"
                       TextWrapping="Wrap"
                       Text="{Binding ToolCostText}" />
        </DockPanel>

        <!-- Said before a run, because a run that discovers it has already spent the context. -->
        <DockPanel Margin="0,8,0,0">
            <Button DockPanel.Dock="Right"
                    Style="{StaticResource SmallButton}"
                    Margin="6,0,0,0"
                    Content="Check support"
                    ToolTip="Gives the model one small tool and sees whether it actually calls it. The model has to be loaded."
                    Command="{Binding CheckToolSupportCommand}" />

            <TextBlock Style="{StaticResource HintText}"
                       VerticalAlignment="Center"
                       TextWrapping="Wrap"
                       Text="{Binding ToolSupportText}" />
        </DockPanel>

        <ItemsControl ItemsSource="{Binding ToolExtensions}" Margin="0,8,0,0">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="0,0,0,8">
                        <DockPanel>
                            <Button DockPanel.Dock="Right"
                                    Style="{StaticResource SmallButton}"
                                    Margin="6,0,0,0"
                                    Content="List tools"
                                    IsEnabled="{Binding IsUsable}"
                                    Command="{Binding DataContext.ListToolsCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding}" />

                            <CheckBox IsChecked="{Binding IsSelected}"
                                      IsEnabled="{Binding IsUsable}"
                                      VerticalAlignment="Center"
                                      Content="{Binding Name}" />
                        </DockPanel>

                        <TextBlock Style="{StaticResource HintText}"
                                   Margin="22,2,0,0"
                                   TextWrapping="Wrap"
                                   Text="{Binding Summary}" />

                        <!--
                            Narrowing, which is a convenience rather than a requirement. Everything
                            ticked is what an unnarrowed extension does, and the moment one is
                            unticked the rest are written down.
                        -->
                        <Expander Margin="22,4,0,0"
                                  Header="Choose tools"
                                  Visibility="{Binding HasTools, Converter={StaticResource BooleanToVisibility}}">
                            <ItemsControl ItemsSource="{Binding Tools}" Margin="0,4,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox Margin="0,0,0,2"
                                                  IsChecked="{Binding IsSelected}"
                                                  ToolTip="{Binding Description}">
                                            <TextBlock Style="{StaticResource MonoText}" Text="{Binding Name}" />
                                        </CheckBox>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Expander>
                    </StackPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock Style="{StaticResource FieldLabel}" Margin="0,6,0,0" Text="Tool calls per run" />
        <TextBox Text="{Binding MaxToolCalls, UpdateSourceTrigger=LostFocus}"
                 ToolTip="How many times this node may call a tool before it has to answer without one" />

        <TextBlock Style="{StaticResource HintText}"
                   Margin="0,4,0,0"
                   TextWrapping="Wrap"
                   Text="Extensions are per project, so this is what this project has installed. Every call is written to the feed with its arguments and result, and a tool that fails comes back to the model as an error rather than stopping the run." />
    </StackPanel>
</UserControl>
