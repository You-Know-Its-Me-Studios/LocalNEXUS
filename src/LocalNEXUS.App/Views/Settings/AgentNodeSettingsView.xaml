<UserControl x:Class="LocalNEXUS.App.Views.Settings.AgentNodeSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:nodes="clr-namespace:LocalNEXUS.App.Nodes"
             d:DataContext="{d:DesignInstance Type=nodes:AgentNode}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <!--
        Almost nothing to configure, which is the point. The model, the extensions and the search
        key all come from the Model node wired into it, so what is left is how long it may run for
        and how it is told to work.
    -->

    <StackPanel>

        <!--
            First thing in the panel, and a bordered callout rather than a coloured hint, because
            this is the one failure in the application that looks like success. A model that cannot
            emit a tool call does not refuse: it writes out what it would have done and the loop
            reports finished. Somebody has to see this before they press Run, not after.
        -->
        <Border Margin="0,0,0,14"
                Padding="10,8"
                CornerRadius="3"
                BorderThickness="1"
                Visibility="{Binding HasToolWarning, Converter={StaticResource BooleanToVisibility}}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="BorderBrush" Value="{DynamicResource Status.Warning.Brush}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsToolWarningSevere}" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource Status.Danger.Brush}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <DockPanel>
                <TextBlock DockPanel.Dock="Left"
                           Margin="0,0,8,0"
                           VerticalAlignment="Top"
                           FontFamily="{StaticResource Font.Icons}"
                           Text="&#xE7BA;">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource Status.Warning.Brush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsToolWarningSevere}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource Status.Danger.Brush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <TextBlock TextWrapping="Wrap" Text="{Binding ToolWarning}" />
            </DockPanel>
        </Border>

        <TextBlock Style="{StaticResource HintText}"
                   TextWrapping="Wrap"
                   Text="Wire a Model node into the Model pin and type a request. It works out the steps itself: reading and writing files, compiling, searching the project, and using whatever tools that Model node has selected. Writes go through the same project rules the Output node uses." />

        <TextBlock Style="{StaticResource SectionHeader}" Margin="0,20,0,0" Text="Limit" />

        <TextBlock Style="{StaticResource FieldLabel}" Text="Turns" />
        <TextBox Text="{Binding MaxTurns, UpdateSourceTrigger=LostFocus}"
                 ToolTip="One turn is one model call and the tools it asked for" />
        <TextBlock Style="{StaticResource HintText}"
                   TextWrapping="Wrap"
                   Text="The budget for the whole task, not per file. If it runs out, anything already written stays written and the run reports where it stopped." />

        <TextBlock Style="{StaticResource SectionHeader}" Margin="0,20,0,0" Text="Prompt" />

        <TextBlock Style="{StaticResource FieldLabel}" Text="System prompt" />
        <TextBox Style="{StaticResource MonoTextBox}"
                 Text="{Binding SystemPrompt, UpdateSourceTrigger=PropertyChanged}"
                 MinHeight="140"
                 MaxHeight="300" />
        <TextBlock Style="{StaticResource HintText}"
                   TextWrapping="Wrap"
                   Text="How this agent is told to work. What each tool does is described on the tool, so this only covers how to go about the job." />
    </StackPanel>
</UserControl>
