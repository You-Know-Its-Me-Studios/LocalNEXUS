<UserControl x:Class="LocalNEXUS.App.Views.Settings.AgentNodeSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:nodes="clr-namespace:LocalNEXUS.App.Nodes"
             d:DataContext="{d:DesignInstance Type=nodes:AgentNode}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <!--
        Almost nothing to configure, which is the point. The model, the extensions and the search
        key all come from the Model node wired into it, so what is left is how long it may run for
        and how it is told to work.
    -->

    <StackPanel>
        <TextBlock Style="{StaticResource HintText}"
                   TextWrapping="Wrap"
                   Text="Wire a Model node into the Model pin and type a request. It works out the steps itself: reading and writing files, compiling, searching the project, and using whatever tools that Model node has selected. Writes go through the same project rules the Output node uses." />

        <TextBlock Style="{StaticResource SectionHeader}" Margin="0,20,0,0" Text="Limit" />

        <TextBlock Style="{StaticResource FieldLabel}" Text="Turns" />
        <TextBox Text="{Binding MaxTurns, UpdateSourceTrigger=LostFocus}"
                 ToolTip="One turn is one model call and the tools it asked for" />
        <TextBlock Style="{StaticResource HintText}"
                   TextWrapping="Wrap"
                   Text="The budget for the whole task, not per file. If it runs out, anything already written stays written and the run reports where it stopped." />

        <TextBlock Style="{StaticResource SectionHeader}" Margin="0,20,0,0" Text="Prompt" />

        <TextBlock Style="{StaticResource FieldLabel}" Text="System prompt" />
        <TextBox Style="{StaticResource MonoTextBox}"
                 Text="{Binding SystemPrompt, UpdateSourceTrigger=PropertyChanged}"
                 MinHeight="140"
                 MaxHeight="300" />
        <TextBlock Style="{StaticResource HintText}"
                   TextWrapping="Wrap"
                   Text="How this agent is told to work. What each tool does is described on the tool, so this only covers how to go about the job." />
    </StackPanel>
</UserControl>
