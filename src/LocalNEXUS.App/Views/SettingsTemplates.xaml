<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:nodes="clr-namespace:LocalNEXUS.App.Nodes"
                    xmlns:settings="clr-namespace:LocalNEXUS.App.Views.Settings">

    <!--
        Typed settings panels. The right hand panel is a content control bound to the selected
        node, so WPF picks the matching panel by the node's own type. Adding a node type means
        adding its view and one entry here.
    -->

    <DataTemplate DataType="{x:Type nodes:PromptNode}">
        <settings:PromptNodeSettingsView />
    </DataTemplate>

    <DataTemplate DataType="{x:Type nodes:TriageNode}">
        <settings:TriageNodeSettingsView />
    </DataTemplate>

    <DataTemplate DataType="{x:Type nodes:AgentNode}">
        <settings:AgentNodeSettingsView />
    </DataTemplate>

    <DataTemplate DataType="{x:Type nodes:TextOutputNode}">
        <settings:TextOutputNodeSettingsView />
    </DataTemplate>

    <DataTemplate DataType="{x:Type nodes:ModelNode}">
        <settings:ModelNodeSettingsView />
    </DataTemplate>

    <DataTemplate DataType="{x:Type nodes:DebateNode}">
        <settings:DebateNodeSettingsView />
    </DataTemplate>

    <DataTemplate DataType="{x:Type nodes:JudgeNode}">
        <settings:JudgeNodeSettingsView />
    </DataTemplate>

    <DataTemplate DataType="{x:Type nodes:LoopNode}">
        <settings:LoopNodeSettingsView />
    </DataTemplate>

    <DataTemplate DataType="{x:Type nodes:ReshapeNode}">
        <settings:ReshapeNodeSettingsView />
    </DataTemplate>

    <DataTemplate DataType="{x:Type nodes:CompilerCheckNode}">
        <settings:CompilerCheckNodeSettingsView />
    </DataTemplate>

    <DataTemplate DataType="{x:Type nodes:OutputNode}">
        <settings:OutputNodeSettingsView />
    </DataTemplate>

</ResourceDictionary>
