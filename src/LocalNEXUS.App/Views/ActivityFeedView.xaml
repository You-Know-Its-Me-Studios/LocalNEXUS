<UserControl x:Class="LocalNEXUS.App.Views.ActivityFeedView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:LocalNEXUS.App.Infrastructure.Behaviors"
             xmlns:vm="clr-namespace:LocalNEXUS.App.ViewModels"
             d:DataContext="{d:DesignInstance Type=vm:ActivityFeedViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <!--
        The run transcript. The request box and the run controls used to sit above this; they now
        live in the shell, because the chat box belongs to the window rather than to one tab of the
        bottom panel and typing the next request should not mean going and finding the right tab.
    -->

    <Grid>
        <ScrollViewer behaviors:AutoScrollBehavior.IsEnabled="True"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="16,8">
            <ItemsControl ItemsSource="{Binding Events}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,0,0,7">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0"
                                       Style="{StaticResource MonoText}"
                                       Text="{Binding TimeText}"
                                       Foreground="{DynamicResource Text.Muted.Brush}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,10,0" />

                            <Ellipse Grid.Row="0" Grid.Column="1"
                                     Style="{StaticResource StateDot}"
                                     Margin="0,0,10,0"
                                     Fill="{Binding Kind, Converter={StaticResource ResourceLookup}, ConverterParameter=Activity}" />

                            <DockPanel Grid.Row="0" Grid.Column="2">

                                <!-- How much a file changed, when the entry is about a file. -->
                                <StackPanel DockPanel.Dock="Right"
                                            Orientation="Horizontal"
                                            Margin="10,0,0,0"
                                            Visibility="{Binding HasDiffCounts, Converter={StaticResource BooleanToVisibility}}">
                                    <TextBlock Style="{StaticResource MonoText}"
                                               Foreground="{DynamicResource Diff.Added.Brush}"
                                               Text="{Binding AddedText}" />
                                    <TextBlock Style="{StaticResource MonoText}"
                                               Margin="6,0,0,0"
                                               Foreground="{DynamicResource Diff.Removed.Brush}"
                                               Text="{Binding RemovedText}" />
                                </StackPanel>

                                <TextBox DockPanel.Dock="Right"
                                         Style="{StaticResource SelectableText}"
                                         Text="{Binding Detail, Mode=OneWay}"
                                         Margin="10,0,0,0"
                                         Foreground="{DynamicResource Text.Muted.Brush}"
                                         Visibility="{Binding HasDiffCounts, Converter={StaticResource BooleanToVisibility}, ConverterParameter=Invert}" />

                                <TextBox Style="{StaticResource SelectableText}"
                                         Text="{Binding Title, Mode=OneWay}"
                                         FontFamily="{StaticResource Font.Sans}"
                                         FontSize="{StaticResource Font.Size.Normal}"
                                         FontWeight="SemiBold" />
                            </DockPanel>

                            <!--
                                What a step produced, and what the step was, are different
                                questions. The feed answers the second: one line for the thing
                                that happened and a short result. A generated file is hundreds of
                                lines of vertex arrays scrolling past, and the line saying which
                                file landed is the part that was worth seeing.

                                Three things can sit here. A failure explains itself, because that
                                is the moment somebody needs it. A stream says how far along it is,
                                because with the body gone there would otherwise be nothing moving
                                while a model works, which reads as a hang. Everything else folds
                                its body away, one click from the surface.
                            -->
                            <StackPanel Grid.Row="1" Grid.Column="2">
                                <TextBox Margin="0,4,0,0"
                                         Text="{Binding InlineText, Mode=OneWay}"
                                         IsReadOnly="True"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         Foreground="{DynamicResource Text.Secondary.Brush}"
                                         FontFamily="{StaticResource Font.Mono}"
                                         FontSize="{StaticResource Font.Size.Small}"
                                         TextWrapping="Wrap"
                                         Padding="0"
                                         HorizontalScrollBarVisibility="Disabled"
                                         Visibility="{Binding HasInlineText, Converter={StaticResource BooleanToVisibility}}" />

                                <TextBlock Style="{StaticResource MonoText}"
                                           Margin="0,3,0,0"
                                           Foreground="{DynamicResource Text.Muted.Brush}"
                                           Text="{Binding Progress}"
                                           Visibility="{Binding IsStreaming, Converter={StaticResource BooleanToVisibility}}" />

                                <!--
                                    Two way, so opening one entry and opening every entry are the
                                    same state rather than two ideas that can disagree.
                                -->
                                <Expander Margin="0,3,0,0"
                                          Header="Output"
                                          IsExpanded="{Binding IsBodyOpen, Mode=TwoWay}"
                                          Visibility="{Binding HasHiddenBody, Converter={StaticResource BooleanToVisibility}}">
                                    <TextBox Margin="0,4,0,0"
                                             MaxHeight="320"
                                             Text="{Binding Text, Mode=OneWay}"
                                             IsReadOnly="True"
                                             BorderThickness="0"
                                             Background="Transparent"
                                             Foreground="{DynamicResource Text.Secondary.Brush}"
                                             FontFamily="{StaticResource Font.Mono}"
                                             FontSize="{StaticResource Font.Size.Small}"
                                             TextWrapping="Wrap"
                                             Padding="0"
                                             VerticalScrollBarVisibility="Auto"
                                             HorizontalScrollBarVisibility="Disabled" />
                                </Expander>
                            </StackPanel>

                            <!-- Questions the run is blocked on. -->
                            <StackPanel Grid.Row="2" Grid.Column="2"
                                        Orientation="Horizontal"
                                        Margin="0,8,0,0"
                                        Visibility="{Binding IsAwaitingResponse, Converter={StaticResource BooleanToVisibility}}">
                                <Button Style="{StaticResource PrimaryButton}"
                                        Content="Confirm"
                                        Margin="0,0,8,0"
                                        Command="{Binding ConfirmCommand}" />
                                <Button Style="{StaticResource SmallButton}"
                                        Content="Cancel"
                                        Command="{Binding CancelCommand}" />
                            </StackPanel>

                            <TextBlock Grid.Row="2" Grid.Column="2"
                                       Style="{StaticResource MutedText}"
                                       Margin="0,6,0,0"
                                       Text="{Binding Resolution}"
                                       Visibility="{Binding Resolution, Converter={StaticResource StringToVisibility}}" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!--
            The empty state, and the one place the engines' own logs are mentioned. That was a
            footer under the Output tab, permanently occupying a row to say something true of every
            run and needed after almost none of them.
        -->
        <StackPanel HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Visibility="{Binding Events.Count, Converter={StaticResource CountToVisibility}, ConverterParameter=Invert}">
            <TextBlock Text="Wire up a graph, type a request, then press Run."
                       HorizontalAlignment="Center"
                       IsHitTestVisible="False"
                       Foreground="{DynamicResource Text.Muted.Brush}" />

            <Button Style="{StaticResource LinkButton}"
                    Margin="0,8,0,0"
                    HorizontalAlignment="Center"
                    Content="Open the engine logs"
                    ToolTip="The engines write their own logs to disk, separately from this transcript."
                    Command="{Binding DataContext.Settings.OpenDataFolderCommand, RelativeSource={RelativeSource AncestorType=UserControl, AncestorLevel=2}}" />
        </StackPanel>
    </Grid>
</UserControl>
