<UserControl x:Class="LocalNEXUS.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:LocalNEXUS.App.Infrastructure.Behaviors"
             xmlns:vm="clr-namespace:LocalNEXUS.App.ViewModels"
             xmlns:theming="clr-namespace:LocalNEXUS.App.Services.Theming"
             d:DataContext="{d:DesignInstance Type=vm:AppSettingsViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Background="{DynamicResource Surface.Window.Brush}">

    <!--
        Settings holds what is global; the tabs keep what is contextual. A watched folder, a theme
        and a cloud key belong to this install. Which model a node uses and which file it writes
        belong to the graph, so they stay on the node and get saved with it.

        Nothing here has an apply button. A settings panel with one can be left in a state where
        what is on screen and what is in force disagree, which is a bug the person has to notice.
    -->

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="190" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sections -->
        <Border Grid.Column="0"
                Background="{DynamicResource Surface.Panel.Brush}"
                BorderBrush="{DynamicResource Surface.Border.Brush}"
                BorderThickness="0,0,1,0">
            <StackPanel>
                <TextBlock Style="{StaticResource SideBarHeader}" Text="SETTINGS" />

                <!--
                    A list rather than five radio buttons, so choosing a section is the list's own
                    notion of selection and the keyboard works in it without being asked to.
                -->
                <ListBox ItemsSource="{Binding Sections}"
                         SelectedItem="{Binding Section}"
                         ItemContainerStyle="{StaticResource ListRow}"
                         Background="Transparent"
                         BorderThickness="0">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Converter={StaticResource SettingsSectionName}}" Margin="0,3" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Padding="24,20">
            <Grid MaxWidth="640" HorizontalAlignment="Left">

                <!-- Appearance -->
                <StackPanel Visibility="{Binding Section, Converter={StaticResource EnumToVisibility}, ConverterParameter=Appearance}">
                    <TextBlock Style="{StaticResource SectionHeader}" FontSize="{StaticResource Font.Size.Title}" Text="Appearance" />
                    <TextBlock Style="{StaticResource HintText}"
                               Text="Pick a theme. It applies right away." />

                    <ItemsControl ItemsSource="{Binding ThemeChoices}" Margin="0,14,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <!--
                                    The content is a panel, so the control has no readable name of
                                    its own and has to be given one.
                                -->
                                <RadioButton GroupName="Theme"
                                             Margin="0,0,0,10"
                                             AutomationProperties.Name="{Binding DisplayName}"
                                             IsChecked="{Binding IsSelected, Mode=TwoWay}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                                        <TextBlock Style="{StaticResource HintText}" Margin="0,2,0,0" Text="{Binding Description}" />
                                    </StackPanel>
                                </RadioButton>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!--
                        Transparency. Shown because the theme in force declares the capability,
                        never because of what it is called, which is what keeps a second theme
                        with the same idea from being a second round of edits here.
                    -->
                    <Border Style="{StaticResource Card}"
                            Margin="0,10,0,0"
                            Visibility="{Binding Themes.CurrentDefinition.SupportsTransparency, Converter={StaticResource BooleanToVisibility}}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionHeader}" Text="See through the window" />
                            <TextBlock Style="{StaticResource HintText}"
                                       TextWrapping="Wrap"
                                       Margin="0,2,0,0"
                                       Text="{Binding Themes.TransparencySummary}" />

                            <Grid Margin="0,12,0,0" IsEnabled="{Binding Themes.IsTransparencyAvailable}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <Slider Minimum="{x:Static theming:ThemeService.MinimumWindowOpacity}"
                                            Maximum="1"
                                            TickFrequency="0.01"
                                            IsSnapToTickEnabled="True"
                                            AutomationProperties.Name="Window opacity"
                                            Value="{Binding Themes.WindowOpacity, Mode=TwoWay}" />

                                    <Grid Margin="0,4,0,0">
                                        <TextBlock Style="{StaticResource HintText}" HorizontalAlignment="Left" Text="See through" />
                                        <TextBlock Style="{StaticResource HintText}" HorizontalAlignment="Right" Text="Solid" />
                                    </Grid>

                                    <TextBlock Style="{StaticResource HintText}"
                                               Margin="0,8,0,0"
                                               TextWrapping="Wrap"
                                               Text="The slider stops short of clear on purpose. What is behind the window is not ours to make readable, and past this point the palette stops winning against it." />
                                </StackPanel>

                                <!--
                                    A mock of something behind the window rather than a picture of
                                    the real desktop. Sampling the desktop would mean capturing the
                                    screen to draw a settings control, which is a lot of machinery
                                    and a permission question for a preview whose only job is to
                                    show what the number does.
                                -->
                                <Border Grid.Column="2"
                                        Width="180"
                                        Height="104"
                                        CornerRadius="6"
                                        ClipToBounds="True"
                                        BorderThickness="1"
                                        BorderBrush="{DynamicResource Surface.Border.Brush}">
                                    <Grid>
                                        <Canvas Background="{DynamicResource Accent.Primary.Brush}">
                                            <Ellipse Canvas.Left="-30" Canvas.Top="-24" Width="110" Height="110" Fill="{DynamicResource Status.Info.Brush}" />
                                            <Ellipse Canvas.Left="96" Canvas.Top="40" Width="120" Height="120" Fill="{DynamicResource Status.Warning.Brush}" />
                                            <Ellipse Canvas.Left="40" Canvas.Top="66" Width="90" Height="90" Fill="{DynamicResource Status.Success.Brush}" />
                                        </Canvas>

                                        <Border Background="{DynamicResource Surface.Gradient.Brush}"
                                                Opacity="{Binding Themes.EffectiveWindowOpacity}" />

                                        <Border Margin="14,20,14,14"
                                                CornerRadius="4"
                                                Background="{DynamicResource Surface.Card.Brush}"
                                                BorderThickness="1"
                                                BorderBrush="{DynamicResource Surface.Border.Brush}">
                                            <TextBlock Margin="8,6,0,0"
                                                       FontSize="{StaticResource Font.Size.Micro}"
                                                       Foreground="{DynamicResource Text.Secondary.Brush}"
                                                       Text="a panel stays solid" />
                                        </Border>
                                    </Grid>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!--
                        A live sample rather than a swatch. Every one of these is a real state brush,
                        so the preview is the same colours the interface uses and cannot drift from
                        them.
                    -->
                    <Border Style="{StaticResource Card}" Margin="0,10,0,0">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionHeader}" Text="How states look" />

                            <ItemsControl Margin="0,10,0,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,0,20,8">
                                    <Ellipse Style="{StaticResource StateDot}" Margin="0,0,7,0" Fill="{DynamicResource Accent.Neutral.Brush}" />
                                    <TextBlock Text="pending" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,20,8">
                                    <Ellipse Style="{StaticResource StateDot}" Margin="0,0,7,0" Fill="{DynamicResource Status.Info.Brush}" />
                                    <TextBlock Text="working" Foreground="{DynamicResource Status.Info.Brush}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,20,8">
                                    <Ellipse Style="{StaticResource StateDot}" Margin="0,0,7,0" Fill="{DynamicResource Status.Success.Brush}" />
                                    <TextBlock Text="healthy" Foreground="{DynamicResource Status.Success.Brush}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,20,8">
                                    <Ellipse Style="{StaticResource StateDot}" Margin="0,0,7,0" Fill="{DynamicResource Status.Warning.Brush}" />
                                    <TextBlock Text="thin" Foreground="{DynamicResource Status.Warning.Brush}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,20,8">
                                    <Ellipse Style="{StaticResource StateDot}" Margin="0,0,7,0" Fill="{DynamicResource Status.Danger.Brush}" />
                                    <TextBlock Text="failed" Foreground="{DynamicResource Status.Danger.Brush}" />
                                </StackPanel>
                            </ItemsControl>

                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <TextBlock Style="{StaticResource MonoText}" Foreground="{DynamicResource Diff.Added.Brush}" Text="+34" />
                                <TextBlock Style="{StaticResource MonoText}" Margin="8,0,20,0" Foreground="{DynamicResource Diff.Removed.Brush}" Text="-6" />
                                <TextBlock Style="{StaticResource MonoText}" Text="Assets/Scripts/PlayerMovement.cs" />
                            </StackPanel>

                            <!--
                                Every node accent, and no count in the label. It said six while
                                there were eleven, because a number in prose has to be maintained by
                                somebody noticing.
                            -->
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Rectangle Width="3" Height="18" Margin="0,0,7,0" Fill="{DynamicResource NodeType.Prompt.Brush}" />
                                <Rectangle Width="3" Height="18" Margin="0,0,7,0" Fill="{DynamicResource NodeType.Agent.Brush}" />
                                <Rectangle Width="3" Height="18" Margin="0,0,7,0" Fill="{DynamicResource NodeType.Triage.Brush}" />
                                <Rectangle Width="3" Height="18" Margin="0,0,7,0" Fill="{DynamicResource NodeType.Model.Brush}" />
                                <Rectangle Width="3" Height="18" Margin="0,0,7,0" Fill="{DynamicResource NodeType.Loop.Brush}" />
                                <Rectangle Width="3" Height="18" Margin="0,0,7,0" Fill="{DynamicResource NodeType.Debate.Brush}" />
                                <Rectangle Width="3" Height="18" Margin="0,0,7,0" Fill="{DynamicResource NodeType.Judge.Brush}" />
                                <Rectangle Width="3" Height="18" Margin="0,0,7,0" Fill="{DynamicResource NodeType.Reshape.Brush}" />
                                <Rectangle Width="3" Height="18" Margin="0,0,7,0" Fill="{DynamicResource NodeType.CompilerCheck.Brush}" />
                                <Rectangle Width="3" Height="18" Margin="0,0,7,0" Fill="{DynamicResource NodeType.TextOutput.Brush}" />
                                <Rectangle Width="3" Height="18" Margin="0,0,14,0" Fill="{DynamicResource NodeType.Output.Brush}" />
                                <TextBlock Style="{StaticResource MutedText}" VerticalAlignment="Center" Text="the node accents" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Models -->
                <StackPanel Visibility="{Binding Section, Converter={StaticResource EnumToVisibility}, ConverterParameter=Models}">
                    <TextBlock Style="{StaticResource SectionHeader}" FontSize="{StaticResource Font.Size.Title}" Text="Models" />
                    <TextBlock Style="{StaticResource HintText}"
                               Text="Add a whole folder to search, or add one model on its own. GGUF and safetensors both show up in the same list." />

                    <!--
                        Three ways in, said plainly, because the shape of the thing you are adding
                        decides which picker can even show it: a folder picker lists folders, so a
                        model file is invisible in one and there has to be a file picker too.
                    -->
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Style="{StaticResource SmallButton}"
                                Margin="0,0,8,0"
                                Content="Add model file"
                                ToolTip="One GGUF or safetensors file."
                                Command="{Binding AddModelFileCommand}" />

                        <Button Style="{StaticResource SmallButton}"
                                Margin="0,0,8,0"
                                Content="Add model folder"
                                ToolTip="One safetensors model: a folder holding config.json beside its weights."
                                Command="{Binding AddModelFolderCommand}" />

                        <Button Style="{StaticResource SmallButton}"
                                Margin="0,0,8,0"
                                Content="Search a folder"
                                ToolTip="Look inside this folder, and keep looking, for anything that is a model."
                                Command="{Binding AddFolderCommand}" />

                        <Button Style="{StaticResource SmallButton}"
                                Margin="0,0,8,0"
                                Content="Rescan"
                                Command="{Binding RescanCommand}" />

                        <Button Style="{StaticResource SmallButton}"
                                Content="Edit model-paths.txt"
                                Command="{Binding EditModelPathsCommand}" />
                    </StackPanel>

                    <!-- Whatever the last action did, said here rather than in a dialog. -->
                    <TextBlock Style="{StaticResource HintText}"
                               Foreground="{DynamicResource Text.Primary.Brush}"
                               Text="{Binding CatalogMessage}"
                               Visibility="{Binding CatalogMessage, Converter={StaticResource StringToVisibility}}" />

                    <TextBlock Style="{StaticResource FieldLabel}" Text="Where models come from" />

                    <ItemsControl ItemsSource="{Binding Entries}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Card}" Padding="10,7" Margin="0,0,0,6">
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right"
                                                Style="{StaticResource LinkButton}"
                                                Margin="10,0,0,0"
                                                VerticalAlignment="Center"
                                                Content="Remove"
                                                Command="{Binding DataContext.RemoveEntryCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"
                                                Visibility="{Binding CanRemove, Converter={StaticResource BooleanToVisibility}}" />

                                        <TextBlock DockPanel.Dock="Left"
                                                   FontFamily="{StaticResource Font.Icons}"
                                                   FontSize="{StaticResource Font.Size.Normal}"
                                                   Margin="0,0,10,0"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource Text.Muted.Brush}"
                                                   Text="&#xE8B7;"
                                                   Visibility="{Binding IsFolder, Converter={StaticResource BooleanToVisibility}}" />

                                        <TextBlock DockPanel.Dock="Left"
                                                   FontFamily="{StaticResource Font.Icons}"
                                                   FontSize="{StaticResource Font.Size.Normal}"
                                                   Margin="0,0,10,0"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource Text.Muted.Brush}"
                                                   Text="&#xE7C3;"
                                                   Visibility="{Binding IsFolder, Converter={StaticResource BooleanToVisibility}, ConverterParameter=Invert}" />

                                        <StackPanel>
                                            <TextBlock Style="{StaticResource MonoText}"
                                                       FontSize="{StaticResource Font.Size.Normal}"
                                                       Text="{Binding Label}"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding Path}" />

                                            <TextBlock Style="{StaticResource MutedText}" Text="{Binding Detail}" />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Style="{StaticResource HintText}" Text="{Binding Catalog.SearchSummary}" />


                </StackPanel>

                <!--
                    API keys.

                    They were under Models, which is where a model provider key belongs and where a
                    search provider key plainly does not, and the search one had ended up in the
                    Project section besides, so it was invisible with no project open. Grouping them
                    by what they are rather than by what they are for is what makes the second kind
                    findable, and the third kind after that.
                -->
                <StackPanel Visibility="{Binding Section, Converter={StaticResource EnumToVisibility}, ConverterParameter=ApiKeys}">
                    <TextBlock Style="{StaticResource SectionHeader}" FontSize="{StaticResource Font.Size.Title}" Text="API keys" />
                    <TextBlock Style="{StaticResource HintText}"
                               TextWrapping="Wrap"
                               Text="Every key this application holds, encrypted for this Windows account. Nothing here is bundled and nothing is sent anywhere but the provider it belongs to." />

                    <TextBlock Style="{StaticResource SectionHeader}" Margin="0,20,0,0" Text="Models" />
                    <TextBlock Style="{StaticResource HintText}"
                               TextWrapping="Wrap"
                               Text="Use the accounts you already pay for. Keys are encrypted for this Windows account and never written into a saved graph, so a graph can be shared without taking your key with it." />

                    <ItemsControl ItemsSource="{Binding Providers.Providers}" Margin="0,12,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Card}" Margin="0,0,0,8" Padding="14,12">
                                    <StackPanel>
                                        <Grid>
                                            <StackPanel HorizontalAlignment="Left" Orientation="Horizontal">
                                                <TextBlock Text="{Binding Provider.DisplayName}" FontWeight="SemiBold" />
                                                <TextBlock Style="{StaticResource HintText}" Margin="10,0,0,0" Text="{Binding StatusText}" />
                                            </StackPanel>
                                            <TextBlock Style="{StaticResource HintText}"
                                                       HorizontalAlignment="Right"
                                                       Text="{Binding Provider.RateSummary}" />
                                        </Grid>

                                        <Grid Margin="0,8,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <TextBox Grid.Column="0"
                                                     FontFamily="{StaticResource Font.Mono}"
                                                     Text="{Binding KeyEntry, UpdateSourceTrigger=PropertyChanged}"
                                                     AutomationProperties.Name="API key" />

                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0">
                                                <Button Content="Save"
                                                        MinWidth="64"
                                                        Command="{Binding DataContext.Providers.SaveKeyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}" />
                                                <Button Content="Clear"
                                                        MinWidth="64"
                                                        Margin="6,0,0,0"
                                                        Command="{Binding DataContext.Providers.ClearKeyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Visibility="{Binding HasKey, Converter={StaticResource BooleanToVisibility}}" />
                                                <Button Content="Get a key"
                                                        MinWidth="76"
                                                        Margin="6,0,0,0"
                                                        Command="{Binding DataContext.Providers.GetKeyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Visibility="{Binding HasKeyUrl, Converter={StaticResource BooleanToVisibility}}" />
                                                <Button Content="Remove"
                                                        MinWidth="76"
                                                        Margin="6,0,0,0"
                                                        Command="{Binding DataContext.Providers.RemoveCustomCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Visibility="{Binding Provider.IsCustom, Converter={StaticResource BooleanToVisibility}}" />
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Style="{StaticResource SectionHeader}" Margin="0,16,0,0" Text="Add another endpoint" />
                    <TextBlock Style="{StaticResource HintText}"
                               TextWrapping="Wrap"
                               Text="Anything that speaks the OpenAI API works here, listed above or not." />

                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBox Grid.Column="0"
                                 Text="{Binding Providers.CustomName, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="Endpoint name" />
                        <TextBox Grid.Column="1"
                                 Margin="8,0,0,0"
                                 FontFamily="{StaticResource Font.Mono}"
                                 Text="{Binding Providers.CustomBaseUrl, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="Base url" />
                        <Button Grid.Column="2" Margin="8,0,0,0" MinWidth="64" Content="Add" Command="{Binding Providers.AddCustomCommand}" />
                    </Grid>

                    <TextBlock Style="{StaticResource SectionHeader}" Margin="0,20,0,0" Text="Search providers" />

                    <!--
                        Laid out as a provider row is, because it is one. A key box across and its
                        buttons beside it, so this reads as another entry in the same list rather
                        than as something else that happens to be nearby.
                    -->
                    <Border Margin="0,8,0,0"
                            Padding="12,10"
                            CornerRadius="4"
                            Background="{DynamicResource Surface.Card.Brush}"
                            BorderThickness="1"
                            BorderBrush="{DynamicResource Surface.Border.Brush}">
                        <StackPanel>
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right"
                                           Style="{StaticResource HintText}"
                                           Margin="12,0,0,0"
                                           VerticalAlignment="Center"
                                           Text="five dollars of credit a month, then per thousand requests" />

                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Brave" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <TextBlock Style="{StaticResource HintText}"
                                               Margin="10,0,0,0"
                                               VerticalAlignment="Center"
                                               Text="{Binding SearchKeyState}" />
                                </StackPanel>
                            </DockPanel>

                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <PasswordBox Grid.Column="0"
                                             x:Name="SearchKeyBox"
                                             behaviors:PasswordBoxBehavior.IsBound="True"
                                             AutomationProperties.Name="Brave search key" />

                                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0">
                                    <Button Content="Save"
                                            MinWidth="64"
                                            Command="{Binding SetSearchKeyCommand}"
                                            CommandParameter="{Binding Path=(behaviors:PasswordBoxBehavior.Text), ElementName=SearchKeyBox}" />
                                    <Button Content="Clear"
                                            MinWidth="64"
                                            Margin="6,0,0,0"
                                            Command="{Binding ClearSearchKeyCommand}"
                                            Visibility="{Binding HasSearchKey, Converter={StaticResource BooleanToVisibility}}" />
                                    <Button Content="Get a key"
                                            MinWidth="76"
                                            Margin="6,0,0,0"
                                            Command="{Binding OpenSearchKeyUrlCommand}" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <TextBlock Style="{StaticResource HintText}"
                               Margin="0,8,0,14"
                               TextWrapping="Wrap"
                               Text="{Binding SearchStatus}" />

                    <TextBlock Style="{StaticResource HintText}"
                               Margin="0,4,0,14"
                               TextWrapping="Wrap"
                               Text="The key is yours and is stored encrypted for this Windows account, beside the model keys. Nothing is bundled, because a bundled key would bill every installation's searches to one account." />

                    <!--
                        Reading images. Here rather than under Project, which is where it was and
                        where it never belonged: every part of it is stored per install, including a
                        key, and it was the one key in the application that was not in the keys
                        section. Nothing about it changes with the open project.
                    -->
                    <TextBlock Style="{StaticResource SectionHeader}" Margin="0,20,0,0" Text="Reading images" />
                    <TextBlock Style="{StaticResource HintText}"
                               TextWrapping="Wrap"
                               Text="Paste or drop an image on the request box and this reads it into text, which joins your request. The image never enters the graph, so the coding model does not have to be able to see." />

                    <TextBlock Style="{StaticResource HintText}"
                               Margin="0,8,0,0"
                               TextWrapping="Wrap"
                               Text="{Binding VisionStatus}" />

                    <TextBlock Style="{StaticResource FieldLabel}" Text="A vision model on this machine" />

                    <!--
                        The local way in, which is the same way every other local model is chosen.
                        Picking one that has no projector beside it is refused here rather than
                        accepted and failed on the first image.
                    -->
                    <ComboBox Margin="0,2,0,0"
                              Padding="8,6"
                              ItemsSource="{Binding VisionModels}"
                              SelectedItem="{Binding SelectedVisionModel}"
                              DisplayMemberPath="DisplayName"
                              ToolTip="A vision model from your model folders. This application starts it when you paste an image." />

                    <!--
                        Directly under the box that causes it, which is where the refusal is about.
                        It used to sit below the button, with the address fields between it and the
                        list it was complaining about.
                    -->
                    <TextBlock Style="{StaticResource HintText}"
                               Margin="0,4,0,0"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource Field.Error.Brush}"
                               Text="{Binding VisionProblem}"
                               Visibility="{Binding VisionProblem, Converter={StaticResource StringToVisibility}}" />

                    <TextBlock Style="{StaticResource HintText}"
                               Margin="0,4,0,0"
                               TextWrapping="Wrap"
                               Text="Started for you the first time you paste an image. A vision model ships as two files, the weights and an mmproj projector; keep both in the same folder and the projector is found on its own, because a model without one loads and then refuses every image." />

                    <Button Style="{StaticResource SmallButton}"
                            Margin="0,8,0,0"
                            HorizontalAlignment="Left"
                            Content="Use an address instead"
                            Command="{Binding ClearVisionModelCommand}" />

                    <TextBlock Style="{StaticResource FieldLabel}" Text="Or a hosted one" />
                    <TextBlock Style="{StaticResource HintText}"
                               Margin="0,2,0,0"
                               TextWrapping="Wrap"
                               Text="For a hosted model, or for a server you are already running yourself. Anything that speaks the OpenAI API and can see." />

                    <TextBox Margin="0,6,0,0"
                             Padding="8,6"
                             behaviors:TextBoxHelper.Placeholder="Address, such as https://api.openai.com/v1"
                             Text="{Binding VisionBaseUrl, UpdateSourceTrigger=LostFocus}"
                             ToolTip="The base url of an OpenAI compatible server that can see." />
                    <TextBox Margin="0,6,0,0"
                             Padding="8,6"
                             behaviors:TextBoxHelper.Placeholder="Model id at that address, such as gpt-4o-mini"
                             Text="{Binding VisionModelId, UpdateSourceTrigger=LostFocus}"
                             ToolTip="Which model at that address reads images." />
                    <DockPanel Margin="0,6,0,14">
                        <Button DockPanel.Dock="Right"
                                Style="{StaticResource SmallButton}"
                                Margin="6,0,0,0"
                                Content="Save key"
                                Command="{Binding SetVisionKeyCommand}"
                                CommandParameter="{Binding Path=(behaviors:PasswordBoxBehavior.Text), ElementName=VisionKeyBox}" />
                        <PasswordBox x:Name="VisionKeyBox"
                                     behaviors:PasswordBoxBehavior.IsBound="True"
                                     behaviors:TextBoxHelper.Placeholder="API key for that address, if it needs one" />
                    </DockPanel>

                    <!--
                        Here rather than under Models, where it sat because the provider keys once
                        did. It only ever fires for a paid provider, and those are on this page.
                    -->
                    <TextBlock Style="{StaticResource SectionHeader}" Margin="0,20,0,0" Text="Warn before an expensive run" />
                    <TextBlock Style="{StaticResource HintText}" Text="{Binding Providers.ThresholdSummary}" TextWrapping="Wrap" />

                    <TextBlock Style="{StaticResource FieldLabel}" Text="Ask above" />
                    <TextBox Text="{Binding Providers.CostWarningThreshold, UpdateSourceTrigger=LostFocus}"
                             MaxWidth="160"
                             HorizontalAlignment="Left"
                             AutomationProperties.Name="Cost warning threshold in dollars" />
                    <TextBlock Style="{StaticResource HintText}"
                               TextWrapping="Wrap"
                               Text="Dollars. What a run is measured against is a ceiling, being the whole input plus the most each node is allowed to write, so the real cost is usually lower and can be higher. Set it to zero to never be asked. Local models cost nothing and never trigger it." />
                </StackPanel>

                <!-- Project -->
                <StackPanel Visibility="{Binding Section, Converter={StaticResource EnumToVisibility}, ConverterParameter=Project}">
                    <TextBlock Style="{StaticResource SectionHeader}" FontSize="{StaticResource Font.Size.Title}" Text="Project" />

                    <!--
                        Everything the setup window asked, editable afterwards. It is here rather
                        than in a window of its own because this section was already about the open
                        project, and somebody looking for what the application thinks about their
                        project should find all of it in one place.
                    -->
                    <StackPanel Visibility="{Binding ProjectSettings.ProjectPath, Converter={StaticResource StringToVisibility}}">

                        <TextBlock Style="{StaticResource FieldLabel}" Text="Where generated code goes" />
                        <ComboBox Margin="0,2,0,0"
                                  IsEditable="True"
                                  ItemsSource="{Binding ProjectFolders}"
                                  Text="{Binding ScriptsFolder, UpdateSourceTrigger=LostFocus}" />
                        <TextBlock Style="{StaticResource HintText}"
                                   Margin="0,4,0,14"
                                   TextWrapping="Wrap"
                                   Text="Relative to the project root. This is what a newly added Output node starts from. It does not move anything in a graph you have already saved, because that value belongs to the node and was saved with it; open the node and change it there." />

                        <TextBlock Style="{StaticResource FieldLabel}" Text="Project kind" />
                        <ComboBox Margin="0,2,0,0"
                                  ItemsSource="{Binding ProjectKinds}"
                                  SelectedItem="{Binding ProjectKind}" />
                        <TextBlock Style="{StaticResource HintText}"
                                   Margin="0,4,0,14"
                                   TextWrapping="Wrap"
                                   Text="{Binding ProjectKindNote}" />

                        <TextBlock Style="{StaticResource FieldLabel}" Text="Answer MCP tool calls for this project" />
                        <CheckBox Margin="0,2,0,0"
                                  IsChecked="{Binding ProjectMcpEnabled}"
                                  Content="Allow tool calls while this project is open" />
                        <TextBlock Style="{StaticResource HintText}"
                                   Margin="0,4,0,14"
                                   TextWrapping="Wrap"
                                   Text="Both this and the switch in Runtime have to be on. That one decides whether this installation answers at all; this one decides whether it answers about this project." />

                        <TextBlock Style="{StaticResource FieldLabel}" Text="Share these settings" />
                        <CheckBox Margin="0,2,0,0"
                                  IsChecked="{Binding ShareProjectSettings}"
                                  Content="Commit the folder and the project kind with the repository" />
                        <TextBlock Style="{StaticResource HintText}"
                                   Margin="0,4,0,14"
                                   TextWrapping="Wrap"
                                   Text="{Binding ProjectSharingNote}" />
                    </StackPanel>

                    <TextBlock Style="{StaticResource HintText}"
                               Margin="0,0,0,14"
                               TextWrapping="Wrap"
                               Text="No project is open, so there is nothing to set here yet. Open one from the File menu, or from the window that appears at startup."
                               Visibility="{Binding ProjectSettings.ProjectPath, Converter={StaticResource StringToVisibility}, ConverterParameter=Invert}" />





                    <TextBlock Style="{StaticResource FieldLabel}" Text="Open project" />
                    <TextBlock Text="{Binding Index.IndexedProject, TargetNullValue=No project is open.}" />
                    <TextBlock Style="{StaticResource HintText}" Text="Change it from File, Open project." />

                    <TextBlock Style="{StaticResource FieldLabel}" Text="What is known about it" />
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Style="{StaticResource StateDot}"
                                 Margin="0,0,8,0"
                                 Fill="{Binding Index.State, Converter={StaticResource ResourceLookup}, ConverterParameter=ProjectIndexState}" />
                        <TextBlock Text="{Binding Index.StatusText}" />
                    </StackPanel>

                    <TextBlock Style="{StaticResource MonoText}"
                               Margin="0,6,0,0"
                               Foreground="{DynamicResource Text.Muted.Brush}"
                               Text="{Binding Index.Stage}" />

                    <Button Style="{StaticResource SmallButton}"
                            Margin="0,12,0,0"
                            HorizontalAlignment="Left"
                            Content="Read the project again"
                            Command="{Binding ReindexCommand}" />

                    <TextBlock Style="{StaticResource HintText}"
                               Text="Only needed if something outside the editor changed a lot of files at once." />
                </StackPanel>

                <!-- Runtime -->
                <StackPanel Visibility="{Binding Section, Converter={StaticResource EnumToVisibility}, ConverterParameter=Runtime}">
                    <TextBlock Style="{StaticResource SectionHeader}" FontSize="{StaticResource Font.Size.Title}" Text="Runtime" />

                    <TextBlock Style="{StaticResource SectionHeader}" Margin="0,14,0,0" Text="Python environment" />

                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Ellipse Style="{StaticResource StateDot}"
                                 Margin="0,0,8,0"
                                 Fill="{Binding Python.Environment.State, Converter={StaticResource ResourceLookup}, ConverterParameter=PythonEnvironmentState}" />
                        <TextBlock Text="{Binding Python.Environment.StatusText}" />
                    </StackPanel>

                    <ProgressBar Margin="0,10,0,0"
                                 IsIndeterminate="True"
                                 Visibility="{Binding Python.Environment.IsBusy, Converter={StaticResource BooleanToVisibility}}" />

                    <TextBlock Style="{StaticResource MonoText}"
                               Margin="0,8,0,0"
                               Foreground="{DynamicResource Text.Muted.Brush}"
                               TextWrapping="Wrap"
                               Text="{Binding Python.Environment.Stage}" />

                    <TextBlock Style="{StaticResource MonoText}"
                               Margin="0,4,0,0"
                               Foreground="{DynamicResource Text.Muted.Brush}"
                               TextWrapping="Wrap"
                               Text="{Binding Python.Environment.Detail}" />

                    <TextBlock Style="{StaticResource HintText}"
                               Foreground="{DynamicResource Field.Error.Brush}"
                               Text="{Binding Python.Environment.LastError}"
                               Visibility="{Binding Python.Environment.LastError, Converter={StaticResource StringToVisibility}}" />

                    <TextBlock Style="{StaticResource HintText}" Text="{Binding Python.Environment.AcceleratorSummary}" />

                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Style="{StaticResource SmallButton}" Margin="0,0,8,0" Content="Repair" Command="{Binding Python.RepairCommand}" />
                        <Button Style="{StaticResource SmallButton}" Margin="0,0,8,0" Content="Set up again" Command="{Binding Python.ResetCommand}" />
                        <Button Style="{StaticResource SmallButton}" Content="Open its folder" Command="{Binding Python.OpenFolderCommand}" />
                    </StackPanel>

                    <TextBlock Style="{StaticResource HintText}"
                               Text="Only needed to run safetensors models. GGUF models work without it." />

                    <Rectangle Height="1" Margin="0,20,0,0" Fill="{DynamicResource Surface.Border.Brush}" />

                    <!--
                        Written for somebody who has never heard of any of this. Every field said
                        what it was called and nothing said what it was for, which is fine once you
                        already know and useless before then.
                    -->
                    <TextBlock Style="{StaticResource SectionHeader}" Margin="0,16,0,0" Text="Mesh node" />

                    <TextBlock Style="{StaticResource HintText}"
                               Margin="0,6,0,0"
                               TextWrapping="Wrap"
                               Text="A mesh pools the graphics cards of several machines so they can run a model together that none of them could run alone. It is entirely optional. With the node stopped, this application works exactly as it does now and every model runs on this machine." />

                    <TextBlock Style="{StaticResource HintText}"
                               Margin="0,6,0,0"
                               TextWrapping="Wrap"
                               Text="Machines find each other over your local network on their own, so there are no addresses to type. Nothing is split across machines unless a model does not fit on one: crossing between machines costs time, so it buys capability rather than speed." />

                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Ellipse Style="{StaticResource StateDot}"
                                 Margin="0,0,8,0"
                                 Fill="{Binding Network.Mesh.State, Converter={StaticResource ResourceLookup}, ConverterParameter=MeshNodeState}" />
                        <TextBlock Text="{Binding Network.Mesh.StatusText}" />
                    </StackPanel>

                    <TextBlock Style="{StaticResource FieldLabel}" Text="Mesh name" />
                    <TextBox behaviors:TextBoxHelper.Placeholder="A name for the mesh this machine hosts"
                             Text="{Binding Network.MeshName, UpdateSourceTrigger=LostFocus}" />
                    <TextBlock Style="{StaticResource HintText}"
                               Margin="0,4,0,0"
                               TextWrapping="Wrap"
                               Text="What the mesh this machine hosts is called, and what anybody you invite will see. It matters only while you are hosting; joining somebody else's mesh uses theirs." />

                    <TextBlock Style="{StaticResource FieldLabel}" Text="Join another mesh" />
                    <TextBox behaviors:TextBoxHelper.Placeholder="Invite token from the machine hosting the mesh"
                             Text="{Binding Network.JoinToken, UpdateSourceTrigger=LostFocus}"
                             FontFamily="{StaticResource Font.Mono}" />
                    <TextBlock Style="{StaticResource HintText}"
                               Margin="0,4,0,0"
                               TextWrapping="Wrap"
                               Text="Paste the invite token from the machine that is hosting, then press Apply and restart the node. Whoever is hosting finds their token in the Network tab, under Invite token, with a Copy button beside it. Leave this empty to host a mesh of your own instead of joining one." />

                    <CheckBox Style="{StaticResource ToggleSwitch}"
                              Margin="0,14,0,0"
                              Content="Publish this mesh publicly"
                              IsChecked="{Binding Network.Publish}" />

                    <TextBlock Style="{StaticResource HintText}"
                               Margin="0,4,0,0"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource Status.Warning.Brush}"
                               Text="The only setting here that reaches beyond your local network. Off, the node speaks only to machines on the same network as this one and a stranger cannot see it exists. On, the mesh is listed publicly and anyone can ask to use what you have chosen to share." />

                    <TextBlock Style="{StaticResource HintText}"
                               Margin="0,8,0,0"
                               TextWrapping="Wrap"
                               Text="What this machine shares, which models and how much memory, is set in the Network tab rather than here. Nothing is shared until you tick it." />

                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <Button Style="{StaticResource SmallButton}" Margin="0,0,8,0" Content="Apply and restart the node" Command="{Binding Network.ApplySettingsCommand}" />
                        <Button Style="{StaticResource SmallButton}" Margin="0,0,8,0" Content="Start or stop the node" Command="{Binding Network.ToggleMeshCommand}" />
                        <Button Style="{StaticResource SmallButton}" Content="Leave the mesh" Command="{Binding Network.LeaveMeshCommand}" />
                    </StackPanel>

                    <TextBlock Style="{StaticResource HintText}"
                               Margin="0,6,0,0"
                               TextWrapping="Wrap"
                               Text="Everything above is read once, when the node starts, so a change does nothing until Apply and restart the node. Start or stop the node turns it on and off without changing any of it. Leave the mesh clears the invite token and goes back to hosting your own." />

                    <Rectangle Height="1" Margin="0,20,0,0" Fill="{DynamicResource Surface.Border.Brush}" />

                    <!--
                        Here rather than under Project, which is what it was under and what it is
                        not: this switch decides what this installation does, and the project it
                        does it about has its own switch beside its own settings. This section is
                        the things this install runs, and a tool call server is one of them.
                    -->
                    <TextBlock Style="{StaticResource SectionHeader}" Margin="0,16,0,0" Text="Answer MCP tool calls" />
                    <CheckBox Margin="0,8,0,0"
                              IsChecked="{Binding McpServerEnabled}"
                              Content="Let other tools open a project, open a graph and run it" />
                    <TextBlock Style="{StaticResource HintText}"
                               Margin="0,4,0,0"
                               TextWrapping="Wrap"
                               Text="{Binding McpServerStatus}" />
                    <TextBlock Style="{StaticResource HintText}"
                               Margin="0,4,0,0"
                               TextWrapping="Wrap"
                               Text="A local pipe, never a network port. A caller can run a graph, which writes files into the open project through the same rules a person's run goes through. It cannot write a file any other way and cannot read a stored key." />
                    <TextBlock Style="{StaticResource HintText}"
                               Margin="0,4,0,0"
                               TextWrapping="Wrap"
                               Text="This switch and the one in Project both have to be on. This one decides whether this installation answers at all; that one decides whether it answers about the project you have open." />

                    <Rectangle Height="1" Margin="0,20,0,0" Fill="{DynamicResource Surface.Border.Brush}" />

                    <TextBlock Style="{StaticResource SectionHeader}" Margin="0,16,0,0" Text="Where this install keeps its own files" />
                    <TextBlock Style="{StaticResource HintText}"
                               TextWrapping="Wrap"
                               Text="Engine logs, the model catalogue, the Python runtime and this application's configuration. Nothing a project owns is in here." />

                    <Button Style="{StaticResource SmallButton}"
                            Margin="0,10,0,0"
                            HorizontalAlignment="Left"
                            Content="Open this install's data folder"
                            Command="{Binding OpenDataFolderCommand}" />
                </StackPanel>

                <!-- Behaviour -->
                <!--
                    Extensions. Laid out after Unity's package manager: a sources rail on the
                    left, a list in the middle, details on the right. The details pane shows the
                    real command, because an extension that will not start is almost always one
                    whose command is wrong and that is invisible anywhere else.
                -->
                <!--
                    Extensions live in their own window. Settings keeps this entry so that
                    somebody who came looking here finds their way there rather than concluding
                    the feature does not exist.
                -->
                <StackPanel Visibility="{Binding Section, Converter={StaticResource EnumToVisibility}, ConverterParameter=Extensions}">
                    <TextBlock Style="{StaticResource SectionHeader}" FontSize="{StaticResource Font.Size.Title}" Text="Extensions" />
                    <TextBlock Style="{StaticResource HintText}"
                               TextWrapping="Wrap"
                               Text="Extensions add tools a model can call and node types the graph can run. A bad one cannot break the application, and they belong to the open project because what they talk to does." />

                    <Button HorizontalAlignment="Left"
                            Margin="0,16,0,0"
                            Padding="14,8"
                            AutomationProperties.Name="Open the extensions window"
                            Command="{Binding DataContext.OpenExtensionsCommand, RelativeSource={RelativeSource AncestorType=Window}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xEA86;"
                                       FontFamily="{StaticResource Font.Icons}"
                                       FontSize="14"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="Manage extensions" Margin="9,0,0,0" VerticalAlignment="Center" />
                            <!-- The arrow says this leaves settings rather than opening a page here. -->
                            <TextBlock Text="&#xE8A7;"
                                       FontFamily="{StaticResource Font.Icons}"
                                       FontSize="10"
                                       Margin="9,0,0,0"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource Text.Muted.Brush}" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- History -->
                <StackPanel Visibility="{Binding Section, Converter={StaticResource EnumToVisibility}, ConverterParameter=History}">
                    <TextBlock Style="{StaticResource SectionHeader}" FontSize="{StaticResource Font.Size.Title}" Text="History" />
                    <TextBlock Style="{StaticResource HintText}"
                               TextWrapping="Wrap"
                               Text="Every run is written to a database inside the open project, as it happens. Nothing is summarised and nothing is held in memory: the record stays whole and is searched from the history window." />

                    <TextBlock Style="{StaticResource HintText}"
                               Margin="0,10,0,0"
                               TextWrapping="Wrap"
                               Text="{Binding History.StatusText}" />

                    <!--
                        The limits before the buttons that enforce them, which is the order they
                        have to be read in. A button called Apply the caps now, sitting above the
                        only place the word cap is defined, is a button nobody can safely press.
                    -->
                    <TextBlock Style="{StaticResource SectionHeader}" Margin="0,20,0,0" Text="How much to keep" />
                    <TextBlock Style="{StaticResource HintText}"
                               TextWrapping="Wrap"
                               Text="Two things are recorded for every run. The transcript, which is what happened in words, and a snapshot of each file before it was changed, which is the only thing that makes a run undoable. Transcripts are small and are kept forever; snapshots are whole copies of your files, so they are the ones with limits." />
                    <TextBlock Style="{StaticResource HintText}"
                               Margin="0,6,0,0"
                               TextWrapping="Wrap"
                               Text="A run past either limit loses its snapshots and keeps its transcript. You can still read everything it did; you can no longer undo it." />

                    <TextBlock Style="{StaticResource FieldLabel}" Text="Runs that keep their snapshots" />
                    <TextBox Text="{Binding SnapshotRunLimit, UpdateSourceTrigger=LostFocus}"
                             MaxWidth="160"
                             HorizontalAlignment="Left"
                             AutomationProperties.Name="How many runs keep their snapshots" />
                    <TextBlock Style="{StaticResource HintText}"
                               TextWrapping="Wrap"
                               Text="The most recent this many runs stay undoable. Older ones give up their snapshots however new they are." />

                    <TextBlock Style="{StaticResource FieldLabel}" Text="Days to keep a snapshot" />
                    <TextBox Text="{Binding SnapshotAgeDays, UpdateSourceTrigger=LostFocus}"
                             MaxWidth="160"
                             HorizontalAlignment="Left"
                             AutomationProperties.Name="How many days a snapshot is kept" />
                    <TextBlock Style="{StaticResource HintText}"
                               TextWrapping="Wrap"
                               Text="A snapshot older than this goes, even if the run is one of the most recent. Whichever limit is reached first wins." />

                    <TextBlock Style="{StaticResource HintText}"
                               Margin="0,8,0,0"
                               TextWrapping="Wrap"
                               Text="Both are applied on their own at the end of every run, so under ordinary use there is nothing here to press." />

                    <TextBlock Style="{StaticResource SectionHeader}" Margin="0,24,0,0" Text="What it is using" />

                    <Border Style="{StaticResource Card}" Margin="0,6,0,0">
                        <StackPanel>
                            <TextBlock TextWrapping="Wrap" Text="{Binding HistoryUsage.Summary}" />

                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <Button Style="{StaticResource SmallButton}"
                                        MinWidth="90"
                                        Content="Recount"
                                        ToolTip="Measure the database again. It does not change anything."
                                        Command="{Binding RefreshHistoryUsageCommand}" />
                                <Button Style="{StaticResource SmallButton}"
                                        MinWidth="120"
                                        Margin="8,0,0,0"
                                        Content="Delete old snapshots"
                                        ToolTip="Applies the two limits above right now, instead of waiting for the next run to do it."
                                        Command="{Binding PruneSnapshotsCommand}" />
                                <Button Style="{StaticResource SmallButton}"
                                        MinWidth="130"
                                        Margin="8,0,0,0"
                                        Content="Delete all snapshots"
                                        ToolTip="Every snapshot, whatever the limits say. Transcripts are kept."
                                        Command="{Binding ClearSnapshotsCommand}" />
                                <Button Style="{StaticResource DangerButton}"
                                        MinWidth="130"
                                        Margin="8,0,0,0"
                                        Content="Delete everything"
                                        ToolTip="Every transcript and every snapshot for this project."
                                        Command="{Binding ClearHistoryCommand}" />
                            </StackPanel>

                            <TextBlock Style="{StaticResource HintText}"
                                       Margin="0,10,0,0"
                                       TextWrapping="Wrap"
                                       Text="Recount measures again and changes nothing. Delete old snapshots applies the two limits above right now rather than waiting for the next run. Delete all snapshots takes every one of them whatever the limits say, keeping the transcripts, so nothing can be undone but everything can still be read. Delete everything takes the transcripts as well and cannot be reversed." />
                        </StackPanel>
                    </Border>

                    <TextBlock Style="{StaticResource SectionHeader}" Margin="0,20,0,0" Text="What undo reaches" />
                    <TextBlock Style="{StaticResource HintText}"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource Status.Warning.Brush}"
                               Text="Undo puts back only the files this application wrote or edited during a run. Anything a build or an editor regenerated, an extension changed, or you edited by hand is invisible to it, and putting a file back also discards whatever was done to it since. This is run undo, not version control." />
                </StackPanel>

                <StackPanel Visibility="{Binding Section, Converter={StaticResource EnumToVisibility}, ConverterParameter=Behaviour}">
                    <TextBlock Style="{StaticResource SectionHeader}" FontSize="{StaticResource Font.Size.Title}" Text="Behaviour" />
                    <TextBlock Style="{StaticResource HintText}"
                               TextWrapping="Wrap"
                               Text="Starting values for nodes you add from here on. Every one of them can be changed on the node itself, and a graph you have already saved keeps whatever was set on it, so nothing here reaches backwards." />

                    <TextBlock Style="{StaticResource SectionHeader}" Margin="0,20,0,0" Text="Compiler check" />
                    <TextBlock Style="{StaticResource HintText}"
                               TextWrapping="Wrap"
                               Text="The Compiler check node compiles what a model wrote before anything is written to disk. When it does not build, the errors go back to the model that produced the code and it tries again." />

                    <TextBlock Style="{StaticResource FieldLabel}" Text="Repair attempts after the first failure" />
                    <TextBox Text="{Binding DefaultRetryLimit, UpdateSourceTrigger=LostFocus}" MaxWidth="120" HorizontalAlignment="Left" />
                    <TextBlock Style="{StaticResource HintText}"
                               TextWrapping="Wrap"
                               Text="How many more times to hand the errors back before giving up. Zero checks the code and reports what is wrong without trying to fix it. Each attempt is another request to the model, so this is the setting that decides how long a bad first answer takes to resolve." />

                    <TextBlock Style="{StaticResource SectionHeader}" Margin="0,24,0,0" Text="Plan context budget" />
                    <TextBlock Style="{StaticResource HintText}"
                               TextWrapping="Wrap"
                               Text="How much of your project the Triage node is allowed to put in front of a model when it works out what to change. A model can only read so much at once, so this is a deliberate allowance split three ways rather than an attempt to send everything." />
                    <TextBlock Style="{StaticResource HintText}"
                               Margin="0,6,0,0"
                               TextWrapping="Wrap"
                               Text="All three are in characters, roughly four characters to a token. Raising them costs money on a hosted model and time on a local one. Anything that does not fit is dropped in rank order and the run says what was dropped, so a budget that is too small is visible rather than silent." />

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Style="{StaticResource FieldLabel}" Margin="0,0,0,4" Text="Project map" />
                            <TextBox Text="{Binding DefaultMapCharacters, UpdateSourceTrigger=LostFocus}" />
                            <TextBlock Style="{StaticResource HintText}"
                                       Margin="0,4,0,0"
                                       TextWrapping="Wrap"
                                       Text="One line per type in the whole project, so the model knows what already exists and does not write a second copy of it." />
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Style="{StaticResource FieldLabel}" Margin="0,0,0,4" Text="Candidate detail" />
                            <TextBox Text="{Binding DefaultCandidateCharacters, UpdateSourceTrigger=LostFocus}" />
                            <TextBlock Style="{StaticResource HintText}"
                                       Margin="0,4,0,0"
                                       TextWrapping="Wrap"
                                       Text="The actual contents of the files the request looks like it is about. The largest of the three, because this is what a change is written against." />
                        </StackPanel>

                        <StackPanel Grid.Column="4">
                            <TextBlock Style="{StaticResource FieldLabel}" Margin="0,0,0,4" Text="Signatures this run" />
                            <TextBox Text="{Binding DefaultEmittedCharacters, UpdateSourceTrigger=LostFocus}" />
                            <TextBlock Style="{StaticResource HintText}"
                                       Margin="0,4,0,0"
                                       TextWrapping="Wrap"
                                       Text="What earlier files in this same run declared, so the fifth file can call into the first by its real name instead of guessing." />
                        </StackPanel>
                    </Grid>

                    <TextBlock Style="{StaticResource FieldLabel}" Text="Candidate files offered before any is read" />
                    <TextBox Text="{Binding DefaultCandidateLimit, UpdateSourceTrigger=LostFocus}" MaxWidth="120" HorizontalAlignment="Left" />
                    <TextBlock Style="{StaticResource HintText}"
                               TextWrapping="Wrap"
                               Text="How many files get shortlisted by ranking before any of them is opened. Only what survives the shortlist spends any of the candidate detail budget above. Files you never mentioned but which the work depends on still make the list." />

                    <TextBlock Style="{StaticResource HintText}" Margin="0,12,0,0" TextWrapping="Wrap" Text="{Binding DefaultBudgetSummary}" />


                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
