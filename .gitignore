# LocalNEXUS
#
# Application data lives outside this repository, in %LOCALAPPDATA%\LocalNEXUS\
# (models, graphs, logs, config.json). Nothing there is tracked by git, so there is
# no rule for it below. Only build output, editor state and fetched binaries are.

# ---------------------------------------------------------------------------
# Build output
# ---------------------------------------------------------------------------
bin/
obj/
[Dd]ebug/
[Rr]elease/
x64/
x86/
[Ww][Ii][Nn]32/
[Aa][Rr][Mm]64/
build/
artifacts/
publish/
dist/
*.dll
*.exe
*.pdb
*.cache
*.binlog

# ---------------------------------------------------------------------------
# Visual Studio
# ---------------------------------------------------------------------------
.vs/
*.user
*.suo
*.userprefs
*.userosscache
*.sln.docstates
*.VC.db
*.VC.VC.opendb
*.psess
*.vsp
*.vspx

# ---------------------------------------------------------------------------
# Rider and other JetBrains IDEs
# ---------------------------------------------------------------------------
.idea/
*.sln.iml
_ReSharper*/
*.[Rr]e[Ss]harper
*.DotSettings.user

# ---------------------------------------------------------------------------
# Visual Studio Code
# ---------------------------------------------------------------------------
.vscode/*
!.vscode/extensions.json

# ---------------------------------------------------------------------------
# NuGet
# ---------------------------------------------------------------------------
*.nupkg
*.snupkg
packages/
!packages/build/
project.lock.json
project.assets.json

# ---------------------------------------------------------------------------
# Bundled engine binaries
#
# These are fetched per machine rather than committed: they are large, they are
# GPU build specific, and they carry their own license. See the README in each
# folder for how to place a build there. The folders themselves are kept so the
# paths always exist.
# ---------------------------------------------------------------------------
vendor/llama/*
!vendor/llama/README.md
vendor/mesh/*
!vendor/mesh/README.md
vendor/uv/*
!vendor/uv/README.md

# ---------------------------------------------------------------------------
# Model weights. Never commit these, anywhere, at any size.
# ---------------------------------------------------------------------------
*.gguf
*.ggml
*.safetensors
*.bin
/models/

# ---------------------------------------------------------------------------
# Operating system noise
# ---------------------------------------------------------------------------
Thumbs.db
ehthumbs.db
desktop.ini
$RECYCLE.BIN/
.DS_Store

# ---------------------------------------------------------------------------
# Saved graphs.
#
# A graph stores a model node's API key in plain text, so a graph committed by
# accident publishes that key permanently. Graphs live in %LOCALAPPDATA% by
# default and so are already outside the repository; this rule is here for the
# one saved somewhere else by hand.
# ---------------------------------------------------------------------------
*.nexusgraph.json

# ---------------------------------------------------------------------------
# Application data, for the case where a copy ends up beside the source rather
# than in %LOCALAPPDATA% where it belongs.
# ---------------------------------------------------------------------------
model-paths.txt
*.log
logs/
runtime/

# ---------------------------------------------------------------------------
# The Python folder holds committed lockfiles and nothing else. An environment
# built here by hand would be gigabytes.
# ---------------------------------------------------------------------------
vendor/python/.venv/
vendor/python/__pycache__/

# ---------------------------------------------------------------------------
# Local tooling state
# ---------------------------------------------------------------------------
.claude/settings.local.json
*.tmp

# The compiled installer, which is build output like everything else in dist.
dist/installer/

# The application payload the installer embeds. Copied in by release.ps1 from dist, and no more
# committable than dist itself.
src/LocalNEXUS.Installer/Payload/

# Eval results. Durable, kept out of the application data folder on purpose, not source.
evals/

# LocalNEXUS
.localnexus/

# LocalNEXUS
localnexus.local.json
localnexus.json
